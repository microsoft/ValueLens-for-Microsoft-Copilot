{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "mark": { "type": "bar", "cornerRadiusEnd": 2 },
  "encoding": {
    "y": {
      "field": "Chat + Agent Interactions (Audit Logs)Task Breakdown Category",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": { "labelLimit": 240 }
    },
    "x": {
      "field": "Expert Equivalent Hours Per Week",
      "type": "quantitative",
      "stack": null,
      "title": "Expert-equivalent hours per week",
      "axis": { "labelExpr": "format(datum.value, ',.0f')" }
    },
    "color": {
      "field": "Chat + Agent Interactions (Audit Logs)Task Breakdown Group",
      "type": "nominal",
      "title": "Category",
      "legend": { "orient": "top", "direction": "horizontal", "symbolLimit": 20, "columns": 3, "labelLimit": 260 }
    },
    "tooltip": [
      { "field": "Chat + Agent Interactions (Audit Logs)Task Breakdown Category", "type": "nominal", "title": "Task" },
      { "field": "Chat + Agent Interactions (Audit Logs)Task Breakdown Group", "type": "nominal", "title": "Category" },
      { "field": "Expert Equivalent Hours Per Week", "type": "quantitative", "title": "Hours per week", "format": ",.1f" },
      { "field": "AI Assisted Value Per Week", "type": "quantitative", "title": "Value per week", "format": ",.0f" },
      { "field": "Activity Share", "type": "quantitative", "title": "Activity share", "format": ".1%" }
    ]
  }
}
