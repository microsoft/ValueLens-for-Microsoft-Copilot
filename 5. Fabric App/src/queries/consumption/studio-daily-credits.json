{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "transform": [
    { "fold": ["Prepaid Credits", "PAYG Credits"], "as": ["Series", "Value"] },
    { "filter": "isValid(datum['Value'])" },
    { "calculate": "datum['Series'] === 'Prepaid Credits' ? 'Prepaid' : 'Pay-as-you-go'", "as": "Billing" },
    { "calculate": "datum['Series'] === 'Prepaid Credits' ? 1 : 2", "as": "Billing Order" },
    { "calculate": "toDate(datum['Usage Date'])", "as": "Day" },
    { "calculate": "time(datum['Day'])", "as": "Day Order" },
    { "calculate": "timeFormat(datum['Day'], '%-d %b')", "as": "Day Label" }
  ],
  "mark": { "type": "bar", "cornerRadiusEnd": 2 },
  "encoding": {
    "x": {
      "field": "Day Label",
      "type": "ordinal",
      "title": null,
      "sort": { "field": "Day Order", "op": "min", "order": "ascending" },
      "axis": { "labelAngle": 0, "labelOverlap": true }
    },
    "y": {
      "field": "Value",
      "type": "quantitative",
      "stack": "zero",
      "title": "Credits",
      "axis": { "format": ",~f", "formatType": "number" }
    },
    "color": {
      "field": "Billing",
      "type": "nominal",
      "title": null,
      "sort": ["Prepaid", "Pay-as-you-go"],
      "legend": { "orient": "top", "direction": "horizontal" }
    },
    "order": { "field": "Billing Order", "type": "quantitative" },
    "tooltip": [
      { "field": "Day", "type": "temporal", "title": "Day", "format": "%a %d %b %Y" },
      { "field": "Billing", "type": "nominal", "title": "Billing" },
      { "field": "Value", "type": "quantitative", "title": "Credits", "format": ",.0f" },
      { "field": "Credits", "type": "quantitative", "title": "All credits", "format": ",.0f" }
    ]
  }
}