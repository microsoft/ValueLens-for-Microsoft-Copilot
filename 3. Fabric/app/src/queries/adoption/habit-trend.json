{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "mark": { "type": "area", "interpolate": "monotone", "line": false },
  "transform": [
    {
      "calculate": "toDate(datum['Chat + Agent Interactions (Audit Logs)MonthStart'])",
      "as": "Month"
    }
  ],
  "encoding": {
    "x": {
      "field": "Month",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %Y",
        "tickCount": { "interval": "month", "step": 1 },
        "labelAngle": 0
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "Users",
      "type": "quantitative",
      "title": "Share of users",
      "stack": "normalize",
      "axis": { "labelExpr": "format(datum.value, '.0%')" }
    },
    "color": {
      "field": "Stage LegendStage",
      "type": "nominal",
      "title": null,
      "sort": "descending",
      "legend": { "orient": "top", "direction": "horizontal", "columns": 3 }
    },
    "order": {
      "field": "Stage LegendStage",
      "type": "nominal",
      "sort": "descending"
    },
    "tooltip": [
      {
        "field": "Month",
        "type": "temporal",
        "title": "Month",
        "format": "%b %Y"
      },
      { "field": "Stage LegendStage", "type": "nominal", "title": "Stage" },
      { "field": "Users", "type": "quantitative", "title": "Users", "format": ",.0f" }
    ]
  }
}
