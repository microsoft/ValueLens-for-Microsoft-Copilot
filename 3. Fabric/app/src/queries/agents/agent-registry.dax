EVALUATE
SELECTCOLUMNS(
    FILTER(
        SUMMARIZECOLUMNS(
            'Agents 365'[Title ID],
            'Agents 365'[Agent name],
            'Agents 365'[Agent Type Label],
            'Agents 365'[Creator],
            'Agents 365'[Agent Lifecycle Order],
            'Agents 365'[Agent Lifecycle],
            'Agents 365'[Agent Usage Review],
            "@Records", [Agent Registry Records],
            "@Users", [Active Agent Users],
            "@Sessions", [Observed Agent Sessions]
        ),
        NOT ISBLANK([@Records])
    ),
    "Agent", 'Agents 365'[Agent name],
    "Type", 'Agents 365'[Agent Type Label],
    "Creator", 'Agents 365'[Creator],
    "Lifecycle Order", 'Agents 365'[Agent Lifecycle Order],
    "Lifecycle", 'Agents 365'[Agent Lifecycle],
    "Usage Review", 'Agents 365'[Agent Usage Review],
    "Users", [@Users],
    "Sessions", [@Sessions]
)
ORDER BY [Lifecycle Order], [Agent]