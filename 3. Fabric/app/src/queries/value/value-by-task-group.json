{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "mark": { "type": "bar", "cornerRadiusEnd": 2 },
  "encoding": {
    "y": {
      "field": "Chat + Agent Interactions (Audit Logs)Task Breakdown Group",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": { "labelLimit": 220 }
    },
    "x": {
      "field": "AI Assisted Value",
      "type": "quantitative",
      "title": "Estimated value",
      "axis": { "labelExpr": "format(datum.value, ',.0f')" }
    },
    "tooltip": [
      { "field": "Chat + Agent Interactions (Audit Logs)Task Breakdown Group", "type": "nominal", "title": "Task group" },
      { "field": "AI Assisted Value", "type": "quantitative", "title": "Estimated value", "format": ",.0f" },
      { "field": "Expert Equivalent Hours", "type": "quantitative", "title": "Expert-equivalent hours", "format": ",.1f" },
      { "field": "Share of Value", "type": "quantitative", "title": "Share of value", "format": ".1%" }
    ]
  }
}
