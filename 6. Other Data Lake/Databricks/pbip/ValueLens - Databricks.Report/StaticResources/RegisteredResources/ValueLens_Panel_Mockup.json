      "fontSize": 20,
      "color": "#1C2632"
    },
    "title": {
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
      "fontSize": 9,
      "color": "#1C2632"
    },
    "header": {
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
      "fontSize": 10,
      "color": "#1C2632"
    },
    "label": {
      "fontFace": "wf_standard-font, helvetica, arial, sans-serif",
      "fontSize": 8,
      "color": "#8793A3"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DBE0E6"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C2632"
              }
            },
            "alignment": "left",
            "fontSize": 9,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif"
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#1C2632"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#1C2632"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
