              {
                "textRuns": [
                  {
                    "value": "Priority score weights median unlicensed task events per week (60%) and median active days per week (40%), capped at 30 events and 5 days.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only users with unlicensed activity in the selection are scored, so a blank score means no evidence - not a low score.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rank is recalculated against whatever is currently selected.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Task events count prompt rows, not verified completed outcomes.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "color": "#605E5C"
                    }
