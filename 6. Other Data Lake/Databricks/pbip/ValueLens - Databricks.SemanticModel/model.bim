    "tables": [
      {
        "name": "Chat + Agent Interactions (Audit Logs)",
        "lineageTag": "be471a18-81ce-45e7-8166-531a052df5d5",
        "refreshPolicy": {
          "policyType": "basic",
          "rollingWindowGranularity": "month",
          "rollingWindowPeriods": 12,
          "incrementalGranularity": "day",
          "incrementalPeriods": 7,
          "incrementalPeriodsOffset": -1,
          "sourceExpression": [
            "let",
            "    // Value Lens 2307 (Spark) update: audit-log shaping now happens once in Spark",
            "    // (notebook Copilot_Audit_Log_Processor -> Delta table copilot_interactions_curated).",
            "    // Thin, query-folding passthrough: a single CreationDate range filter that folds to the",
            "    // Lakehouse SQL endpoint so Incremental Refresh only touches new day-partitions",
            "    // (and the model is Direct Lake-ready). All 59 output columns come straight from Spark.",
            "    Source   = FabricTable(\"copilot_interactions_curated\"),",
            "    Filtered = Table.SelectRows(Source, each [CreationDate] >= RangeStart and [CreationDate] < RangeEnd),",
            "    // Drop columns no visual or measure reads. This folds to a SQL projection,",
            "    // and removes 444 MB of AccessedResource_SiteUrl from every refresh.",
            "    Trimmed = Table.RemoveColumns(Filtered, {\"AccessedResource_SiteUrl\", \"Delegation_Event_Key\", \"AccessedResource_SensitivityLabelId\", \"AISystemPlugin_Id\", \"AISystemPlugin_Name\", \"AppIdentity_AppId\", \"AppIdentity_DisplayName\", \"AppIdentity_PublisherId\", \"ApplicationName\", \"Audit_UserKey\", \"Agent_EntraId\", \"Agent_TitleID\", \"Agent Last Used Date\", \"ClientRegion\", \"Is_Sensitive\", \"ModelTransparencyDetails_ModelName\", \"ModelTransparencyDetails_ModelProviderName\", \"Web_Grounded_Signal\", \"Workload\", \"Has license\", \"SensitivityLabelId\", \"Behavior_Source\", \"Behavior_Enriched\", \"User_Stage\", \"UserMonthKey\", \"Resource_Count\", \"Grounding Source\", \"Agent_Surface\", \"Execution_Trigger\"}, MissingField.Ignore)",
            "in",
            "    Trimmed"
          ]
        },
        "columns": [
          {
