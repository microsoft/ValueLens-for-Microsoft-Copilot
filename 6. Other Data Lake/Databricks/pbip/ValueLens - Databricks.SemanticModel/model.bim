            ]
          },
          {
            "type": "calculated",
            "name": "Work Shape Sort",
            "dataType": "int64",
            "description": [
              "Orders Work Shape strongest-fit first, so a matrix reads from the shapes",
              "that justify a heavier tool to the ones that do not."
            ],
            "isHidden": true,
            "expression": [
              "SWITCH(",
              "    'Chat + Agent Interactions (Audit Logs)'[Fit Rule Step],",
              "    1, 0,",
              "    2, 1,",
              "    3, 2,",
              "    5, 3,",
              "    10, 4,",
              "    6, 4,",
              "    8, 5,",
              "    9, 6,",
              "    4, 7,",
              "    8",
              ")"
            ],
            "lineageTag": "fc0000b1-0000-0000-0000-000000000005",
            "summarizeBy": "none",
            "annotations": [
