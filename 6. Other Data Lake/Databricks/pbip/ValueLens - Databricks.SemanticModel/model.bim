          {
            "type": "calculated",
            "name": "Agent Type Combined",
            "expression": [
              "",
              "IF(",
              "    'Agents 365'[Agent type (A365)] = \"Shared\" && ",
              "    CONTAINSSTRING('Agents 365'[Created in], \"Agent Builder\"),",
              "    \"Agent Builder\",",
              "    'Agents 365'[Agent type (A365)]",
              ")"
            ],
            "lineageTag": "dd221d12-3aef-458b-a221-7f6087c31d0c",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Agent Features",
            "expression": [
              "",
              "VAR Surfaces = 'Agents 365'[Supported in]",
              "",
              "// Surface icons (works for both delimiters — comma or semicolon)",
              "VAR HasCopilot = IF(SEARCH(\"Copilot\", Surfaces, 1, 0) > 0, \"🤖 in Copilot \", \"\")",
              "VAR HasTeams   = IF(SEARCH(\"Teams\",   Surfaces, 1, 0) > 0, \"💬 in Teams \",   \"\")",
              "VAR HasOutlook = IF(SEARCH(\"Outlook\", Surfaces, 1, 0) > 0, \"📧 in Outlook \", \"\")",
              "VAR HasOffice  = IF(SEARCH(\"Office\",  Surfaces, 1, 0) > 0, \"📄 in Office \",  \"\")",
              "VAR Platforms  = TRIM(HasCopilot & HasTeams & HasOutlook & HasOffice)",
              "",
              "VAR SPO      = IF(LOWER(TRIM(COALESCE('Agents 365'[Can read Sharepoint sites and files], \"\"))) IN {\"yes\", \"true\", \"1\"}",
              "                  || LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive and Sharepoint items], \"\"))) IN {\"yes\", \"true\", \"1\"},",
              "                  \"📁 SharePoint \", \"\")",
              "VAR OneDrive = IF(LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive files], \"\"))) IN {\"yes\", \"true\", \"1\"}",
              "                  || LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive and Sharepoint items], \"\"))) IN {\"yes\", \"true\", \"1\"},",
              "                  \"☁️ OneDrive \", \"\")",
              "VAR Graph    = IF(LOWER(TRIM(COALESCE('Agents 365'[Can extend to Graph connector], \"\"))) IN {\"yes\", \"true\", \"1\"}, \"🔌 Graph \", \"\")",
              "VAR Files    = IF(LOWER(TRIM(COALESCE('Agents 365'[Contains uploaded files], \"\"))) IN {\"yes\", \"true\", \"1\"}, \"📎 Files \", \"\")",
              "",
              "VAR Images = IF(LOWER(TRIM(COALESCE('Agents 365'[Can generate images using user prompt], \"\"))) IN {\"yes\", \"true\", \"1\"}, \"🎨 Images \", \"\")",
              "VAR Code   = IF(LOWER(TRIM(COALESCE('Agents 365'[Can use code interpreter], \"\"))) IN {\"yes\", \"true\", \"1\"}, \"🧮 Code \", \"\")",
              "",
              "VAR Capabilities = TRIM(SPO & OneDrive & Graph & Files & Images & Code)",
              "",
              "VAR Combined =",
              "    IF(Platforms <> \"\" && Capabilities <> \"\",",
              "       Platforms & \" | \" & Capabilities,",
              "       Platforms & Capabilities)",
              "",
              "VAR _CapabilityEvidence = LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive files], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "    || LOWER(TRIM(COALESCE('Agents 365'[Can read Sharepoint sites and files], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "    || LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive and Sharepoint items], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "    || LOWER(TRIM(COALESCE('Agents 365'[Can extend to Graph connector], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "    || LOWER(TRIM(COALESCE('Agents 365'[Contains uploaded files], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "    || LOWER(TRIM(COALESCE('Agents 365'[Can generate images using user prompt], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "    || LOWER(TRIM(COALESCE('Agents 365'[Can use code interpreter], \"\"))) IN {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "RETURN IF(Combined <> \"\", Combined, IF(_CapabilityEvidence, \"No affirmative capability flags reported\", \"Unknown / insufficient capability evidence\"))",
              ""
            ],
            "lineageTag": "7f224cd3-5ced-48b6-9d60-9abe8fbd5da8",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
