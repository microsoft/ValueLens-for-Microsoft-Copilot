                "value": "Date"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Surface / Agent",
            "description": [
              "One field combining Copilot surface and agent: the agent name for Copilot",
              "Studio feedback, otherwise the surface/App (M365 Chat, Teams, Word, Outlook...)."
            ],
            "expression": [
              "VAR app = ProductFeedback[App]",
              "VAR agent = ProductFeedback[AgentName]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        NOT ISBLANK(agent) && agent <> \"\", agent,",
              "        NOT ISBLANK(app) && app <> \"\", app,",
              "        \"Unknown\"",
              "    )"
            ],
            "lineageTag": "pf0surf01-0001-0001-0001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "ProductFeedback-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Sourced from the Fabric Lakehouse Delta table user_feedback (parser output).",
                "    Headers = if Enable_ProductFeedback = \"Include\" then (try FabricTable(\"user_feedback\") otherwise EmptyTable({\"Feedback Id\", \"Comment\", \"Translated Comment\", \"Comment Language\", \"Date Submitted UTC\", \"Feedback Type\", \"Microsoft Response Status\", \"App\", \"App Language\", \"Platform\", \"Source Type\", \"Logs, Attachments\", \"User Id\", \"User Email\", \"Browser\", \"Browser Version\", \"AI Context Prompt\", \"AI Context Response Message\", \"Survey Question\", \"Survey Response Option\", \"Additional Metadata\", \"Date Submitted Date\", \"Sentiment\"})) else EmptyTable({\"Feedback Id\", \"Comment\", \"Translated Comment\", \"Comment Language\", \"Date Submitted UTC\", \"Feedback Type\", \"Microsoft Response Status\", \"App\", \"App Language\", \"Platform\", \"Source Type\", \"Logs, Attachments\", \"User Id\", \"User Email\", \"Browser\", \"Browser Version\", \"AI Context Prompt\", \"AI Context Response Message\", \"Survey Question\", \"Survey Response Option\", \"Additional Metadata\", \"Date Submitted Date\", \"Sentiment\"}),",
                "    Renamed = Table.RenameColumns(Headers, {",
                "        {\"Feedback Id\", \"FeedbackId\"},",
                "        {\"Translated Comment\", \"TranslatedComment\"},",
                "        {\"Comment Language\", \"CommentLanguage\"},",
                "        {\"Date Submitted UTC\", \"DateSubmittedUTC\"},",
                "        {\"Feedback Type\", \"FeedbackType\"},",
                "        {\"Microsoft Response Status\", \"ResponseStatus\"},",
                "        {\"App Language\", \"AppLanguage\"},",
                "        {\"Source Type\", \"SourceType\"},",
                "        {\"Logs, Attachments\", \"HasLogsAttachments\"},",
                "        {\"Browser Version\", \"BrowserVersion\"},",
                "        {\"AI Context Prompt\", \"AIContextPrompt\"},",
                "        {\"AI Context Response Message\", \"AIContextResponse\"},",
                "        {\"Survey Question\", \"SurveyQuestion\"},",
                "        {\"Survey Response Option\", \"SurveyResponseOption\"},",
                "        {\"Additional Metadata\", \"AdditionalMetadata\"}",
                "    }, MissingField.Ignore),",
                "    Typed = let __vlTypes = {",
                "        {\"DateSubmittedUTC\", type datetime}",
                "    }, __vlPresent = Table.ColumnNames(Renamed), __vlSafe = List.Select(__vlTypes, each List.Contains(__vlPresent, _{0})) in Table.TransformColumnTypes(Renamed, __vlSafe, \"en-US\"),",
                "    AddDate = Table.AddColumn(Typed, \"FeedbackDate\", each try DateTime.Date([DateSubmittedUTC]) otherwise null, type date),",
                "    AddHasComment = Table.AddColumn(AddDate, \"HasComment\", each if [Comment] <> null and [Comment] <> \"\" then 1 else 0, Int64.Type),",
                "    AddPromptLen = Table.AddColumn(AddHasComment, \"PromptLength\", each if [AIContextPrompt] <> null then Text.Length([AIContextPrompt]) else 0, Int64.Type),",
                "    // --- Helper function: extract a JSON string value by key ---",
                "    // Searches for \"key\":\"value\" and returns value, or null if not found",
                "    fnExtract = (jsonText as nullable text, key as text) as nullable text =>",
                "        let",
                "            searchFor = \"\"\"\" & key & \"\"\":\"\"\",",
                "            keyLen = Text.Length(searchFor),",
                "            pos = if jsonText <> null and jsonText <> \"\" then Text.PositionOf(jsonText, searchFor) else -1,",
                "            result = if pos >= 0 then",
                "                let",
                "                    afterKey = Text.Middle(jsonText, pos + keyLen),",
                "                    endQuote = Text.PositionOf(afterKey, \"\"\"\")",
                "                in if endQuote > 0 then Text.Start(afterKey, endQuote) else null",
                "            else null",
                "        in result,",
                "    // --- Clean metadata: unescape double-encoded JSON rows ---",
                "    AddCleanMeta = Table.AddColumn(AddPromptLen, \"CleanMeta\", each",
                "        try",
                "            let",
                "                raw = Text.Trim([AdditionalMetadata]),",
                "                cleaned = if raw = null or raw = \"\" then null",
                "                    else if Text.StartsWith(raw, \"\"\"\") then",
                "                        Text.Replace(Text.Replace(Text.TrimEnd(Text.TrimStart(raw, \"\"\"\"), \"\"\"\"), \"\\\"\"\", \"\"\"\"), \"\\\\\", \"\\\")",
                "                    else raw",
                "            in cleaned",
                "        otherwise null, type text),",
                "    // --- Extract agent fields using the helper function ---",
                "    AddEssAgentId = Table.AddColumn(AddCleanMeta, \"EssAgentId\", each try fnExtract([CleanMeta], \"essAgentId\") otherwise null, type text),",
                "    AddAiAgentName = Table.AddColumn(AddEssAgentId, \"AiAgentName\", each",
                "        try (if [CleanMeta] <> null and Text.Contains([CleanMeta], \"aiAgents\") then fnExtract([CleanMeta], \"Name\") else null) otherwise null, type text),",
                "    AddAiAgentType = Table.AddColumn(AddAiAgentName, \"AiAgentType\", each",
                "        try (if [CleanMeta] <> null and Text.Contains([CleanMeta], \"aiAgents\") then fnExtract([CleanMeta], \"Type\") else null) otherwise null, type text),",
                "    AddCopilotType = Table.AddColumn(AddAiAgentType, \"CopilotType\", each try fnExtract([CleanMeta], \"copilotType\") otherwise null, type text),",
                "    AddUiHost = Table.AddColumn(AddCopilotType, \"UiHost\", each try fnExtract([CleanMeta], \"UiHost\") otherwise null, type text),",
                "    // --- Derive: IsAgentInteraction (boolean) and AgentName (text) ---",
                "    AddIsAgent = Table.AddColumn(AddUiHost, \"IsAgentInteraction\", each",
                "        try (([EssAgentId] <> null) or ([AiAgentName] <> null) or ([CopilotType] <> null and [CopilotType] = \"custom\")) otherwise false, type logical),",
                "    AddAgentName = Table.AddColumn(AddIsAgent, \"AgentName\", each",
                "        try (if [AiAgentName] <> null then [AiAgentName]",
                "        else if [EssAgentId] <> null then [EssAgentId]",
                "        else if [CopilotType] = \"custom\" then \"Custom Agent\"",
                "        else null) otherwise null, type text),",
                "    Selected = Table.SelectColumns(AddAgentName, {\"Comment\", \"FeedbackType\", \"App\", \"AIContextPrompt\", \"FeedbackDate\", \"IsAgentInteraction\", \"AgentName\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Feedback",
            "expression": "COUNTROWS('ProductFeedback')",
            "formatString": "#,0",
            "displayFolder": "📊 Product Feedback",
            "lineageTag": "90516dc6-9385-4933-8b70-473b4a05ac15"
          },
          {
            "name": "Thumbs Up Count",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS('ProductFeedback'),",
              "    'ProductFeedback'[FeedbackType] = \"Thumbs Up\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "📊 Product Feedback",
            "lineageTag": "aac9112a-bea8-40c7-ac11-1c464f2f92c4"
          },
          {
            "name": "Thumbs Down Count",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS('ProductFeedback'),",
              "    'ProductFeedback'[FeedbackType] = \"Thumbs Down\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "📊 Product Feedback",
            "lineageTag": "0f887cc4-cb1c-4047-9690-2d75aabcaeef"
          },
          {
            "name": "Satisfaction Rate",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        COUNTROWS('ProductFeedback'),",
              "        'ProductFeedback'[FeedbackType] = \"Thumbs Up\"",
              "    ),",
              "    COUNTROWS('ProductFeedback'),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "📊 Product Feedback",
            "lineageTag": "a6f0e143-1042-4c78-a0c4-594a8a878ef9"
          },
          {
            "name": "📊 Feedback Theme Summary",
            "description": "Dynamic narrative: summarises the top themes driving positive and negative feedback in current filter context",
            "expression": [
              "VAR TotalFB = COUNTROWS('ProductFeedback')",
              "VAR TotalDown = CALCULATE(COUNTROWS('ProductFeedback'), 'ProductFeedback'[FeedbackType] = \"Thumbs Down\")",
              "VAR TotalUp = CALCULATE(COUNTROWS('ProductFeedback'), 'ProductFeedback'[FeedbackType] = \"Thumbs Up\")",
              "VAR CatStats =",
              "    ADDCOLUMNS(",
              "        FILTER(VALUES('ProductFeedback'[FeedbackCategory]),",
              "            [FeedbackCategory] <> \"🧪 Testing\" && [FeedbackCategory] <> \"❓ Uncategorized\"),",
              "        \"CatTotal\", CALCULATE(COUNTROWS('ProductFeedback')),",
              "        \"CatUp\", CALCULATE(COUNTROWS('ProductFeedback'), 'ProductFeedback'[FeedbackType] = \"Thumbs Up\"),",
              "        \"CatDown\", CALCULATE(COUNTROWS('ProductFeedback'), 'ProductFeedback'[FeedbackType] = \"Thumbs Down\"),",
              "        \"CatSat\", DIVIDE(",
              "            CALCULATE(COUNTROWS('ProductFeedback'), 'ProductFeedback'[FeedbackType] = \"Thumbs Up\"),",
              "            CALCULATE(COUNTROWS('ProductFeedback')), 0)",
              "    )",
              "VAR NegCats = FILTER(CatStats, [CatDown] > 0)",
              "VAR WorstCat = TOPN(1, NegCats, [CatDown], DESC)",
              "VAR WorstName = MAXX(WorstCat, [FeedbackCategory])",
              "VAR WorstDown = MAXX(WorstCat, [CatDown])",
              "VAR WorstSat = MAXX(WorstCat, [CatSat])",
              "VAR SecondWorst = TOPN(1, FILTER(NegCats, [FeedbackCategory] <> WorstName), [CatDown], DESC)",
              "VAR SecondName = MAXX(SecondWorst, [FeedbackCategory])",
              "VAR SecondDown = MAXX(SecondWorst, [CatDown])",
              "VAR PosCats = FILTER(CatStats, [CatUp] > 0)",
              "VAR BestCat = TOPN(1, PosCats, [CatSat], DESC)",
              "VAR BestName = MAXX(BestCat, [FeedbackCategory])",
              "VAR BestSat = MAXX(BestCat, [CatSat])",
              "VAR BestTotal = MAXX(BestCat, [CatTotal])",
              "VAR NegLine =",
              "    IF(COUNTROWS(NegCats) > 0,",
              "        \"Most negative feedback is in \" & WorstName & \" (\" & FORMAT(WorstDown, \"#,0\") & \" thumbs down, \" & FORMAT(WorstSat, \"0%\") & \" sat.)\" &",
              "        IF(COUNTROWS(SecondWorst) > 0,",
              "            \", followed by \" & SecondName & \" (\" & FORMAT(SecondDown, \"#,0\") & \" thumbs down).\", \".\"),",
              "        \"\")",
              "VAR PosLine =",
              "    IF(COUNTROWS(PosCats) > 0,",
              "        \"Strongest theme is \" & BestName & \" at \" & FORMAT(BestSat, \"0%\") & \" satisfaction (\" & FORMAT(BestTotal, \"#,0\") & \" items).\",",
              "        \"\")",
              "VAR OverallLine = FORMAT(TotalFB, \"#,0\") & \" feedback items across \" & FORMAT(COUNTROWS(CatStats), \"#,0\") & \" topics: \" & FORMAT(DIVIDE(TotalUp, TotalFB, 0), \"0%\") & \" overall satisfaction.\"",
              "RETURN",
              "IF(TotalFB > 0,",
              "    OverallLine & \" \" & PosLine & \" \" & NegLine,",
              "    \"No feedback data in current selection.\")"
            ],
            "displayFolder": "📂 Feedback Categories",
            "lineageTag": "a1b2c3d4-0003-0003-0001-000000000001"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
