        "partitions": [
          {
            "name": "Human Time Estimates",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(",
                "        {\"Behavior\", \"Human Baseline (min)\", \"Confidence\", \"Primary Source\", \"Source URL\", \"Category\", \"Value Outcome\", \"Cowork Category\", \"Min Low\", \"Min Typical\", \"Min High\", \"Effort Grain\"},",
                "        {",
                "            // Category = tool-agnostic work-pattern taxonomy (12 buckets): Email, Meetings,",
                "            // Document Creation, Document Summarisation, Presentations, Data & Analysis,",
                "            // Search & Research, Coding & Technical, Creative & Design, Collaboration & Workflows,",
                "            // Specialist Support, General Chat & Q&A. Assigned per behavior regardless of AI tool.",
                "            {\"Email Triage\", 10, \"Medium\", \"Iqbal & Horvitz (CHI 2007, Microsoft Research)\", \"https://doi.org/10.1145/1240624.1240730\", \"Email\", \"Time Saved (Email)\", \"Email workflows\", 4, 10, 12, \"Per Turn\"},",
                "            {\"Email Thread Summary\", 5, \"Medium\", \"Mark, Iqbal & Czerwinski (CHI 2016, Microsoft Research)\", \"https://doi.org/10.1145/2858036.2858262\", \"Email\", \"Time Saved (Email)\", \"Email workflows\", 2, 5, 9, \"Per Turn\"},",
                "            {\"Email Summarising\", 4, \"Medium\", \"Dabbish & Kraut (CSCW 2006); Mark et al. (CHI 2012)\", \"https://doi.org/10.1145/1180875.1180941\", \"Email\", \"Time Saved (Email)\", \"Email workflows\", 2, 4, 7, \"Per Turn\"},",
                "            {\"Scheduled / Recurring Run\", 20, \"Low\", \"Provisional - BVA estimate, not yet source-good-fit\", \"\", \"Collaboration & Workflows\", \"Workflow Automation\", \"Specialized workflows\", 8, 20, 32, \"Per Turn\"},",
                "            {\"Monitoring & Alerting\", 20, \"Low\", \"Provisional - BVA estimate, not yet source-good-fit\", \"\", \"Collaboration & Workflows\", \"Workflow Automation\", \"Specialized workflows\", 8, 20, 32, \"Per Turn\"},",
                "            {\"Multi-source Synthesis\", 75, \"Low\", \"Provisional - apportioned from Analysis & Research envelope\", \"\", \"Search & Research\", \"Decision Support\", \"Analysis & Research\", 34, 75, 92, \"Per Resource\"},",
                "            {\"Code Review & PR\", 40, \"Low\", \"Bacchelli & Bird (ICSE 2013)\", \"https://doi.org/10.1109/ICSE.2013.6606617\", \"Coding & Technical\", \"Content Output\", \"Write or debug code\", 21, 40, 69, \"Per Turn\"},",
                "            {\"Build & Deploy Run\", 25, \"Low\", \"Provisional - BVA estimate, not yet source-good-fit\", \"\", \"Coding & Technical\", \"Workflow Automation\", \"Specialized workflows\", 10, 25, 40, \"Per Turn\"},",
                "            {\"Email Drafting\", 8, \"Medium\", \"Brynjolfsson, Li & Raymond (NBER 2023)\", \"https://www.nber.org/papers/w31161\", \"Email\", \"Content Output\", \"Email workflows\", 3, 8, 12, \"Per Turn\"},",
                "            {\"Teams Messaging\", 8, \"Medium\", \"Cutrell, Czerwinski & Horvitz (Microsoft Research 2001)\", \"https://www.microsoft.com/en-us/research/publication/effects-of-instant-messaging-interruptions-on-computing-tasks-2/\", \"Collaboration & Workflows\", \"Communication Time Saved\", \"Communication workflows\", 4, 8, 11, \"Per Turn\"},",
                "            {\"Meeting Scheduling\", 12, \"Medium\", \"Cranshaw et al. (CHI 2017, Microsoft Research)\", \"https://doi.org/10.1145/3025453.3025780\", \"Meetings\", \"Communication Time Saved\", \"Meeting workflows\", 5, 12, 17, \"Per Turn\"},",
                "            \t\t\t\t            {\"Meeting Prep\", 15, \"Medium\", \"Rogelberg et al. (J. Applied Psychology 2006)\", \"https://doi.org/10.1037/0021-9010.91.1.83\", \"Meetings\", \"Time Saved (Meetings)\", \"Meeting workflows\", 6, 15, 22, \"Per Resource\"},",
                "            {\"Video Summarising\", 30, \"Low\", \"Provisional estimate\", \"\", \"Meetings\", \"Time Saved (Meetings)\", \"Meeting workflows\", 12, 30, 44, \"Per Turn\"},",
                "            \t\t\t\t            {\"Document Drafting\", 60, \"High\", \"Noy & Zhang (Science 2023)\", \"https://www.science.org/doi/10.1126/science.adh2586\", \"Document Creation\", \"Content Output\", \"Document & content creation\", 21, 42, 42, \"Per Turn\"},",
                "            {\"Document Summarising\", 20, \"Medium-High\", \"Dell'Acqua et al. (HBS Working Paper 24-013, 2023)\", \"https://aiinstitute.hbs.edu/navigating-the-jagged-technological-frontier/\", \"Document Summarisation\", \"Time Saved (Documents)\", \"Document & content creation\", 10, 20, 35, \"Per Turn\"},",
                "            {\"Presentation Creation\", 90, \"Medium\", \"Dell'Acqua et al. (HBS Working Paper 24-013, 2023)\", \"https://aiinstitute.hbs.edu/navigating-the-jagged-technological-frontier/\", \"Presentations\", \"Content Output\", \"Document & content creation\", 21, 42, 42, \"Per Turn\"},",
                "            {\"Presentation Summarising\", 12, \"Medium\", \"Brysbaert (J. Mem. Lang. 2019)\", \"https://doi.org/10.1016/j.jml.2019.104047\", \"Document Summarisation\", \"Time Saved (Documents)\", \"Document & content creation\", 6, 12, 21, \"Per Turn\"},",
                "            {\"Note Taking\", 20, \"Low\", \"Provisional estimate\", \"\", \"Document Creation\", \"Time Saved (Documents)\", \"Document & content creation\", 10, 20, 35, \"Per Turn\"},",
                "            {\"Image Generation\", 60, \"Low\", \"Provisional estimate\", \"\", \"Creative & Design\", \"Content Output\", \"Document & content creation\", 21, 42, 42, \"Per Turn\"},",
                "            {\"Image/Media Analysis\", 8, \"Low\", \"Provisional estimate\", \"\", \"Creative & Design\", \"Content Output\", \"Document & content creation\", 4, 8, 14, \"Per Resource\"},",
                "            {\"Image / Media Analysis\", 8, \"Low\", \"Provisional estimate\", \"\", \"Creative & Design\", \"Content Output\", \"Document & content creation\", 4, 8, 14, \"Per Resource\"},",
                "            {\"Code Writing\", 45, \"High\", \"Peng et al. (arXiv 2023, GitHub Copilot RCT)\", \"https://arxiv.org/abs/2302.06590\", \"Coding & Technical\", \"Coding Capability\", \"Write or debug code\", 24, 45, 77, \"Per Turn\"},",
                "            {\"Code Analysis\", 30, \"Medium\", \"Bacchelli & Bird (ICSE 2013)\", \"https://doi.org/10.1109/ICSE.2013.6606617\", \"Coding & Technical\", \"Coding Capability\", \"Write or debug code\", 16, 30, 51, \"Per Resource\"},",
                "            {\"Code Analysis (URL)\", 15, \"Low\", \"Provisional estimate\", \"\", \"Coding & Technical\", \"Coding Capability\", \"Write or debug code\", 8, 15, 26, \"Per Turn\"},",
                "            {\"Data Querying\", 30, \"Low\", \"Provisional estimate\", \"\", \"Data & Analysis\", \"Data-Driven Decisions\", \"Analysis & Research\", 13, 30, 41, \"Per Resource\"},",
                "            {\"Spreadsheet Analysis\", 40, \"Low\", \"Provisional estimate\", \"\", \"Data & Analysis\", \"Data-Driven Decisions\", \"Analysis & Research\", 18, 40, 55, \"Per Turn\"},",
                "            {\"Spreadsheet Review\", 25, \"Low\", \"Provisional estimate\", \"\", \"Data & Analysis\", \"Spreadsheet Time Saved\", \"Analysis & Research\", 11, 25, 34, \"Per Turn\"},",
                "            {\"Excel Assistance\", 30, \"Low\", \"Provisional estimate\", \"\", \"Data & Analysis\", \"Spreadsheet Time Saved\", \"Analysis & Research\", 13, 30, 41, \"Per Turn\"},",
                "            \t\t\t\t            {\"Web Searching\", 22, \"Medium\", \"McKinsey Global Institute (2012)\", \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\", \"Search & Research\", \"Search Time Saved\", \"Analysis & Research\", 10, 22, 30, \"Per Resource\"},",
                "            {\"Enterprise Searching\", 18, \"Medium\", \"McKinsey Global Institute (2012)\", \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\", \"Search & Research\", \"Search Time Saved\", \"Analysis & Research\", 8, 18, 25, \"Per Resource\"},",
                "            {\"PDF Analysis\", 35, \"Medium\", \"Brysbaert (J. Mem. Lang. 2019)\", \"https://doi.org/10.1016/j.jml.2019.104047\", \"Document Summarisation\", \"Search Time Saved\", \"Analysis & Research\", 16, 35, 48, \"Per Resource\"},",
                "            {\"SharePoint Access\", 12, \"Medium\", \"McKinsey Global Institute (2012)\", \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\", \"Search & Research\", \"Search Time Saved\", \"Analysis & Research\", 5, 12, 16, \"Per Turn\"},",
                "            {\"File Retrieval\", 15, \"Medium\", \"McKinsey Global Institute (2012)\", \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\", \"Search & Research\", \"Search Time Saved\", \"Analysis & Research\", 7, 15, 21, \"Per Resource\"},",
                "            {\"People Lookup\", 10, \"Medium\", \"McKinsey Global Institute (2012)\", \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\", \"Search & Research\", \"Search Time Saved\", \"General assistance / Other\", 3, 8, 8, \"Per Resource\"},",
                "            {\"Knowledge Base\", 12, \"Medium\", \"McKinsey Global Institute (2012)\", \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\", \"Search & Research\", \"Search Time Saved\", \"Specialized workflows\", 5, 12, 19, \"Per Turn\"},",
                "            \t\t\t\t            {\"Coaching\", 45, \"Low\", \"Provisional estimate\", \"\", \"Specialist Support\", \"Skills Development\", \"Specialized workflows\", 16, 40, 40, \"Per Turn\"},",
                "            {\"Coaching (URL)\", 25, \"Low\", \"Provisional estimate\", \"\", \"Specialist Support\", \"Skills Development\", \"Specialized workflows\", 10, 25, 40, \"Per Turn\"},",
                "            {\"Sales & Customer\", 35, \"Medium\", \"Brynjolfsson, Li & Raymond (NBER 2023)\", \"https://www.nber.org/papers/w31161\", \"Specialist Support\", \"Revenue Enablement\", \"Specialized workflows\", 14, 35, 40, \"Per Turn\"},",
                "            {\"IT & Service Desk\", 20, \"Medium-High\", \"Brynjolfsson, Li & Raymond (NBER 2023)\", \"https://www.nber.org/papers/w31161\", \"Specialist Support\", \"Service Desk Deflection\", \"Specialized workflows\", 8, 20, 32, \"Per Turn\"},",
                "            {\"Compliance & Policy\", 25, \"Medium\", \"Martin et al. (arXiv 2024)\", \"https://arxiv.org/abs/2401.16212\", \"Specialist Support\", \"Compliance & Risk\", \"Specialized workflows\", 10, 25, 40, \"Per Turn\"},",
                "            {\"Sensitive Content Interaction\", 20, \"Low\", \"Provisional estimate\", \"\", \"Specialist Support\", \"Compliance & Risk\", \"Specialized workflows\", 8, 20, 32, \"Per Turn\"},",
                "            {\"HR & People\", 35, \"Low\", \"Provisional estimate\", \"\", \"Specialist Support\", \"HR Process Automation\", \"Specialized workflows\", 14, 35, 40, \"Per Turn\"},",
                "            {\"Research & Analysis\", 45, \"Medium\", \"Noy & Zhang (Science 2023)\", \"https://www.science.org/doi/10.1126/science.adh2586\", \"Search & Research\", \"Data-Driven Decisions\", \"Analysis & Research\", 20, 45, 62, \"Per Turn\"},",
                "            {\"Data & Reporting\", 35, \"Low\", \"Provisional estimate\", \"\", \"Data & Analysis\", \"Data-Driven Decisions\", \"Analysis & Research\", 16, 35, 48, \"Per Turn\"},",
                "            {\"Content Generation\", 25, \"Medium-High\", \"Noy & Zhang (Science 2023)\", \"https://www.science.org/doi/10.1126/science.adh2586\", \"Document Creation\", \"Content Output\", \"Document & content creation\", 12, 25, 42, \"Per Turn\"},",
                "            {\"Ideation & Creative\", 40, \"Medium\", \"Diehl & Stroebe (J. Pers. Soc. Psychol. 1987)\", \"https://doi.org/10.1037/0022-3514.53.3.497\", \"Creative & Design\", \"Content Output\", \"Document & content creation\", 20, 40, 42, \"Per Turn\"},",
                "            {\"General Assistance\", 15, \"Low\", \"Dillon et al. (Microsoft, arXiv 2025)\", \"https://arxiv.org/abs/2504.11443\", \"General Chat & Q&A\", \"General AI Productivity\", \"General assistance / Other\", 3, 8, 8, \"Per Turn\"},",
                "            {\"Running a Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Specialized workflows\", 6, 15, 24, \"Per Turn\"},",
                "            {\"Specialist / Line-of-Business Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Specialized workflows\", 6, 15, 24, \"Per Turn\"},",
                "            {\"Email Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Email workflows\", 5, 12, 12, \"Per Turn\"},",
                "            {\"Meeting Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Meeting workflows\", 6, 15, 22, \"Per Turn\"},",
                "            {\"Data & Reporting Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Specialized workflows\", 6, 15, 24, \"Per Turn\"},",
                "            {\"Document Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Document & content creation\", 8, 15, 26, \"Per Turn\"},",
                "            {\"Coordination Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Communication workflows\", 6, 11, 11, \"Per Turn\"},",
                "            {\"General Workflow\", 15, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Workflow Triggered\", \"Specialized workflows\", 6, 15, 24, \"Per Turn\"},",
                "            {\"Task Management\", 20, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Task Coordination\", \"Communication workflows\", 6, 11, 11, \"Per Turn\"},",
                "            {\"Real-time Collaboration\", 30, \"Medium\", \"D'Angelo, Di Iorio & Zacchiroli (CSCW 2018)\", \"https://doi.org/10.1145/3274310\", \"Collaboration & Workflows\", \"Team Collaboration\", \"Communication workflows\", 6, 11, 11, \"Per Turn\"},",
                "            {\"Form/Survey Work\", 25, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Team Collaboration\", \"Specialized workflows\", 10, 25, 40, \"Per Turn\"},",
                "            {\"Form / Survey Work\", 25, \"Low\", \"Provisional estimate\", \"\", \"Collaboration & Workflows\", \"Team Collaboration\", \"Specialized workflows\", 10, 25, 40, \"Per Turn\"},",
                "            {\"M365 Chat Q&A\", 10, \"Medium\", \"Dillon et al. (Microsoft, arXiv 2025)\", \"https://arxiv.org/abs/2504.11443\", \"General Chat & Q&A\", \"General AI Productivity\", \"General assistance / Other\", 3, 8, 8, \"Per Turn\"},",
                "            {\"Teams Q&A\", 10, \"Medium\", \"Dillon et al. (Microsoft, arXiv 2025)\", \"https://arxiv.org/abs/2504.11443\", \"General Chat & Q&A\", \"General AI Productivity\", \"General assistance / Other\", 3, 8, 8, \"Per Turn\"},",
                "            {\"Browser Q&A\", 10, \"Medium\", \"Dillon et al. (Microsoft, arXiv 2025)\", \"https://arxiv.org/abs/2504.11443\", \"General Chat & Q&A\", \"General AI Productivity\", \"General assistance / Other\", 3, 8, 8, \"Per Turn\"},",
                "            {\"General Q&A\", 10, \"Medium\", \"Dillon et al. (Microsoft, arXiv 2025)\", \"https://arxiv.org/abs/2504.11443\", \"General Chat & Q&A\", \"General AI Productivity\", \"General assistance / Other\", 3, 8, 8, \"Per Turn\"},",
                "            {\"General Chat\", 10, \"Medium\", \"Dillon et al. (Microsoft, arXiv 2025)\", \"https://arxiv.org/abs/2504.11443\", \"General Chat & Q&A\", \"General AI Productivity\", \"General assistance / Other\", 3, 8, 8, \"Per Turn\"},",
                "            {\"Domain-Specific Agent\", 25, \"Low\", \"Provisional estimate\", \"\", \"Specialist Support\", \"Specialist Expertise\", \"Specialized workflows\", 10, 25, 40, \"Per Turn\"},",
                "            {\"Cross-Org Agent\", 30, \"Low\", \"Provisional estimate\", \"\", \"Specialist Support\", \"Specialist Expertise\", \"Specialized workflows\", 12, 30, 40, \"Per Turn\"}",
                "        }",
                "    ),",
                "    #\"Changed Type\" = let __vlTypes = {",
                "        {\"Behavior\", type text},",
                "        {\"Human Baseline (min)\", Int64.Type},",
                "        {\"Confidence\", type text},",
                "        {\"Primary Source\", type text},",
                "        {\"Source URL\", type text},",
                "        {\"Category\", type text},",
                "        {\"Value Outcome\", type text},",
                "        {\"Cowork Category\", type text},",
                "        {\"Min Low\", Int64.Type},",
                "        {\"Min Typical\", Int64.Type},",
                "        {\"Min High\", Int64.Type},",
                "        {\"Effort Grain\", type text}",
                "    }, __vlPresent = Table.ColumnNames(Source), __vlSafe = List.Select(__vlTypes, each List.Contains(__vlPresent, _{0})) in Table.TransformColumnTypes(Source, __vlSafe)",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
