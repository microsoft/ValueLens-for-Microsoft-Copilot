              }
            ]
          },
          {
            "name": "Workflow_Action",
            "dataType": "string",
            "description": [
              "Drill-down for \"Running a Workflow\" rows — what is the workflow actually doing?",
              "BLANK for all non-workflow rows. Categorises the AccessedResource_Action verb",
              "into 7 buckets so the Agents cohort can be broken down by workflow purpose",
              "(Sending, Creating, Invoking, Updating, Reading, Deleting, or Other).",
              "AppHost is used as a last-resort splitter when no action verb is logged."
            ],
            "sourceColumn": "Workflow_Action",
            "lineageTag": "ff030001-0001-0001-0001-000000000202",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Is_Agent_Activity",
            "dataType": "boolean",
            "description": [
              "Is_Agent_Activity — TRUE for any agent / autonomous / workflow audit row,",
              "regardless of who ran it. Lets the Agents cohort overlap with Licensed / Unlicensed",
              "in slicers and measures (a licensed user's workflow run is BOTH Licensed AND Agent).",
              "",
              "TRUE when ANY of:",
              "- AgentName is populated, OR",
              "- AgentId is populated, OR",
              "- AppHost IN {autonomous, logic app}, OR",
              "- AccessedResource_Type IN {flow, connector}",
              "",
              "Note: Cowork rows have AgentName containing \"cowork\", so Is_Agent_Activity is also",
              "TRUE for Cowork rows (Cowork ⊂ Agents conceptually)."
            ],
            "sourceColumn": "Is_Agent_Activity",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "ff030001-0001-0001-0001-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Agent Filter",
            "dataType": "string",
            "description": [
              "Agent Filter — slicer-friendly label derived from Is_Agent_Activity.",
              "Returns \"Agents\" for any agent / autonomous / workflow / cowork row, BLANK otherwise.",
              "Use as the binding column for a single-tile \"Agents\" slicer on report pages.",
              "BLANK rows are hidden by Power BI by default in slicers, so a tile-style slicer",
              "shows exactly one button labelled \"Agents\"."
            ],
            "sourceColumn": "Agent Filter",
            "lineageTag": "ff030001-0001-0001-0001-000000000a07",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Agent_LinkID",
            "dataType": "string",
            "sourceColumn": "Agent_LinkID",
            "lineageTag": "d95f3f17-000a-444e-99a1-ae30d09433e4",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Agent_Key",
            "dataType": "string",
            "description": [
              "Agent_Key - the agent this row used: agent ID, else agent name, else AppIdentity.",
              "Blank for rows with no agent (plain Copilot chat). Use DISTINCTCOUNT for agent counts."
            ],
            "sourceColumn": "Agent_Key",
            "lineageTag": "a6e1c0d2-7b41-4c55-9f3e-1d2a00000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Agent_Type",
            "dataType": "string",
            "description": [
              "Agent_Type - what kind of agent the row used, from the audit agent ID, name,",
              "AppIdentity, PlatformAgentType and workload (first matching rule wins):",
              "Microsoft first-party agents - published / non-published / M365 Copilot agents;",
              "Microsoft 365 Copilot Agent Builder - declarative agents; Copilot Studio - custom engine",
              "agents; Copilot Studio - other / standalone agents; Microsoft Facilitator (Teams);",
              "Published by your organisation (T_ ID); Shared by creator (U_ ID); Agent Store package",
              "(P_ ID); Custom / third-party AI apps registered in your organisation; Unclassified agents.",
              "Blank for rows with no agent. See docs/METHODOLOGY.md (Agent type classification)."
            ],
            "sourceColumn": "Agent_Type",
            "lineageTag": "a6e1c0d2-7b41-4c55-9f3e-1d2a00000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Agent_Type_Basis",
            "dataType": "string",
            "description": [
              "Agent_Type_Basis - how firm Agent_Type is: documented (Microsoft documents the pattern),",
              "observed (seen in audit data, not documented), inferred (the T_/U_/P_ agent-ID prefix",
              "convention, not documented by Microsoft) or override (agent_type_overrides table)."
            ],
            "sourceColumn": "Agent_Type_Basis",
            "lineageTag": "a6e1c0d2-7b41-4c55-9f3e-1d2a00000003",
            "summarizeBy": "none",
