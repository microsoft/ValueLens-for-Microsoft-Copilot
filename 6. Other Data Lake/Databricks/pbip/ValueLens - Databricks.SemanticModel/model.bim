        "partitions": [
          {
            "name": "Model Fit View",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "{",
                "    (\"Task Category\", NAMEOF('Chat + Agent Interactions (Audit Logs)'[Task Breakdown Group]), 0),",
                "    (\"Organisation\", NAMEOF('Chat + Agent Org Data'[Organization]), 1),",
                "    (\"Person\", NAMEOF('Chat + Agent Interactions (Audit Logs)'[Audit_UserId]), 2)",
                "}"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "fc0000d100000000000000000000a0a0"
          }
        ]
      },
      {
        "name": "Assumptions",
        "description": [
          "Fixed assumptions behind the value, cost and hours measures, kept in one place.",
          "Each used to be a what-if parameter table with no reachable slicer, so it always returned",
          "its default. Edit a value here to change it everywhere. Hourly Value and Effort Scenario",
          "stay as their own tables because each drives a slicer on the report. Fit Grading sets how",
          "strict the Cowork Fit and Model Fit grade is (Balanced by default)."
        ],
        "lineageTag": "a602b1fb-301c-4334-a8e5-983a8c4df77c",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Value",
            "dataType": "int64",
            "isNameInferred": true,
            "isHidden": true,
            "sourceColumn": "[Value]",
            "formatString": "0",
            "lineageTag": "87e52200-78a6-4da2-9a4d-8cda01848b22",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Fit Grading",
            "dataType": "string",
            "description": [
              "FIT GRADING - how strict the Cowork Fit and Model Fit grade is. Type one of:",
              "Balanced (default): messages read and one-app work count as Fair fit, so Worth a look is kept",
              "for chat where nothing was read or attached.",
              "Lenient: a longer chat with nothing attached counts as Fair fit too.",
              "Strict: the original rule - chat only or one app is Worth a look.",
              "Any other value reads as Balanced. A calculated column rather than a measure because the grade",
              "itself is a calculated column: the fit chain reads this with no context transition, and Desktop",
              "recalculates the grade as soon as the text changes (a refresh does the same)."
            ],
            "expression": "\"Balanced\"",
            "lineageTag": "fitg0001-fitg-colm-0001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Assumptions",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{1}"
            }
          }
        ],
        "measures": [
          {
            "name": "Penalty Factor Value",
            "description": "Multiplier applied by [AI Assisted Value]. 1 = no penalty.",
            "expression": "1",
            "lineageTag": "5e655404-411a-4f53-85c0-2e3a711cf798",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "AI PPUPM Value",
            "description": [
              "Copilot price per user per month, used by [Copilot License Investment]. Enter it in the",
              "[Currency Symbol Value] currency."
            ],
            "expression": "30",
            "lineageTag": "0210af26-a0e0-4d8a-b931-fbc56d193547",
            "formatStringDefinition": {
              "expression": "\"\"\"\" & [Currency Symbol Value] & \"\"\"#,##0.00\""
            }
          },
          {
            "name": "Monthly Licence Cost Value",
            "description": [
              "Per-user / month cost of one Copilot licence, used to price dormant seats. 0 = not costed,",
              "and the Reclaim Cost Notice says so. Set a value here, in the [Currency Symbol Value] currency, to price them."
            ],
            "expression": "0",
            "lineageTag": "alc00001-alc0-meas-0001-000000000001",
            "formatStringDefinition": {
              "expression": "\"\"\"\" & [Currency Symbol Value] & \"\"\"#,##0.00\""
            }
          },
          {
            "name": "Adj Comms",
            "description": [
              "Multiplier on the human-time estimates for Comms behaviours (email, Teams, scheduling).",
              "1 = benchmark (100%). Change it here to scale those estimates."
            ],
            "expression": "1",
            "formatString": "0%",
            "lineageTag": "5d000001-meas-0000-000000000001"
          },
          {
            "name": "Adj Agents",
            "description": [
              "Multiplier on the human-time estimates for Agents behaviours (service desk, HR, research, workflows).",
              "1 = benchmark (100%). Change it here to scale those estimates."
            ],
            "expression": "1",
            "formatString": "0%",
            "lineageTag": "5d000005-meas-0000-000000000001"
          },
          {
            "name": "Adj Content",
            "description": [
              "Multiplier on the human-time estimates for Content behaviours (documents, presentations, notes).",
              "1 = benchmark (100%). Change it here to scale those estimates."
            ],
            "expression": "1",
            "formatString": "0%",
            "lineageTag": "5d000003-meas-0000-000000000001"
          },
          {
            "name": "Adj Meetings",
            "description": [
              "Multiplier on the human-time estimates for Meetings behaviours (meeting prep, recaps).",
              "1 = benchmark (100%). Change it here to scale those estimates."
            ],
            "expression": "1",
            "formatString": "0%",
            "lineageTag": "5d000002-meas-0000-000000000001"
          },
          {
            "name": "Adj Search",
            "description": [
              "Multiplier on the human-time estimates for Search behaviours (web, enterprise and file search).",
              "1 = benchmark (100%). Change it here to scale those estimates."
            ],
            "expression": "1",
            "formatString": "0%",
            "lineageTag": "5d000004-meas-0000-000000000001"
          },
          {
            "name": "Currency Symbol Value",
            "description": [
              "Display-only currency symbol for every money figure: value, licence cost, ROI, the hourly",
              "salary caption and money text in notices. Set one symbol here, for example \"£\", \"$\" or \"€\".",
              "It does NOT convert currency: enter Hourly Value, AI PPUPM Value and Monthly Licence Cost",
              "Value in this currency already."
            ],
            "expression": "\"£\"",
            "lineageTag": "cur00001-curr-meas-0001-000000000001"
          },
          {
            "name": "Hourly Salary Title",
            "description": [
              "Caption for the Hourly Salary slicers, so the input names the same currency as the",
              "money measures."
            ],
            "expression": "\"Hourly Salary (\" & [Currency Symbol Value] & \")\"",
            "isHidden": true,
            "lineageTag": "6c1f2a90-4b7e-4d2a-9c3e-5a8b0f1d2e03"
          },
          {
            "name": "Fit Grading Value",
            "description": "The Fit Grading setting as text, for the \"how to read\" notices on Cowork Fit and Model Fit.",
            "expression": "SELECTEDVALUE(Assumptions[Fit Grading], \"Balanced\")",
            "isHidden": true,
            "lineageTag": "fitg0001-fitg-meas-0001-000000000001"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "8336aa7839e5464397b83603cac91519"
          }
        ]
      }
    ],
