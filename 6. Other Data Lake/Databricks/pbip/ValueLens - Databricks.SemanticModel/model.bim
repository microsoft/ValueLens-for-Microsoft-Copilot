        "partitions": [
          {
            "name": "📖 Metric Glossary",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(\"Page\",STRING,\"PageDescription\",STRING,\"Metric\",STRING,\"Description\",STRING,\"PageOrder\",INTEGER,\"MetricOrder\",INTEGER,{",
                "\t\t\t\t{\"Activation\",\"Compare observed activity with reconciled license inventory; do not interpret missing inventory as zero adoption.\",\"Active users\",\"Nonblank users with prompt-flagged activity in the selected cohort and period.\",0,0},",
                "\t\t\t\t{\"Activation\",\"Compare observed activity with reconciled license inventory; do not interpret missing inventory as zero adoption.\",\"Licensed utilisation\",\"Active licensed users divided by matched licensed inventory. Unavailable when inventory is missing or does not reconcile; never a fabricated 0%.\",0,1},",
                "\t\t\t\t{\"Activation\",\"Compare observed activity with reconciled license inventory; do not interpret missing inventory as zero adoption.\",\"Inactive licensed users\",\"Matched licensed inventory less active licensed users, only when the denominator is valid.\",0,2},",
                "\t\t\t\t{\"Activation\",\"Compare observed activity with reconciled license inventory; do not interpret missing inventory as zero adoption.\",\"Cowork observed population\",\"Users observed with Cowork-tagged activity in loaded history, not a purchased or entitled Cowork-license population.\",0,3},",
                "\t\t\t\t{\"License & Cowork Readiness\",\"License demand and Cowork fit are separate observed-usage signals, not purchase recommendations.\",\"License readiness\",\"Review unlicensed usage depth and frequency before discussing a license. No universal buying threshold is asserted.\",1,100},",
                "\t\t\t\t{\"License & Cowork Readiness\",\"License demand and Cowork fit are separate observed-usage signals, not purchase recommendations.\",\"Cowork readiness\",\"Review session depth, daily app spread and agent usage separately. Current Cowork users are excluded from the fit population.\",1,101},",
                "\t\t\t\t{\"License & Cowork Readiness\",\"License demand and Cowork fit are separate observed-usage signals, not purchase recommendations.\",\"Maturity mapping\",\"Existing stage calculations remain unchanged pending confirmation of the stage mapping.\",1,102},",
                "\t\t\t\t{\"License & Cowork Readiness\",\"License demand and Cowork fit are separate observed-usage signals, not purchase recommendations.\",\"Why an organisation shows no rank\",\"Only users with no Cowork history can be ranked. Where every observed user already uses Cowork there is no one left to recommend, so the organisation carries no rank and is left out of the ranked candidate list rather than shown as a blank row.\",1,103},",
                "\t\t\t\t{\"Adoption\",\"View observed activity volume and frequency over the selected dates and cohort.\",\"Tasks and sessions\",\"Tasks count prompt-flagged activity rows; sessions group identifiable prompt activity by user, app and thread. They are different units.\",2,200},",
                "\t\t\t\t{\"Adoption\",\"View observed activity volume and frequency over the selected dates and cohort.\",\"Sessions / active user\",\"Observed sessions divided by the same prompt-active user population used for cohort task metrics.\",2,201},",
                "\t\t\t\t{\"Adoption\",\"View observed activity volume and frequency over the selected dates and cohort.\",\"Sessions / user / week\",\"Sessions per active user normalized to the selected calendar period in weeks; not a measure of completed weekly outcomes.\",2,202},",
                "\t\t\t\t{\"Adoption\",\"View observed activity volume and frequency over the selected dates and cohort.\",\"Conversation depth\",\"Sessions grouped by how many turns were observed. Depth shows the work was refined rather than taken from a first answer; it is not a quality score.\",2,203},",
                "\t\t\t\t{\"Adoption\",\"View observed activity volume and frequency over the selected dates and cohort.\",\"More than one turn\",\"Share of sessions with at least two observed turns. Single-turn sessions stay in the denominator rather than being excluded.\",2,204},",
                "\t\t\t\t{\"Adoption\",\"View observed activity volume and frequency over the selected dates and cohort.\",\"Median session span\",\"Median wall-clock time between a session's first and last timestamp. It measures how long activity was logged, not how long the work took, so no speed figure is derived from it.\",2,205},",
                "\t\t\t\t{\"Power Users\",\"Explore established usage patterns. Stage boundaries remain the inherited, unconfirmed mapping.\",\"Usage stages\",\"Existing activity-based maturity buckets; no new mapping or externally validated benchmark was introduced.\",3,300},",
                "\t\t\t\t{\"Power Users\",\"Explore established usage patterns. Stage boundaries remain the inherited, unconfirmed mapping.\",\"Usage frequency\",\"Read activity and days in the selected date context. High usage alone does not establish business impact.\",3,301},",
                "\t\t\t\t{\"Activity\",\"Explore what was observed and how it was classified, without treating inferred tasks as delivered outcomes.\",\"Task classification\",\"Task Category and Task Breakdown are inferred by the ingestion and model logic - not independent verification of completed business tasks.\",4,400},",
                "\t\t\t\t{\"Activity\",\"Explore what was observed and how it was classified, without treating inferred tasks as delivered outcomes.\",\"Task volume\",\"Prompt-flagged audit activity rows under the current filters.\",4,401},",
                "\t\t\t\t{\"Activity\",\"Explore what was observed and how it was classified, without treating inferred tasks as delivered outcomes.\",\"Session context\",\"Observed sessions are available beside task totals or in relevant chart tooltips.\",4,402},",
                "\t\t\t\t{\"Activity\",\"Explore what was observed and how it was classified, without treating inferred tasks as delivered outcomes.\",\"Which breakdown dimension is used\",\"The breakdown dimension. Task Breakdown is the classified task for Copilot and Agents, and the Cowork task for Cowork - the feed tags all Cowork 'General Chat', so grouping Cowork on the classified task drew a single 100% block. Roughly half of Cowork still reads 'General assistance / Other' because those prompts attach no typed material.\",4,403},",
                "\t\t\t\t{\"Activity\",\"Explore what was observed and how it was classified, without treating inferred tasks as delivered outcomes.\",\"How deeply AI engaged\",\"The estate's four-rung ladder - Asking, Finding, Consuming, Producing. Taken verbatim from the feed for every cohort that reports one. Cowork does not report one, so it is derived from the material each prompt touched: markdown artefact = Producing, document or mail item = Consuming, chat messages only = Finding, nothing attached = Asking.\",4,404},",
                "\t\t\t\t{\"Activity\",\"Explore what was observed and how it was classified, without treating inferred tasks as delivered outcomes.\",\"Share of activity\",\"Each engagement rung as a percentage of all prompt activity in the current selection, so the four rungs add to 100%. The denominator is every prompt in scope, not just those on the same rung - if all four bars read 100% the denominator is being filtered by the rung as well as the numerator.\",4,405},",
                "\t\t\t\t{\"License Prioritisation\",\"Use unlicensed adoption evidence to build a review shortlist, not an automatic procurement decision.\",\"Unlicensed sessions\",\"Observed sessions from activity classified as unlicensed under the current source and date filters.\",5,500},",
                "\t\t\t\t{\"License Prioritisation\",\"Use unlicensed adoption evidence to build a review shortlist, not an automatic procurement decision.\",\"Active days\",\"Distinct dates with observed qualifying activity, not elapsed calendar days.\",5,501},",
                "\t\t\t\t{\"License Prioritisation\",\"Use unlicensed adoption evidence to build a review shortlist, not an automatic procurement decision.\",\"Review priority\",\"A conversation starter based on observed usage; missing or stale identity/license data must be resolved first.\",5,502},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Consumption tasks\",\"AI tasks billed through the Cowork consumption surface in the current selection.\",6,600},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Grounding ratio\",\"How much heavier a Cowork task is than a Copilot Chat task, measured by the number of distinct resources the task touched. Above 1 means the premium tool is carrying heavier work. This is the signal that actually separates the tools in this data.\",6,601},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Over-specified tasks\",\"Cowork tasks that show neither conversation depth nor any grounding - one turn and no resource touched. This is deliberately strict. It is the only population this feed can fairly describe as work a cheaper tool could have done.\",6,602},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Why turn count is not used on its own\",\"Conversation length does not separate the tools here: 87% of Copilot Chat, 79% of agent traffic and 93% of Cowork all sit in the 7+ turn band. An earlier version flagged single-turn Cowork as substitutable, which inspected well under one percent of one percent of activity and could not support the conclusion. Turn count is now only used alongside grounding, never alone.\",6,603},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"No cost is attributed\",\"This model carries licence cost, not per-task or per-model consumption cost. No saving is estimated for any task flagged here, because the data cannot price the alternative.\",6,604},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Wrong-app tasks\",\"Tasks done in an app that does not normally carry that kind of task. Best fit is decided on volume, so a small surface such as Cowork can only ever appear as poor fit.\",6,603},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Best-fit app\",\"The app carrying 40% or more of a task's volume in your own data. Tasks with no dominant app are not judged rather than guessed.\",6,604},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Model efficiency\",\"Partly judged now. Models are graded into cost tiers from published list prices, and frontier-tier tasks are compared with workhorse tasks on grounding depth. What is still missing is a per-call cost in the source, so no saving or spend figure is attached to any model.\",6,605},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Estimated time saved\",\"Modeled activity volume multiplied by configured task/time assumptions, not directly measured time savings.\",8,700},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Estimated value / ROI\",\"Scenario estimates using configured time, labor-cost and license-cost assumptions. Results depend on coverage and valid denominators.\",8,701},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Value context: tasks and sessions\",\"Usage context for value estimates. Sessions are not multiplied into task-based value a second time.\",8,702},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Hours: one consistent basis\",\"Every hours measure reports the same quantity - the full human-equivalent time the delivered work would have taken a person. Per-week measures divide by the weeks in the selected period, not by the weeks a given category happened to appear in, so a breakdown always adds back to the page total.\",8,703},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"No discount factors\",\"Earlier versions applied a 70% realisation factor to hours and a fixed 50% reinvestment factor to capacity. Both have been removed because neither was traceable to a cited source. Hours and value now report the full estimated human-equivalent effort, and any haircut you want to apply should be an explicit, stated assumption.\",8,704},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"AI Assisted Value basis\",\"Full human-equivalent hours multiplied by the hourly value and penalty factor you set. No realisation or reinvestment haircut is applied, so the figure reflects what the delivered work would have cost at the rate supplied.\",8,705},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Effort scenario\",\"Hours are estimated from a researched band, not a single number. Conservative uses the low end of the band, Typical the midpoint and Optimistic the high end. The Effort scenario slicer on the Estimated Value page switches between them, and every hours and value measure moves with it. Typical is the default. The bands come from the Cowork time-savings methodology, whose primary source is a Microsoft Research difference-in-differences study of 72,186 users.\",8,706},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Why some activities count more than once\",\"A single prompt can appear as several rows in the audit log, one per file, page or record it touched. For activities where those rows were verified to be genuinely distinct material - web and enterprise search, file retrieval, document and data analysis, meeting prep, people lookup - effort scales with how much material was handled. For everything else, including general chat, the extra rows are grounding context rather than separate work, so effort is counted once per prompt. Scaling is calibrated to each activity's own average, so the organisation-wide total stays inside the researched band while heavier users are credited more than lighter ones.\",8,707},",
                "\t\t\t\t{\"Value\",\"Treat time and financial value as modeled scenarios based on explicit assumptions.\",\"Task Category\",\"The parent grouping in the Value Table: 12 tool-agnostic groups - Email, Data & Analysis, Document Creation, Collaboration & Workflows and so on. Each row reaches its Task Category through its Task Breakdown. Cowork is placed by the material the prompt touched - mail items to Email, spreadsheets and data files to Data & Analysis, documents and decks to Document Creation, chat messages to Collaboration & Workflows. Cowork prompts that attach no material stay in General Chat & Q&A, because that is an absence of evidence rather than a category.\",8,708},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Registry records\",\"Imported A365 registry rows after existing blank-Title-ID filtering and Title-ID deduplication, not an asserted tenant-wide total.\",9,800},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Review queue\",\"Explicit inventory review flags such as block/status, missing owner evidence or known broad sharing. A review flag is not a danger verdict.\",9,801},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Unknown evidence\",\"Insufficient available registry evidence; not zero risk or healthy.\",9,802},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Owner coverage\",\"Registry rows with creator identity or non-publisher-only owner evidence divided by registry rows in scope.\",9,803},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Audit linkage\",\"Audit sessions matched to nonblank registry Title IDs. Unmatched sessions remain in overall audit totals but are not assigned to a blank registry agent.\",9,804},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Return rate\",\"Observed agent users with at least two sessions divided by users with at least one session in the current context.\",9,805},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Last observed activity\",\"Latest qualifying audit activity, not the registry's Last updated date.\",9,806},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Registry snapshot\",\"Explicit snapshot evidence when supplied. Registry creation/update dates do not establish ingestion freshness.\",9,807},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"A365 telemetry coverage\",\"Population varies by field. Blank capability flags, sessions, exception rate or risk fields remain unavailable, not false/zero.\",9,808},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Observed in audit\",\"Distinct registry agent names with at least one audit session matched on Title ID. Distinct from A365-supplied usage telemetry, which the ingestor populates for far fewer agents; a low count is a coverage statement, not proof agents are unused.\",9,809},",
                "\t\t\t\t{\"Agent Health\",\"Separate registry review evidence from audit adoption. Missing A365 telemetry cannot establish a healthy verdict.\",\"Orgs reached\",\"Distinct organisations whose users generated a matched session for the agent in the selected dates. Observed reach through the user-to-organisation link, not licensed or intended scope. Users with no organisation record are excluded rather than counted as an unknown organisation, so reach understates where organisation data is incomplete. Blank means no matched session, not zero reach.\",9,810},",
                "\t\t\t\t{\"Feedback\",\"Interpret feedback only for the responses and source coverage represented here.\",\"Feedback coverage\",\"Reported feedback is a selected response population, not every active user or session.\",10,900},",
                "\t\t\t\t{\"Feedback\",\"Interpret feedback only for the responses and source coverage represented here.\",\"Sentiment\",\"A reported or classified feedback signal; not proof of measured productivity or financial return.\",10,901},",
                "\t\t\t\t{\"Heatmap\",\"Compare the selected metric across the existing date and organizational dimensions.\",\"Selected metric\",\"The same field parameter controls the matrix and headline, including the Sessions option.\",11,1000},",
                "\t\t\t\t{\"Heatmap\",\"Compare the selected metric across the existing date and organizational dimensions.\",\"Heatmap shading\",\"Relative intensity of the selected metric, not a universal good/bad threshold.\",11,1001},",
                "\t\t\t\t{\"Heatmap\",\"Compare the selected metric across the existing date and organizational dimensions.\",\"Kinds of work per user\",\"Average number of distinct tasks (Task Breakdown) each person uses AI for. Cowork is counted by its own Cowork tasks - the feed gives every Cowork row the same label, which pinned this at exactly 1.0 for the Cowork cohort. Copilot and Agents are unaffected.\",11,1002},",
                "\t\t\t\t{\"Leaderboard\",\"Compare absolute adoption and per-user intensity without equating volume with performance.\",\"Absolute activity\",\"Active users, prompt-row task proxy and observed sessions under the selected cohort.\",12,1100},",
                "\t\t\t\t{\"Leaderboard\",\"Compare absolute adoption and per-user intensity without equating volume with performance.\",\"Per-user intensity\",\"Sessions divided by the cohort's prompt-active users. Small populations can produce high averages.\",12,1101},",
                "\t\t\t\t{\"Leaderboard\",\"Compare absolute adoption and per-user intensity without equating volume with performance.\",\"Cohort bookmarks\",\"Overall, Licensed, Unlicensed, Agents and Cowork views; date and organization selections are retained when switching.\",12,1102},",
                "\t\t\t\t{\"Appendix: Glossary\",\"Definitions for the pages actually present in this preview. Use the page and metric filters at the right.\",\"Source scope\",\"This preview uses existing audit, organizational/license and A365 registry inputs. No ARG or Copilot Studio session/turn source was added.\",13,1200},",
                "\t\t\t\t{\"Appendix: Glossary\",\"Definitions for the pages actually present in this preview. Use the page and metric filters at the right.\",\"Blank / unavailable\",\"Insufficient qualifying data or an invalid denominator; never silently reinterpret as zero.\",13,1201},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"Signal\",\"Observed source activity with its original grain and coverage limitations.\",14,1300},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"Task Breakdown\",\"The task inferred from the signal - not independently verified task completion.\",14,1301},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"Impact\",\"A modeled interpretation based on assumptions; validate against business evidence before treating it as realized benefit.\",14,1302},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"Which task field prices the work\",\"Only Behavior_Enriched_Full - the Task Breakdown for Copilot and Agents - is joined to the Behavior Value Map and Human Time Estimates, so it alone sets the minutes behind their hours and value figures. Cowork is priced from its own Cowork task instead. Behavior_Category and Behavior_Enriched are display groupings; they slice the same rows but do not set the baseline.\",14,1303},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"Classification basis\",\"Task Breakdown is inferred largely from the host application rather than the action performed, so creation-heavy work is under-represented relative to summarising and review. Treat the task mix as indicative, not as a measured task census.\",14,1304},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"App host\",\"The Copilot host application an interaction happened in, as the audit log records it: for example Teams, Word, Outlook, Excel, PowerPoint, Copilot Studio or Cowork. It says where Copilot was used, not what the person did.\",14,1305},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"App host and Cowork\",\"An interaction whose app host contains \"\"cowork\"\" is counted as Cowork. Cowork prompts are categorised separately from Copilot and agent tasks; that method is being revised.\",14,1306},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"App host and the task category\",\"Each row is classified first by the resource it touched, such as an email, a meeting, a file or a link. When no resource matches and the enterprise search plugin wasn't used, the open file and then the app host decide the Task Breakdown and its Task Category. For example, Outlook gives Email Drafting or Email Summarising (Email), Excel gives Excel Assistance (Data & Analysis), and Copilot Studio gives Domain-Specific Agent (Specialist Support). If nothing matches, the row is General Chat (General Chat & Q&A).\",14,1307},",
                "\t\t\t\t{\"Appendix: Signal - Impact Table\",\"Trace how observed signals become inferred tasks and modeled value.\",\"App host caveat\",\"Because the app host fills in whenever the resource doesn't say, Task Breakdown is inferred largely from the host application rather than the action performed. Creation-heavy work is under-represented relative to summarising and review, so treat the task mix as indicative, not as a measured task census.\",14,1308},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Work weight\",\"A four-band grade per session - Strong fit, Fair fit, Worth a look, Unclassified - ported from the published Cowork classification methodology's Layer 1 rules. Strong fit: spans two or more apps, builds a file, or uses three or more pieces of material across two or more types (or more than five pieces). Fair fit: some breadth or depth of material and, at Balanced grading, messages read or one app's material. Worth a look: at Balanced grading, chat where nothing was read or attached. Unclassified means the attached material names no application, so it cannot be graded either way - it is an abstention, not a low score. Fit grading in Assumptions sets how strict this is.\",6,606},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"What counts as material\",\"Only typed, non-conversational references count. Chat messages and references the feed left untyped are excluded, because counting them treats talking about work as doing it. In Cowork only 43.5% of the recorded references survive that test. The feed also records a resource type, not an identifier, so five pieces may be five files or one file touched five times - read the grade as work weight, not as a verified count of distinct sources.\",6,607},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Why work weight is a floor, not a verdict\",\"The published method also grades cross-app work, code, automation and multi-format outputs as Strong fit, and an audit log sees none of them - only 0.23% of threads here touch more than one app, and just 188 rows record a write. The published method's Layer 2 LLM review is absent too. Every one of those gaps can only push a prompt up a band, never down, so the Strong fit share shown is the lowest defensible figure rather than the true one.\",6,608},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Counted per prompt, not per audit row\",\"A prompt emits one audit row for every reference it attaches, so counting rows lets a heavy prompt vote once per attachment. This page counts distinct prompts instead. The difference is not cosmetic - in Cowork it is 5.4x, and it moved the top-grade share from 75.2% to 21.4% before the material test was applied at all. Pages outside Usage Efficiency and Model Mix still count rows, so task counts there will read higher.\",6,609},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Producing a file is not a strong signal\",\"In-app Copilots save documents too, so an ordinary file never grades a session Strong fit on its own; it counts only alongside grounding or synthesis evidence. The exception is built or packaged output - an archive, web page, script or structured data file - which no in-app Copilot produces.\",6,610},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Model cost tier\",\"Models grouped into Frontier, Workhorse and Not attributed using published per-million-token list prices. Frontier covers GPT-6 Astra, GPT-5.6 Sol, Claude Opus 5 and Opus 5.5. A model name the rule does not recognise is left Unclassified rather than guessed into a band.\",7,700},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Attribution coverage\",\"Share of AI tasks that carry a model name at all. Every frontier figure on this page is stated against that attributed base, never against total tasks, because unattributed rows cannot be assumed to belong to either tier.\",7,701},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Frontier share\",\"Frontier-tier tasks divided by tasks with a model logged. Read it with attribution coverage beside it; a low share means little when coverage is partial.\",7,702},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Depth signal\",\"Mean resource references attached per task, compared between tiers. It is the only evidence here that separates heavy work from casual work. It is not a measure of answer quality, it is not a count of verified distinct sources, and it is not a cost.\",7,703},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"No per-model cost\",\"The audit feed carries no token counts and no per-call price, so no currency figure is shown against any model or tier. Tier is a relative statement about published list price only.\",7,704},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Light work, decomposed\",\"The first chart breaks the graded whole into its three bands, so the parts always add back to the total at the left. All graded is every Cowork prompt the rule could grade; Strong fit, Fair fit and Worth a look are mutually exclusive slices of it. Unclassified prompts sit outside the bands and outside the share column, which is why the three bands sum to 100% of graded work rather than to 100% of prompts.\",6,611},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Habitual light use\",\"Counts people, not prompts. A person is habitual if at least 80% of their own graded Cowork prompts graded Worth a look, measured only across people with at least five graded prompts. Volume alone cannot show this - a single enthusiast can produce thousands of light prompts - so each person is banded by their own share instead. Below five graded prompts a share is noise, so those people are excluded from both the numerator and the denominator rather than counted as well-targeted.\",6,612},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Why the fit test is scoped to Cowork\",\"Light work is only a cost signal on a surface that is paid for separately. On an included Copilot Chat seat a short, ungrounded prompt costs nothing extra and is entirely expected. The same grade therefore means different things on different surfaces, which is why it is applied to Cowork here and to premium models on Model Mix, and why any estate-wide figure is shown as context rather than as a target.\",6,613},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Which tool carries the heavier work\",\"Read from the grounding ratio - material attached per Cowork prompt divided by material attached per in-app Copilot Chat prompt. Above 1.0 the paid surface is carrying the heavier work; below 1.0 it is carrying the lighter work. The page states whichever direction the data shows rather than assuming the paid surface is the heavier one, because in this tenant it is not.\",6,614},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Simple asks\",\"A prompt that carried little material - few or no files, links or pasted text - and few turns. It describes the shape of the request, not its worth: a simple ask can still be valuable work. Replaces the older internal term \"\"light work\"\".\",6,615},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Prompts we could assess\",\"Prompts with enough recorded detail to judge fit. Prompts whose attachments carry no recorded type are left out rather than assumed simple, so every share on this page is a floor, not a verdict. Replaces the older internal term \"\"graded on work weight\"\".\",6,616},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Task Breakdown (Cowork)\",\"Each Cowork prompt is mapped to a Cowork task (Cowork Methodology v4) - Analysis & Research, Document & content creation, Email, Communication and so on - read from the material it attached. The source feed tags every Cowork prompt General Chat, a bucket defined as no signals matched, so this is derived here instead.\",6,617},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Why Cowork is categorised here and not upstream\",\"49% of Cowork prompts attach a typed resource such as a spreadsheet, deck or PDF, yet all of them arrive tagged General Chat. Left uncorrected the whole surface is valued at the General assistance band, the lowest in the methodology. Three v4 categories - Meetings, Specialized workflows and Code - are not observable in an audit log and are never assigned.\",6,618},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Sessions we could assess\",\"Cowork sessions carrying enough attached material to grade. Fit is judged per session, not per prompt: a person picks a surface once for a piece of work, and the files are attached at the start, so grading each follow-up turn alone convicted the whole session as light work.\",6,619},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Why sessions and not prompts\",\"Grading each prompt alone put 74.5% of assessed work in the lowest grade, 58% of which had attached nothing at all - they were follow-up turns in a session whose material arrived earlier. Same thresholds, moved to session grain.\",6,620},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Expert equivalent hours (Cowork)\",\"Cowork human-equivalent hours priced from the Cowork task its attached material shows, at that task's researched per-turn rate from Human Time Estimates. Replaces the General Chat fallback rate (8 min/turn) the feed forces on every Cowork prompt.\",6,621},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Could have used\",\"The cheaper surface for work graded Worth a look, with evidence: how many comparable Copilot Chat prompts the estate already runs on the same task. Blank on Strong and Fair fit, and blank when no comparable Copilot volume exists, so the table never invents an alternative.\",6,622},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Source items and Source types\",\"The only two inputs to the fit grade, shown so the grade can be checked rather than trusted. Source items is the average pieces of material a session worked across - files, links and pasted text, not just file attachments - so it measures depth. Source types is how many different types those were, so it measures breadth. Fit rises with both: Strong fit needs 3+ items across 2+ types, or more than 5 items on depth alone (or work that spans apps or builds a file). Worth a look carries none - and, at Balanced grading, no messages read either. Expert Equivalent Hours was removed from these tables: it is an outcome of the work, not evidence of how it graded.\",6,623},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Why tiers are not compared\",\"Premium-tier work in this estate is 100% Cowork and mid-cost work is 100% other tools, so cost tier and tool are the same split. A premium-versus-mid comparison would mostly compare Cowork with Copilot, not one model with another. Model fit is therefore judged inside Cowork only, where the model choice is actually made.\",7,705},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Lighter model may do\",\"Sessions on a Frontier (premium cost) model whose work graded Worth a look. A prompt to test a lighter model, not proof one would have answered as well. Formerly Try cheaper (over-specified).\",7,706},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Good match\",\"Judged sessions whose model cost tier suits the fit grade of the work: a Frontier (premium cost) model on Strong or Fair fit work, or a mid-cost model on Fair fit or Worth a look work. Premium capacity going where the evidence supports it.\",7,707},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Could have used (model)\",\"The mid-cost model this estate already runs for the same kind of Cowork task, with the volume that proves it. Mid-cost models carry only 254 Cowork prompts in total, so read this as 'a cheaper model has handled this work', not as a benchmark. Blank on well-matched rows and blank where no mid-cost volume exists.\",7,708},",
                "\t\t\t\t{\"Model Mix\",\"Show whether premium model capacity is going to heavy work or to trivia. Tiers come from published list prices; this feed carries no per-call cost.\",\"Headline verdict and depth signal (retired)\",\"Both compared premium against mid-cost tiers, which in this estate is a Cowork-versus-Copilot comparison wearing a model label. The two visuals were removed rather than left to read as a model finding. The measures remain in the model, unused by any page.\",7,709},",
                "\t\t\t\t{\"Power Users\",\"Explore established usage patterns. Stage boundaries remain the inherited, unconfirmed mapping.\",\"Usage stages under Cowork\",\"Inactive reads N/A when the cohort is Cowork. Inactive means holds a seat but did not use it, and only Copilot has a seat inventory in this model - the Cowork cohort filters the audit feed, not the licence list, so the figure would subtract 183 Cowork-active users from 11,442 Copilot seats and report 11,316 against an observed Cowork population of 186. With Inactive blank the stage base falls back to users active last month, so Beginner and Developing are shares of the people actually observed on Cowork.\",3,302},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Decided by\",\"The test inside the fit grade that decided most sessions in the row, with the share it covers. Reads the rule that fired - spans apps, built an artifact, multi-source synthesis, mixed sources, messages read, one app or chat only. It is counted from the graded sessions, not inferred, and it is why the same task can be Strong fit in one row and Worth a look in another - the difference is always the material the session worked across.\",6,624},",
                "\t\t\t\t{\"Usage Efficiency\",\"Separate two efficiency questions - was the work billed to the right tool, and was the model heavier than the task needed.\",\"Fit grading setting\",\"How strict the Cowork Fit and Model Fit grade is, set by the Fit Grading column in Assumptions. Balanced (default): messages read and one-app work count as Fair fit, so Worth a look is kept for chat where nothing was read or attached. Lenient: a longer chat with nothing attached is Fair too. Strict: the original rule - chat only or one app is Worth a look. The grade sees which apps, files and messages a session touched, not prompt text or answer quality, so a flag is a coaching prompt, not a verdict on Cowork's value.\",6,625}",
                "\t\t\t\t})"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Page Description (Selected)",
            "expression": "SELECTEDVALUE('📖 Metric Glossary'[PageDescription], \"Definitions for the current preview. Select a page at the right, or browse all metrics below.\")",
            "lineageTag": "290ae66c-5cf7-406d-ae1b-41fbe8393a8a"
          }
        ]
      },
      {
        "name": "Behavior Value Map",
        "lineageTag": "ff050001-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "Signal",
            "dataType": "string",
            "sourceColumn": "Signal",
            "lineageTag": "ff050001-0001-0001-0001-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Behavior",
            "dataType": "string",
            "description": "Task Breakdown.",
            "sourceColumn": "Behavior",
            "lineageTag": "ff050001-0001-0001-0001-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Use Case",
            "dataType": "string",
            "sourceColumn": "Use Case",
            "lineageTag": "ff050001-0001-0001-0001-000000000004",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Description",
            "dataType": "string",
            "description": "Plain-English summary of the task.",
            "sourceColumn": "Description",
            "lineageTag": "ff050001-0001-0001-0001-000000000006",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Value Outcome",
            "dataType": "string",
            "sourceColumn": "Value Outcome",
            "lineageTag": "ff050001-0001-0001-0001-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Behavior Value Map",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(",
                "        {\"Signal\", \"Behavior\", \"Use Case\", \"Value Outcome\", \"Description\"},",
                "        {",
                "            // ─── COMMUNICATION (Email + Teams) ───",
                "            {\"Outlook/OutlookSidepane + Send/Draft + EmailMessage\", \"Email Drafting\", \"Composing replies, cold outreach, formal correspondence\", \"Time Saved (Email)\", \"Writing or replying to an email in Outlook.\"},",
                "            {\"Outlook/OutlookSidepane + EmailMessage + Read\", \"Email Summarising\", \"Triaging inbox, summarising threads, catching up after leave\", \"Time Saved (Email)\", \"Reading emails in Outlook to summarise or sort them.\"},",
                "            {\"TeamsMessage/TeamsChat/TeamsChannel + Post/CreateChat\", \"Teams Messaging\", \"Team coordination, quick decisions, status updates\", \"Communication Time Saved\", \"Writing or posting a message in a Teams chat or channel.\"},",
                "",
                "            // ─── MEETINGS ───",
                "            {\"Event/TeamsMeeting + Read\", \"Meeting Prep\", \"Reviewing agendas, catching up on missed meetings, recap summaries\", \"Time Saved (Meetings)\", \"Reading a meeting invite or calendar event to prepare or catch up.\"},",
                "            {\"Action = mcp_MeetingManagement\", \"Meeting Scheduling\", \"Calendar management, finding availability, booking rooms\", \"Communication Time Saved\", \"Booking meetings, finding free time or managing a calendar.\"},",
                "",
                "            // ─── CONTENT CREATION ───",
                "            {\"Word AppHost + Post/Write/Create\", \"Document Drafting\", \"Reports, proposals, briefs, documentation\", \"Content Output\", \"Writing or editing a document in Word.\"},",
                "            {\"Word AppHost + docx/doc/rtf + Read\", \"Document Summarising\", \"Executive summaries, long doc digests, research synthesis\", \"Time Saved (Documents)\", \"Reading a Word document to summarise it or answer questions about it.\"},",
                "            {\"PowerPoint AppHost + Post/Write/Create\", \"Presentation Creation\", \"Slide decks, pitch materials, training content\", \"Content Output\", \"Building or editing slides in PowerPoint.\"},",
                "            {\"PowerPoint AppHost + pptx/ppt/potx + Read\", \"Presentation Summarising\", \"Deck reviews, extracting key points\", \"Time Saved (Documents)\", \"Reading a PowerPoint deck to summarise it or pull out key points.\"},",
                "            {\"Designer AppHost OR png/jpg/svg + Active\", \"Image Generation\", \"Marketing visuals, presentations, social content\", \"Content Output\", \"Creating or editing an image, for example in Designer.\"},",
                "            {\"png/jpg/gif + Read\", \"Image / Media Analysis\", \"Accessibility descriptions, content cataloguing, image review\", \"Content Output\", \"Looking at an image to describe or review it.\"},",
                "            {\"Stream AppHost + mp4/mov/StreamVideo\", \"Video Summarising\", \"Meeting recordings, training videos, podcast recaps\", \"Time Saved (Meetings)\", \"Summarising or asking about a video or meeting recording.\"},",
                "",
                "            // ─── KNOWLEDGE & SEARCH ───",
                "            {\"WebSearchQuery resource type\", \"Web Searching\", \"Market research, fact-checking, competitive analysis\", \"Search Time Saved\", \"Searching the public web to answer a question.\"},",
                "            {\"EnterpriseSearch plugin + aspx/ListItem\", \"Enterprise Searching\", \"Finding internal docs, policy lookup, knowledge retrieval\", \"Search Time Saved\", \"Searching your organisation's own pages, lists and sites.\"},",
                "            {\"PDF resource + Read\", \"PDF Analysis\", \"Contract review, report analysis, compliance checking\", \"Search Time Saved\", \"Reading a PDF to summarise it or answer questions about it.\"},",
                "            {\"SharePoint AppHost\", \"SharePoint Access\", \"Site browsing, file discovery, team content\", \"Search Time Saved\", \"Finding or browsing team content in SharePoint.\"},",
                "            {\"docx/pptx + Read (outside native app)\", \"File Retrieval\", \"Cross-referencing documents, gathering context in M365 Chat\", \"Search Time Saved\", \"Pulling a Word or PowerPoint file into a chat for context.\"},",
                "            {\"PeopleInferenceAnswer resource\", \"People Lookup\", \"Org navigation, finding experts, team-building\", \"Search Time Saved\", \"Finding colleagues, experts or who works with whom.\"},",
                "",
                "            // ─── DATA & ANALYSIS ───",
                "            {\"Excel AppHost + ExecuteDatasetQuery/GetItems/GetAllTables\", \"Data Querying\", \"Building reports, answering data questions, KPI tracking\", \"Data-Driven Decisions\", \"Querying a dataset, list or table to answer a data question.\"},",
                "            {\"Excel AppHost + Active actions\", \"Excel Assistance\", \"Formulas, formatting, ad-hoc analysis inside Excel\", \"Spreadsheet Time Saved\", \"Getting help with formulas, formatting or analysis in Excel.\"},",
                "            {\"xlsx/csv/xlsm + Read\", \"Spreadsheet Review\", \"Reviewing spreadsheets, validating numbers, light analysis\", \"Spreadsheet Time Saved\", \"Reading a spreadsheet or CSV file to check or explain the numbers.\"},",
                "",
                "            // ─── TECHNICAL ───",
                "            {\"py/js/java/tsx/jsx/css/php/sh + Active\", \"Code Writing\", \"Feature development, scripting, automation\", \"Coding Capability\", \"Writing or changing code or scripts.\"},",
                "            {\"py/sql/json/xml/yaml/yml + Read OR coding URLs (github, stackoverflow, etc.)\", \"Code Analysis\", \"Code review, debugging, understanding codebases\", \"Coding Capability\", \"Reading code or developer websites to explain, review or debug code.\"},",
                "            {\"Flow/Connector/http + Invoke\", \"Running a Workflow\", \"Automating approvals, notifications, data flows, Power Automate triggers\", \"Workflow Triggered\", \"Starting an automated flow or connector.\"},",
                "            {\"Workflow + LOB system\", \"Specialist / Line-of-Business Workflow\", \"Automating line-of-business systems (ServiceNow, Salesforce, Dynamics, Workday)\", \"Workflow Triggered\", \"Running an automated flow in a business system such as ServiceNow, Salesforce, Dynamics or Workday.\"},",
                "            {\"Workflow + email\", \"Email Workflow\", \"Automating email triage, routing, and response\", \"Workflow Triggered\", \"Running an automated flow that sorts, routes or answers email.\"},",
                "            {\"Workflow + calendar\", \"Meeting Workflow\", \"Automating scheduling, calendar, and meeting logistics\", \"Workflow Triggered\", \"Running an automated flow that handles scheduling or meeting logistics.\"},",
                "            {\"Workflow + data/report\", \"Data & Reporting Workflow\", \"Automating report generation, data refresh, and analytics delivery\", \"Workflow Triggered\", \"Running an automated flow that refreshes data or produces a report.\"},",
                "            {\"Workflow + document\", \"Document Workflow\", \"Automating document creation, filing, and collaboration\", \"Workflow Triggered\", \"Running an automated flow that creates, files or shares documents.\"},",
                "            {\"Workflow + task/approval\", \"Coordination Workflow\", \"Automating tasks, approvals, and team notifications\", \"Workflow Triggered\", \"Running an automated flow that handles tasks, approvals or team notifications.\"},",
                "            {\"Workflow + general\", \"General Workflow\", \"Automating multi-step business processes\", \"Workflow Triggered\", \"Running an automated multi-step flow that fits no narrower group.\"},",
                "",
                "            // ─── COLLABORATION & PRODUCTIVITY ───",
                "            {\"OneNote AppHost\", \"Note Taking\", \"Meeting notes, personal knowledge management\", \"Time Saved (Documents)\", \"Capturing or organising notes in OneNote.\"},",
                "            {\"Forms AppHost\", \"Form / Survey Work\", \"Feedback collection, quizzes, data gathering\", \"Team Collaboration\", \"Building a form, quiz or survey in Forms, or reviewing its answers.\"},",
                "            {\"Planner AppHost + PlanId/TaskIds\", \"Task Management\", \"Sprint planning, task tracking, project coordination\", \"Task Coordination\", \"Creating, tracking or updating tasks in Planner.\"},",
                "            {\"Loop/Whiteboard/VivaEngage AppHost\", \"Real-time Collaboration\", \"Brainstorming, shared editing, team ideation\", \"Team Collaboration\", \"Working on something together in Loop, Whiteboard or Viva Engage.\"},",
                "",
                "            // ─── AGENT CLASSIFICATIONS (Behavior_Enriched + _Full) ───",
                "            {\"Agent name: coach/mentor/learning/career OR learning URLs\", \"Coaching\", \"Writing coaching, prompt improvement, career guidance, training\", \"Skills Development\", \"Using a coaching or learning agent to build skills or improve work.\"},",
                "            {\"Agent name: research/analyst/analy/insight/intelligence\", \"Research & Analysis\", \"Market research, competitive analysis, data interpretation, trend spotting\", \"Data-Driven Decisions\", \"Using a research or analyst agent to gather and make sense of information.\"},",
                "            {\"Agent name: sales/commercial/customer/crm/revenue OR dynamics.com URLs\", \"Sales & Customer\", \"Sales intelligence, customer insights, deal support, CRM assistance\", \"Revenue Enablement\", \"Using a sales or customer agent for accounts, deals or customer insight.\"},",
                "            {\"Agent name: hr/recruit/talent/onboard/people OR description matches\", \"HR & People\", \"Job descriptions, candidate screening, onboarding guidance, policy Q&A\", \"HR Process Automation\", \"Using an HR agent for hiring, onboarding or people questions.\"},",
                "            {\"Agent name: policy/compliance/legal/audit/risk\", \"Compliance & Policy\", \"Policy lookup, compliance checking, risk assessment, audit support\", \"Compliance & Risk\", \"Using a policy, legal or risk agent to check rules and compliance.\"},",
                "            {\"Agent name: service/support/help/ticket/incident OR servicenow.com URLs\", \"IT & Service Desk\", \"IT troubleshooting, ticket creation, knowledge base queries\", \"Service Desk Deflection\", \"Using an IT or service desk agent to fix a problem or raise a ticket.\"},",
                "            {\"Agent name: summar/draft/translat/editor\", \"Content Generation\", \"Drafting communications, summarising documents, translation\", \"Content Output\", \"Using a writing agent to draft, summarise or translate content.\"},",
                "            {\"Agent name: data/report/dashboard/metric OR has code interpreter\", \"Data & Reporting\", \"Building reports, querying data, KPI tracking, dashboard creation\", \"Data-Driven Decisions\", \"Using a data or reporting agent to query data or build a report.\"},",
                "            {\"Agent name: knowledge/faq/wiki/buddy/guide OR has SharePoint access\", \"Knowledge Base\", \"Policy lookup, process guidance, FAQ resolution, documentation search\", \"Search Time Saved\", \"Using a knowledge agent to answer questions from your organisation's guidance and documents.\"},",
                "            {\"Agent name: idea/brainstorm/creative/design OR has image generation\", \"Ideation & Creative\", \"Brainstorming, design concepts, creative briefs, innovation workshops\", \"Content Output\", \"Using a creative agent to brainstorm ideas or design concepts.\"},",
                "            {\"Agent — no keyword/capability match\", \"General Assistance\", \"Unclassified agent interactions — review agent metadata for better categorisation\", \"General AI Productivity\", \"Using an agent whose name and tools don't show what kind of work it did.\"},",
                "",
                "            // ─── OTHER ───",
                "            {\"AppHost = Copilot Studio\", \"Domain-Specific Agent\", \"Specialist agent built in Copilot Studio for one function\", \"Specialist Expertise\", \"Using a specialist agent built in Copilot Studio.\"},",
                "            {\"No specific resource/plugin/action signals matched\", \"General Chat\", \"General Q&A or conversational usage without document grounding\", \"General AI Productivity\", \"Asking a question or chatting with AI, without a file, app or tool.\"}",
                "        }",
                "    ),",
                "    #\"Changed Type\" = let __vlTypes = {",
                "        {\"Signal\", type text},",
                "        {\"Behavior\", type text},",
                "        {\"Use Case\", type text},",
                "        {\"Value Outcome\", type text},",
                "        {\"Description\", type text}",
                "    }, __vlPresent = Table.ColumnNames(Source), __vlSafe = List.Select(__vlTypes, each List.Contains(__vlPresent, _{0})) in Table.TransformColumnTypes(Source, __vlSafe)",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
