    "expressions": [
      {
        "name": "Databricks Server Hostname",
        "description": "Required. The SQL warehouse Server Hostname, for example adb-1234567890123456.7.azuredatabricks.net. Copy it from SQL Warehouses -> your warehouse -> Connection details.",
        "kind": "m",
        "expression": "null meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-db01-4001-8001-000000000001",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Databricks HTTP Path",
        "description": "Required. The SQL warehouse HTTP Path, for example /sql/1.0/warehouses/1234567890abcdef. Copy it from SQL Warehouses -> your warehouse -> Connection details.",
        "kind": "m",
        "expression": "null meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-db01-4001-8001-000000000002",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Databricks Catalog",
        "description": "Required. The Unity Catalog catalog the ValueLens notebooks write to (notebook widget catalog).",
        "kind": "m",
        "expression": "\"main\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-db01-4001-8001-000000000003",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Databricks Schema",
        "description": "Required. The Unity Catalog schema the ValueLens notebooks write to (notebook widget schema).",
        "kind": "m",
        "expression": "\"dbo\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-db01-4001-8001-000000000004",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "FabricTable",
        "description": [
          "Helper: read a Delta table from the Fabric Lakehouse SQL endpoint by name (dbo schema).",
          "Every CT/audit/licensed/org table sources through this so only the two parameters above need setting."
        ],
        "kind": "m",
        "expression": [
          "let",
          "    // One SQL warehouse connection; catalog, schema and table names are navigation only.",
          "    // Azure Databricks connector. For a non-Azure workspace, use DatabricksMultiCloud.Catalogs.",
          "    Catalogs = Databricks.Catalogs(#\"Databricks Server Hostname\", #\"Databricks HTTP Path\",",
          "        [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),",
          "    // Unity Catalog names are lowercase; match by name because connector versions label",
          "    // the catalog and schema levels with different Kind values.",
          "    Pick = (navigation as table, name as text, label as text, scope as text) as table =>",
          "        let",
          "            Matches = Table.SelectRows(navigation, each Text.Lower([Name]) = Text.Lower(name)),",
          "            Count = Table.RowCount(Matches)",
          "        in",
          "            if Count = 1 then Matches{0}[Data]",
          "            else if Count = 0 then error Error.Record(\"Databricks.NotFound\",",
          "                label & \" '\" & name & \"' was not found in \" & scope",
          "                    & \". Check the Databricks parameters and that the signed-in identity can read it.\", name)",
          "            else error Error.Record(\"Databricks.Ambiguous\",",
          "                label & \" '\" & name & \"' matches more than one object in \" & scope & \".\", name),",
          "    Schema = Pick(",
          "        Pick(Catalogs, #\"Databricks Catalog\", \"Catalog\", \"this SQL warehouse\"),",
          "        #\"Databricks Schema\", \"Schema\", \"catalog '\" & #\"Databricks Catalog\" & \"'\"),",
          "    ReadTable = (tableName as text) as table =>",
          "        Pick(Schema, tableName, \"Table\",",
          "            \"'\" & #\"Databricks Catalog\" & \".\" & #\"Databricks Schema\"",
          "                & \"'. If a notebook has not written it yet, run that notebook first\")",
          "in",
          "    ReadTable",
          ""
        ],
        "lineageTag": "1a2b3c4d-fab1-4003-8003-000000000003",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "EmptyTable",
        "description": [
          "Helper: build an empty table with the given column names. Graceful fallback for OPTIONAL",
          "sources so a missing Lakehouse table never breaks the dashboard refresh."
        ],
        "kind": "m",
        "expression": "(columns as list) as table => #table(columns, {})",
        "lineageTag": "1a2b3c4d-fab1-4004-8004-000000000004",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Enable_ProductFeedback",
        "description": "Optional. Include = load the Copilot product feedback table. Exclude = the Feedback page loads empty. Leave on Include unless you have not set up feedback collection.",
        "kind": "m",
        "expression": "\"Include\" meta [IsParameterQuery=true, List={\"Include\", \"Exclude\"}, DefaultValue=\"Include\", Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-fab1-4006-8006-000000000006",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Enable_Agent365",
        "description": "Optional. Include = load the Agents 365 inventory. Exclude = agent pages load empty. Leave on Include unless you have not onboarded Agents 365.",
        "kind": "m",
        "expression": "\"Include\" meta [IsParameterQuery=true, List={\"Include\", \"Exclude\"}, DefaultValue=\"Include\", Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-fab1-4007-8007-000000000007",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
