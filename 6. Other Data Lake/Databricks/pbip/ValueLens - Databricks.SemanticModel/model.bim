      {
        "name": "Stage Legend",
        "description": [
          "Disconnected stage picker for the Habit Formation / Power Users pages. One row per",
          "maturity band, including Inactive. Has NO relationships - the [Stage Users] and",
          "[Stage Users, Last Month] switching measures read the selected row via SELECTEDVALUE.",
          "",
          "29 Jul 2026 - extended to 5 rows (added 0 - Inactive) so the same legend drives the",
          "full Inactive -> Power ladder on the Power Users page."
        ],
        "lineageTag": "20ca3be6-eb77-4eb4-9590-83990e2bb3ee",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Stage",
            "isNameInferred": true,
            "description": "Maturity band label. Sorted by [Sort Order] so visuals render Beginner -> Power.",
            "sourceColumn": "[Stage]",
            "sortByColumn": "Sort Order",
            "lineageTag": "42fa0878-b5d5-4c3d-8b77-8e6ef2dbd4a0",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Sort Order",
            "isNameInferred": true,
            "isHidden": true,
            "sourceColumn": "[Sort Order]",
            "lineageTag": "e8e54239-c043-4430-911e-5f6e84751147",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Stage Legend",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "SELECTCOLUMNS(",
                "    {",
                "        (\"0 - Inactive\",   0),",
                "        (\"1 - Beginner\",   1),",
                "        (\"2 - Developing\", 2),",
                "        (\"3 - Habitual\",   3),",
                "        (\"4 - Power\",      4)",
                "    },",
                "    \"Stage\", [Value1],",
                "    \"Sort Order\", [Value2]",
                ")"
              ]
            }
          }
        ]
      },
