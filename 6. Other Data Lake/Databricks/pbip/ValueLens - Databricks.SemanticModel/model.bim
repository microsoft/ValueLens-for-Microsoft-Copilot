            ]
          },
          {
            "type": "calculated",
            "name": "Agent Lifecycle",
            "dataType": "string",
            "description": "Lifecycle position of every catalogue row. Priority order, first match wins. Separates the tenant's own agent estate from the Microsoft/ISV catalogue listings that dominate the A365 feed.",
            "expression": [
              "VAR _Blocked  = LOWER(TRIM(COALESCE('Agents 365'[Is Blocked],\"\"))) IN {\"true\",\"yes\",\"1\"}",
              "VAR _InUse    = COALESCE('Agents 365'[Total Users],0) > 0",
              "VAR _Acquired = NOT ISBLANK('Agents 365'[Status])",
              "    && LOWER(TRIM(COALESCE('Agents 365'[Status],\"\"))) <> \"acquiredfornone\"",
              "VAR _Tenant   = NOT(LOWER(TRIM(COALESCE('Agents 365'[Created in],\"\"))) IN {\"\",\"not available\"})",
              "VAR _Owned    = LOWER(TRIM(COALESCE('Agents 365'[Agent creator source],\"\"))) = \"ownerid\"",
              "RETURN SWITCH(TRUE(),",
              "    _Blocked,               \"Blocked by admin\",",
              "    _InUse,                 \"In use\",",
              "    _Acquired,              \"Deployed, not yet used\",",
              "    _Tenant && NOT _Owned,  \"Tenant-built, no owner\",",
              "    _Tenant,                \"Tenant-built, not deployed\",",
              "                            \"Catalogue listing\")"
            ],
            "sortByColumn": "Agent Lifecycle Order",
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "3a1c7e90-1b44-4d62-9c11-7e5a0d2f6b81",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Agent Usage Review",
            "dataType": "string",
            "description": "Adoption verdict for agents with observed audit sessions only. Recency is measured against the last date in the audit window, never against today, so a historic extract is not mislabelled dormant. Agents with no matched sessions return \"Not observed in audit window\" - absence of telemetry is never treated as evidence of disuse.",
            "expression": [
              "VAR _Name     = 'Agents 365'[Agent name]",
              "VAR _Users    = COALESCE('Agents 365'[Total Users],0)",
              "VAR _LastSeen = CALCULATE(MAX('Chat + Agent Interactions (Audit Logs)'[CreationDate]),",
              "                    'Chat + Agent Interactions (Audit Logs)'[AgentName] = _Name)",
              "VAR _AuditMax = CALCULATE(MAX('Chat + Agent Interactions (Audit Logs)'[CreationDate]),",
              "                    ALL('Chat + Agent Interactions (Audit Logs)'))",
              "VAR _Idle     = IF(NOT ISBLANK(_LastSeen) && NOT ISBLANK(_AuditMax),",
              "                    DATEDIFF(_LastSeen, _AuditMax, DAY))",
              "RETURN SWITCH(TRUE(),",
              "    _Users = 0 || ISBLANK(_LastSeen), \"No usage recorded\",",
              "    _Idle > 90,   \"Dormant (90+ days)\",",
              "    _Idle > 30,   \"Cooling (30+ days)\",",
              "    _Users >= 50, \"High impact\",",
              "    _Users >= 15, \"Established\",",
              "    _Users >= 5,  \"Growing\",",
              "                  \"Pilot\")"
            ],
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "5d2b8f14-6c07-4ab3-83d9-1f4e7c905ae2",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Agent Lifecycle Order",
            "dataType": "int64",
            "description": "Sort key for Agent Lifecycle so the band labels read cleanly without numeric prefixes.",
            "expression": [
              "VAR _Blocked  = LOWER(TRIM(COALESCE('Agents 365'[Is Blocked],\"\"))) IN {\"true\",\"yes\",\"1\"}",
              "VAR _InUse    = COALESCE('Agents 365'[Total Users],0) > 0",
              "VAR _Acquired = NOT ISBLANK('Agents 365'[Status])",
              "    && LOWER(TRIM(COALESCE('Agents 365'[Status],\"\"))) <> \"acquiredfornone\"",
              "VAR _Tenant   = NOT(LOWER(TRIM(COALESCE('Agents 365'[Created in],\"\"))) IN {\"\",\"not available\"})",
              "VAR _Owned    = LOWER(TRIM(COALESCE('Agents 365'[Agent creator source],\"\"))) = \"ownerid\"",
              "RETURN SWITCH(TRUE(),",
              "    _Blocked,               1,",
              "    _InUse,                 2,",
              "    _Acquired,              3,",
              "    _Tenant && NOT _Owned,  4,",
              "    _Tenant,                5,",
              "                            6)"
            ],
            "formatString": "0",
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "9f14c6d3-7b82-4e05-a3c7-51d90e28b6a7",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Agent Type Label",
            "dataType": "string",
            "description": [
              "Readable agent type. Translates the raw Agent 365 API values (firstParty, thirdParty, lob, shared)",
              "into plain English, and splits maker-built agents by the tool they were created in.",
              "lob and shared are both tenant-internal; the difference is distribution, not who built it -",
              "lob is published to the organisation, shared is passed on by the maker."
            ],
            "expression": [
              "VAR _T = LOWER(TRIM(COALESCE('Agents 365'[Agent type (A365)], \"\")))",
              "VAR _C = LOWER(TRIM(COALESCE('Agents 365'[Created in], \"\")))",
              "RETURN SWITCH(TRUE(),",
              "    _T = \"firstparty\", \"Microsoft\",",
              "    _T = \"thirdparty\", \"Marketplace\",",
              "    _T = \"lob\", \"Line of business\",",
              "    _T = \"shared\" && CONTAINSSTRING(_C, \"agent builder\"), \"Maker: Agent Builder\",",
              "    _T = \"shared\" && CONTAINSSTRING(_C, \"copilot studio\"), \"Maker: Copilot Studio\",",
              "    _T = \"shared\" && CONTAINSSTRING(_C, \"sharepoint\"), \"Maker: SharePoint\",",
              "    _T = \"shared\" && CONTAINSSTRING(_C, \"foundry\"), \"Maker: Foundry\",",
              "    _T = \"shared\", \"Maker-built\",",
              "    _T = \"\", \"Not stated\",",
              "    'Agents 365'[Agent type (A365)])"
            ],
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "6a2d8f57-4c31-49be-b0d8-3e7f15a9c204",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Sharing Scope",
            "dataType": "string",
            "sourceColumn": "Sharing Scope",
            "description": "How widely the agent is available: Whole organisation, Specific people or groups, Not shared or Not stated. From the registry's availableTo and deployedTo, and its share lists.",
            "lineageTag": "be97c2a4-796a-55a6-8cbe-37e2b7f269a8",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Shared With Count",
            "dataType": "int64",
            "sourceColumn": "Shared With Count",
            "description": "Distinct people and groups the agent is shared with, from the registry's share lists. The lists themselves are not loaded.",
            "lineageTag": "76ada807-e369-5f2e-97f1-d611b37984c7",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Owner account",
            "dataType": "string",
            "sourceColumn": "Owner account",
            "description": "Whether the agent's owner can still look after it: Active, Disabled or Not found. Blank when no owner is on record or the check did not run. Written by the Agent 365 registry ingester.",
            "lineageTag": "52dbfa0d-f41c-577a-b4b2-cf7871eb2abf",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Data Access",
            "dataType": "string",
            "description": "What the agent can reach: Organisation content (SharePoint, OneDrive or a Graph connector), Uploaded files only, None declared, or Not reported when the registry gives no capability flags.",
            "expression": [
              "VAR _Yes   = {\"yes\", \"true\", \"1\"}",
              "VAR _Known = {\"yes\", \"no\", \"true\", \"false\", \"1\", \"0\"}",
              "VAR _Sites = LOWER(TRIM(COALESCE('Agents 365'[Can read Sharepoint sites and files], \"\")))",
              "VAR _Drive = LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive files], \"\")))",
              "VAR _Items = LOWER(TRIM(COALESCE('Agents 365'[Can read OneDrive and Sharepoint items], \"\")))",
              "VAR _Graph = LOWER(TRIM(COALESCE('Agents 365'[Can extend to Graph connector], \"\")))",
              "VAR _Files = LOWER(TRIM(COALESCE('Agents 365'[Contains uploaded files], \"\")))",
              "RETURN SWITCH(TRUE(),",
              "    _Sites IN _Yes || _Drive IN _Yes || _Items IN _Yes || _Graph IN _Yes, \"Organisation content\",",
              "    _Files IN _Yes, \"Uploaded files only\",",
              "    _Sites IN _Known || _Drive IN _Known || _Items IN _Known || _Graph IN _Known || _Files IN _Known, \"None declared\",",
              "    \"Not reported\")"
            ],
            "lineageTag": "0dd2c7a6-5333-5292-8bdd-b607c83d338c",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Sign-in Required",
            "dataType": "string",
            "sourceColumn": "Sign-in Required",
            "description": "Whether the agent asks its users to sign in: Yes, No or Unknown. From Azure Resource Graph's agent configuration first, then Defender advanced hunting's agent inventory, when those sources are on; Unknown when no source knows the agent.",
            "lineageTag": "548ad7ed-0438-51d9-9645-97f791ee6308",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Governance Flags",
            "dataType": "string",
            "description": "Why a tenant-built, unblocked agent needs review, separated by '; ': No sign-in required, Owner has left, No owner on record, Org-wide with org data, Shared, no recorded use. Blank when none apply.",
            "expression": [
              "VAR _Tenant  = NOT(LOWER(TRIM(COALESCE('Agents 365'[Created in], \"\"))) IN {\"\", \"not available\"})",
              "VAR _Blocked = LOWER(TRIM(COALESCE('Agents 365'[Is Blocked], \"\"))) IN {\"true\", \"yes\", \"1\"}",
              "VAR _Owner   = LOWER(TRIM(COALESCE('Agents 365'[Owner account], \"\")))",
              "VAR _Source  = LOWER(TRIM(COALESCE('Agents 365'[Agent creator source], \"\")))",
              "VAR _Scope   = 'Agents 365'[Sharing Scope]",
              "VAR _Unused  = COALESCE('Agents 365'[Total Users], 0) = 0",
              "VAR _List =",
              "    IF('Agents 365'[Sign-in Required] = \"No\", \"; No sign-in required\")",
              "    & IF(_Owner IN {\"disabled\", \"not found\"}, \"; Owner has left\")",
              "    & IF(_Source = \"unattributed\", \"; No owner on record\")",
              "    & IF(_Scope = \"Whole organisation\" && 'Agents 365'[Data Access] = \"Organisation content\", \"; Org-wide with org data\")",
              "    & IF(_Scope IN {\"Whole organisation\", \"Specific people or groups\"} && _Unused, \"; Shared, no recorded use\")",
              "RETURN IF(_Tenant && NOT _Blocked && _List <> \"\", MID(_List, 3, 500))"
            ],
            "lineageTag": "646b43dd-08e9-5d08-89a8-16524ab5c1b8",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Agents 365",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    __orig =",
                "    (",
                "let",
                "    EmptyTable = #table(",
                "        {",
                "            \"Agent name\", \"Supported in\", \"Date created\", \"Agent creator\", \"Agent type (A365)\",",
                "            \"Version\", \"Availability\", \"Agent creator ID\", \"Agent description\", \"Created in\",",
                "            \"Last updated\", \"Custom actions\", \"Title ID\", \"Sensitivity\",",
                "            \"Can read OneDrive and Sharepoint items\", \"OneDrive and Sharepoint items\",",
                "            \"Can read OneDrive files\", \"OneDrive files\", \"OneDrive sites\",",
                "            \"Can read Sharepoint sites and files\", \"Sharepoint files\", \"Sharepoint sites\",",
                "            \"Can extend to Graph connector\", \"Graph connector details\",",
                "            \"Can generate images using user prompt\", \"Can use code interpreter\",",
                "            \"Contains uploaded files\", \"Uploaded files\", \"Status\",",
                "            \"Active Users\", \"Total sessions\", \"Exception rate\", \"Last Activity Date\"",
                "        },",
                "        {}",
                "    ),",
                "",
                "    Output =",
                "        if Enable_Agent365 = \"Include\" then",
                "            let",
                "                // Sourced from the Fabric Lakehouse Delta table agents_365 (landed by the Agent 365 producer notebook).",
                "                #\"Promoted Headers\" = try FabricTable(\"agents_365\") otherwise EmptyTable,",
                "",
                "                cols = Table.ColumnNames(#\"Promoted Headers\"),",
                "                nameCol = if List.Contains(cols, \"Agent name\") then \"Agent name\"",
                "                          else if List.Contains(cols, \"Name\") then \"Name\"",
                "                          else \"Name\",",
                "                supportedInCol = if List.Contains(cols, \"Supported in\") then \"Supported in\"",
                "                                 else if List.Contains(cols, \"Channel\") then \"Channel\"",
                "                                 else \"Supported in\",",
                "                creatorCol = if List.Contains(cols, \"Agent creator\") then \"Agent creator\"",
                "                             else if List.Contains(cols, \"Owner\") then \"Owner\"",
                "                             else if List.Contains(cols, \"Publisher\") then \"Publisher\"",
                "                             else if List.Contains(cols, \"Developer Name\") then \"Developer Name\"",
                "                             else \"Agent creator\",",
                "                typeCol = if List.Contains(cols, \"Agent type (A365)\") then \"Agent type (A365)\"",
                "                          else if List.Contains(cols, \"Publisher Type\") then \"Publisher Type\"",
                "                          else if List.Contains(cols, \"Type\") then \"Type\"",
                "                          else \"Agent type (A365)\",",
                "                creatorIdCol = if List.Contains(cols, \"Agent creator ID\") then \"Agent creator ID\"",
                "                               else if List.Contains(cols, \"Creator Id\") then \"Creator Id\"",
                "                               else if List.Contains(cols, \"Creator ID\") then \"Creator ID\"",
                "                               else if List.Contains(cols, \"Created by\") then \"Created by\"",
                "                               else \"Agent creator ID\",",
                "                descCol = if List.Contains(cols, \"Agent description\") then \"Agent description\" else if List.Contains(cols, \"Description\") then \"Description\" else \"Description\",",
                "                lastUpdatedCol = if List.Contains(cols, \"Last updated\") then \"Last updated\"",
                "                                 else if List.Contains(cols, \"Last Modified\") then \"Last Modified\"",
                "                                 else \"Last updated\",",
                "                platformCol = if List.Contains(cols, \"Created in\") then \"Created in\"",
                "                              else if List.Contains(cols, \"Platform\") then \"Platform\"",
                "                              else \"Created in\",",
                "                availabilityCol = if List.Contains(cols, \"Availability\") then \"Availability\"",
                "                                  else if List.Contains(cols, \"Status\") then \"Status\"",
                "                                  else \"Availability\",",
                "                #\"Normalized Columns\" = Table.RenameColumns(",
                "                    #\"Promoted Headers\",",
                "                    List.Combine({",
                "                        if nameCol <> \"Agent name\" then {{nameCol, \"Agent name\"}} else {},",
                "                        if supportedInCol <> \"Supported in\" then {{supportedInCol, \"Supported in\"}} else {},",
                "                        if creatorCol <> \"Agent creator\" then {{creatorCol, \"Agent creator\"}} else {},",
                "                        if typeCol <> \"Agent type (A365)\" then {{typeCol, \"Agent type (A365)\"}} else {},",
                "                        if creatorIdCol <> \"Agent creator ID\" then {{creatorIdCol, \"Agent creator ID\"}} else {},",
                "                        if descCol <> \"Agent description\" then {{descCol, \"Agent description\"}} else {},",
                "                        if lastUpdatedCol <> \"Last updated\" then {{lastUpdatedCol, \"Last updated\"}} else {},",
                "                        if platformCol <> \"Created in\" then {{platformCol, \"Created in\"}} else {},",
                "                        if availabilityCol <> \"Availability\" and availabilityCol <> \"Status\" then {{availabilityCol, \"Availability\"}} else {}",
                "                    }),",
                "                    MissingField.Ignore",
                "                ),",
                "",
                "                #\"With Last Updated\" = if List.Contains(Table.ColumnNames(#\"Normalized Columns\"), \"Last updated\") then #\"Normalized Columns\" else Table.AddColumn(#\"Normalized Columns\", \"Last updated\", each null, type datetime),",
                "                #\"With Supported In\" = if List.Contains(Table.ColumnNames(#\"With Last Updated\"), \"Supported in\") then #\"With Last Updated\" else Table.AddColumn(#\"With Last Updated\", \"Supported in\", each null, type text),",
                "                #\"With Availability\" = if List.Contains(Table.ColumnNames(#\"With Supported In\"), \"Availability\") then #\"With Supported In\"",
                "                                       else if List.Contains(Table.ColumnNames(#\"With Supported In\"), \"Status\") then Table.DuplicateColumn(#\"With Supported In\", \"Status\", \"Availability\", type text)",
                "                                       else Table.AddColumn(#\"With Supported In\", \"Availability\", each null, type text),",
                "                #\"With Created In\" = if List.Contains(Table.ColumnNames(#\"With Availability\"), \"Created in\") then #\"With Availability\" else Table.AddColumn(#\"With Availability\", \"Created in\", each null, type text),",
                "                #\"With Status\" = if List.Contains(Table.ColumnNames(#\"With Created In\"), \"Status\") then #\"With Created In\" else Table.AddColumn(#\"With Created In\", \"Status\", each null, type text),",
                "",
                "                #\"With Active Users\" = if List.Contains(Table.ColumnNames(#\"With Status\"), \"Active Users\") then #\"With Status\" else Table.AddColumn(#\"With Status\", \"Active Users\", each null, Int64.Type),",
                "                #\"With Total Sessions\" = if List.Contains(Table.ColumnNames(#\"With Active Users\"), \"Total sessions\") then #\"With Active Users\" else Table.AddColumn(#\"With Active Users\", \"Total sessions\", each null, Int64.Type),",
                "                #\"With Exception Rate\" = if List.Contains(Table.ColumnNames(#\"With Total Sessions\"), \"Exception rate\") then #\"With Total Sessions\" else Table.AddColumn(#\"With Total Sessions\", \"Exception rate\", each null, type text),",
                "                #\"With Last Activity\" = if List.Contains(Table.ColumnNames(#\"With Exception Rate\"), \"Last Activity Date\") then #\"With Exception Rate\" else Table.AddColumn(#\"With Exception Rate\", \"Last Activity Date\", each null, type datetime),",
                "",
                "                #\"Typed Numerics\" = Table.TransformColumns(#\"With Last Activity\", {",
                "                    {\"Active Users\", each try Number.FromText(Text.From(_)) otherwise null, Int64.Type},",
                "                    {\"Total sessions\", each try Number.FromText(Text.From(_)) otherwise null, Int64.Type},",
                "                    {\"Last Activity Date\", each try DateTime.FromText(Text.From(_)) otherwise null, type datetime}",
                "                }),",
                "                #\"Changed Type\" = let __vlTypes = {{\"Agent name\", type text}, {\"Supported in\", type text}, {\"Date created\", type datetime}, {\"Agent creator\", type text}, {\"Agent type (A365)\", type text}, {\"Version\", type text}, {\"Availability\", type text}, {\"Agent creator ID\", type text}, {\"Agent description\", type text}, {\"Created in\", type text}, {\"Last updated\", type datetime}, {\"Custom actions\", type text}, {\"Title ID\", type text}, {\"Sensitivity\", type text}, {\"Can read OneDrive and Sharepoint items\", type text}, {\"OneDrive and Sharepoint items\", type text}, {\"Can read OneDrive files\", type text}, {\"OneDrive files\", type text}, {\"OneDrive sites\", type text}, {\"Can read Sharepoint sites and files\", type text}, {\"Sharepoint files\", type text}, {\"Sharepoint sites\", type text}, {\"Can extend to Graph connector\", type text}, {\"Graph connector details\", type text}, {\"Can generate images using user prompt\", type text}, {\"Can use code interpreter\", type text}, {\"Contains uploaded files\", type text}, {\"Uploaded files\", type text}, {\"Status\", type text}, {\"Exception rate\", type text}}, __vlPresent = Table.ColumnNames(#\"Typed Numerics\"), __vlSafe = List.Select(__vlTypes, each List.Contains(__vlPresent, _{0})) in Table.TransformColumnTypes(#\"Typed Numerics\", __vlSafe, \"en-US\"),",
                "                #\"Removed Blank TitleID\" = Table.SelectRows(#\"Changed Type\", each [Title ID] <> null and Text.Trim([Title ID]) <> \"\"),",
                "                #\"Distinct TitleID\" = Table.Distinct(#\"Removed Blank TitleID\", {\"Title ID\"})",
                "            in",
                "                #\"Distinct TitleID\"",
                "        else",
                "            EmptyTable",
                "in",
                "    Output",
                "    ),",
                "    __cols = Table.ColumnNames(__orig),",
                "    // Zero-touch Entra Agent ID detection: the audit AgentId for Agent 365",
                "    // (Entra-registered) agents is a bare GUID. Auto-pick whichever column the",
                "    // Agents export uses to carry that GUID, in priority order, so the customer",
                "    // never has to add or populate a column by hand. A non-matching GUID simply",
                "    // does not join (no false links), so including Bot Id is safe.",
                "    __cands = {\"Entra Agent ID\", \"EntraAgentId\", \"Entra Agent Id\", \"EntraAgentID\", \"Agent ID\", \"AgentId\", \"Agent Id\", \"Bot Id\", \"BotId\"},",
                "    __pick = List.First(List.Select(__cands, each List.Contains(__cols, _)), null),",
                "    __out =",
                "        if List.Contains(__cols, \"Entra Agent ID\") then __orig",
                "        else if __pick <> null then Table.DuplicateColumn(__orig, __pick, \"Entra Agent ID\", type text)",
                "        else Table.AddColumn(__orig, \"Entra Agent ID\", each null, type text),",
                "    // --- Stable superset guard (issue #22) --------------------------------",
                "    // The Agent 365 registry/catalogue export (PAX -IncludeAgent365Info, Graph",
                "    // /beta/copilot/admin/catalog/packages) emits a 28-column inventory schema.",
                "    // Observability columns (Users shared / Active Users / Total sessions /",
                "    // Exception rate / Last Activity Date) come from the Admin Center Agent 365",
                "    // export instead. Add whichever model-declared columns the chosen source did",
                "    // not supply as typed nulls, so the table always returns the same superset.",
                "    // Visuals bound to an unavailable field degrade to blank instead of breaking",
                "    // the refresh. Never overwrites a column the source did provide.",
                "    __expected = {",
                "        {\"Date created\", type datetime},",
                "        {\"Custom actions\", type text},",
                "        {\"Title ID\", type text},",
                "        {\"Can read OneDrive files\", type text},",
                "        {\"Can read Sharepoint sites and files\", type text},",
                "        {\"Can extend to Graph connector\", type text},",
                "        {\"Can generate images using user prompt\", type text},",
                "        {\"Can use code interpreter\", type text},",
                "        {\"Contains uploaded files\", type text},",
                "        {\"Agent name\", type text},",
                "        {\"Agent creator\", type text},",
                "        {\"Agent type (A365)\", type text},",
                "        {\"Agent description\", type text},",
                "        {\"Version\", type text},",
                "        {\"Agent creator ID\", type text},",
                "        {\"Sensitivity\", type text},",
                "        {\"Can read OneDrive and Sharepoint items\", type text},",
                "        {\"OneDrive and Sharepoint items\", type text},",
                "        {\"OneDrive files\", type text},",
                "        {\"OneDrive sites\", type text},",
                "        {\"Sharepoint files\", type text},",
                "        {\"Sharepoint sites\", type text},",
                "        {\"Graph connector details\", type text},",
                "        {\"Uploaded files\", type text},",
                "        {\"Groups shared\", type text},",
                "        {\"Users shared\", type text},",
                "        {\"Publisher\", type text},",
                "        {\"Environment Id\", type text},",
                "        {\"Bot Id\", type text},",
                "        {\"Custom action list\", type text},",
                "        {\"Instructions\", type text},",
                "        {\"Deployment\", type text},",
                "        {\"Run Time\", type text},",
                "        {\"Risks\", type text},",
                "        {\"Snapshot As Of\", type datetime},",
                "        {\"Agent creator UPN\", type text},",
                "        {\"Agent creator source\", type text},",
                "        {\"Owner account\", type text},",
                "        {\"App Id\", type text},",
                "        {\"Asset Id\", type text},",
                "        {\"Categories\", type text},",
                "        {\"Is Blocked\", type text},",
                "        {\"Element types\", type text}",
                "    },",
                "    __superset = List.Accumulate(",
                "        __expected,",
                "        __out,",
                "        (state, col) =>",
                "            if List.Contains(Table.ColumnNames(state), col{0}) then state",
                "            else Table.AddColumn(state, col{0}, each null, col{1})",
                "    ),",
                "    // Governance: how widely each agent is shared, worked out from the share",
                "    // lists before the lean pass drops them, so no names reach the model.",
                "    __shareCount = (users, groups) as number =>",
                "        List.Count(List.Distinct(List.Select(",
                "            List.Transform(Text.Split(Text.From(users ?? \"\") & \";\" & Text.From(groups ?? \"\"), \";\"), Text.Trim),",
                "            each _ <> \"\"))),",
                "    __withShared = Table.AddColumn(__superset, \"Shared With Count\",",
                "        each __shareCount([Users shared], [Groups shared]), Int64.Type),",
                "    // Graph availableTo / deployedTo: allowedForAll, acquiredForAll and so on.",
                "    __withScope = Table.AddColumn(__withShared, \"Sharing Scope\", each",
                "        let",
                "            a = Text.Lower(Text.Trim(Text.From([Availability] ?? \"\"))),",
                "            s = Text.Lower(Text.Trim(Text.From([Status] ?? \"\")))",
                "        in",
                "            if a = \"allowedforall\" or s = \"acquiredforall\" then \"Whole organisation\"",
                "            else if a = \"allowedforsome\" or s = \"acquiredforsome\" or [Shared With Count] > 0 then \"Specific people or groups\"",
                "            else if a = \"allowedfornone\" then \"Not shared\"",
                "            else \"Not stated\", type text),",
                "    // Sign-in Required: whether the agent asks its users to sign in (Yes, No or",
                "    // Unknown). Each source is a lookup from a lowercase agent ID (Entra agent ID,",
                "    // bot ID or app ID) to Yes or No, and the first source that knows the agent",
                "    // wins, so put more authoritative sources first. A source that is missing or",
                "    // empty is skipped. Azure Resource Graph's agent configuration comes first, as",
                "    // it reads the agent's own authentication setting; Defender advanced hunting's",
                "    // agent inventory is the fallback.",
                "    __signInLookup = (t as nullable table) as record =>",
                "        if t = null then [] else",
                "        let",
                "            cols = Table.ColumnNames(t),",
                "            last = if List.Contains(cols, \"SnapshotDate\") then List.Max(Table.Column(t, \"SnapshotDate\")) else null,",
                "            latest = if last = null then t else Table.SelectRows(t, each Record.Field(_, \"SnapshotDate\") = last),",
                "            known = List.Select(Table.ToRecords(latest),",
                "                (r) => List.Contains({\"Yes\", \"No\"}, Record.FieldOrDefault(r, \"SignInRequired\", null))),",
                "            pairs = List.Combine(List.Transform(known, (r) =>",
                "                List.Transform(",
                "                    List.Select(",
                "                        List.Transform({\"EntraAgentId\", \"BotId\", \"AppId\", \"AgentId\"},",
                "                            (k) => Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(r, k, null) ?? \"\")))),",
                "                        (k) => k <> \"\"),",
                "                    (k) => {k, r[SignInRequired]}))),",
                "            unique = List.Distinct(pairs, each _{0})",
                "        in",
                "            Record.FromList(List.Transform(unique, each _{1}), List.Transform(unique, each _{0})),",
                "    // Resource Graph says NoSignIn (true when authentication is None) and EntraAppId;",
                "    // map them onto the lookup's SignInRequired and AppId.",
                "    __argSignIn = (t as table) as table =>",
                "        Table.AddColumn(",
                "            Table.RenameColumns(t, {{\"EntraAppId\", \"AppId\"}}, MissingField.Ignore),",
                "            \"SignInRequired\",",
                "            each let v = Record.FieldOrDefault(_, \"NoSignIn\", null) in",
                "                if v = true then \"No\" else if v = false then \"Yes\" else null),",
                "    __signInSources = {",
                "        __signInLookup(try __argSignIn(FabricTable(\"arg_agent_config\")) otherwise null),",
                "        __signInLookup(try FabricTable(\"defender_ai_agents\") otherwise null)",
                "    },",
                "    __withSignIn = Table.AddColumn(__withScope, \"Sign-in Required\", each",
                "        let",
                "            keys = List.Select(",
                "                List.Transform({[Entra Agent ID], [Bot Id], [App Id]}, (v) => Text.Lower(Text.Trim(Text.From(v ?? \"\")))),",
                "                (k) => k <> \"\"),",
                "            answers = List.RemoveNulls(List.Transform(__signInSources, (src) =>",
                "                List.First(List.RemoveNulls(List.Transform(keys, (k) => Record.FieldOrDefault(src, k, null))), null)))",
                "        in",
                "            List.First(answers, \"Unknown\"), type text),",
                "    // Lean pass: drop source columns nothing in the model reads.",
                "    __lean = Table.RemoveColumns(__withSignIn, {\"Date created\", \"Custom actions\", \"Version\", \"Agent creator ID\", \"Sensitivity\", \"OneDrive and Sharepoint items\", \"OneDrive files\", \"OneDrive sites\", \"Sharepoint files\", \"Sharepoint sites\", \"Graph connector details\", \"Uploaded files\", \"Active Users\", \"Total sessions\", \"Exception rate\", \"Last Activity Date\", \"Entra Agent ID\", \"Groups shared\", \"Users shared\", \"Environment Id\", \"Bot Id\", \"Custom action list\", \"Instructions\", \"Deployment\", \"Run Time\", \"Risks\", \"Snapshot As Of\", \"Agent creator UPN\", \"App Id\", \"Asset Id\", \"Categories\", \"Element types\", \"Tags\", \"Last used\"}, MissingField.Ignore)",
                "in",
                "    __lean"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Most Popular Agent Creator (Shared - Agent Builder)",
            "description": [
              "Most popular shared agent creator",
              "👤 Top agent builder",
              "💡 Recognize and support"
            ],
            "expression": [
              "",
              "VAR CreatorActiveUsers = ",
              "    ADDCOLUMNS(",
              "        SUMMARIZE(",
              "            FILTER('Agents 365', 'Agents 365'[Agent Type Combined] = \"Agent Builder\"),",
              "            'Agents 365'[Agent creator]",
              "        ),",
              "        \"@TotalUsers\", ",
              "            CALCULATE(",
              "                DISTINCTCOUNT('Chat + Agent Interactions (Audit Logs)'[Audit_UserId]),",
              "                'Chat + Agent Interactions (Audit Logs)'[Message_isPrompt] = \"TRUE\",",
              "                NOT(ISBLANK('Chat + Agent Interactions (Audit Logs)'[AgentId])),",
              "                'Agents 365'[Agent Type Combined] = \"Agent Builder\"",
              "            )",
              "    )",
              "VAR MaxUsers = MAXX(CreatorActiveUsers, [@TotalUsers])",
              "VAR MostPopularCreator = ",
              "    FILTER(",
              "        CreatorActiveUsers,",
              "        [@TotalUsers] = MaxUsers",
              "    )",
              "RETURN",
              "    CONCATENATEX(MostPopularCreator, 'Agents 365'[Agent creator], \", \")"
            ],
            "lineageTag": "08e8a2ef-be45-41e1-931b-3d76e434147c"
          },
          {
            "name": "Agent Return Rate",
            "description": "Users with at least two observed agent sessions divided by users with at least one observed agent session, respecting current agent/date/organisation filters. No session evidence returns blank, not 0%.",
            "expression": [
              "VAR _UsersWithSessions =",
              "    FILTER(",
              "        ADDCOLUMNS(",
              "            FILTER(VALUES('Chat + Agent Interactions (Audit Logs)'[Audit_UserId]),",
              "                NOT ISBLANK('Chat + Agent Interactions (Audit Logs)'[Audit_UserId])),",
              "            \"@Sessions\", CALCULATE([Observed Agent Sessions])),",
              "        [@Sessions] > 0)",
              "VAR _SessionUsers = COUNTROWS(_UsersWithSessions)",
              "VAR _ReturningUsers = COUNTROWS(FILTER(_UsersWithSessions, [@Sessions] >= 2))",
              "RETURN IF(_SessionUsers > 0, DIVIDE(COALESCE(_ReturningUsers, 0), _SessionUsers))"
            ],
            "formatString": "0.0%",
            "displayFolder": "Agent Health\\Evidence",
            "lineageTag": "9c1b7c1a-c6c3-4fd3-ac05-e046052851d7"
          },
          {
            "name": "Agent Description (Selected)",
            "expression": [
              "IF(",
              "    HASONEVALUE('Agents 365'[Agent name]),",
              "    COALESCE(SELECTEDVALUE('Agents 365'[Agent description]), \"Description unavailable.\"),",
              "    \"Select one registry agent to see its supplied description.\")"
            ],
            "lineageTag": "c346bffa-8568-4e84-b7e0-f67ef689f30d"
          },
          {
            "name": "Agent Registry Records",
            "description": "Registry row count in the current filter context, not a tenant-wide health population estimate.",
            "expression": "COUNTROWS('Agents 365')",
            "formatString": "#,##0",
            "displayFolder": "Agent Health\\Evidence",
            "lineageTag": "d8db8f46-9453-494a-abfa-22dfdec33fb3"
          },
          {
            "name": "Agent Last Observed Activity",
            "description": "Last observed prompt timestamp for matched agent audit records in the selected scope. Absence is not evidence of no use.",
            "expression": [
              "CALCULATE(MAX('Chat + Agent Interactions (Audit Logs)'[CreationDate]),",
              "    KEEPFILTERS('Chat + Agent Interactions (Audit Logs)'[Message_isPrompt] = \"TRUE\"),",
              "    KEEPFILTERS('Chat + Agent Interactions (Audit Logs)'[AgentId] <> BLANK()))"
            ],
            "formatString": "dd MMM yyyy",
            "displayFolder": "Agent Health\\Evidence",
            "lineageTag": "4992e27c-19b6-4a20-997d-149ecc03f434"
          },
          {
            "name": "Agent Audit Linkage Note",
            "description": "Shows audit-session matching coverage; registry-only tables deliberately exclude the unmatched blank dimension member.",
            "expression": [
              "VAR _Reg = CALCULATE(COUNTROWS('Agents 365'), ALL('Agents 365'))",
              "VAR _Seen = [Agents With Observed Activity]",
              "RETURN",
              "    FORMAT(COALESCE(_Seen, 0), \"#,##0\") & \" of \" & FORMAT(_Reg, \"#,##0\")",
              "        & \" listed agents have a session matched from audit logs.\"",
              "        & \" No match = no evidence of use in these dates, not proof of disuse.\""
            ],
            "displayFolder": "Agent Health\\Evidence",
            "lineageTag": "c42f6fad-c8be-4c1f-816b-c416fe6d4356"
          },
          {
            "name": "Agents With Observed Activity",
            "description": "Distinct registry agent names with at least one matched audit session in scope. Counts names, not rows, because the registry repeats a name across environments. Agents used outside the audit window, or whose telemetry never matched, are not counted - absence is not evidence of no use.",
            "expression": [
              "VAR _Rows = COUNTROWS('Agents 365')",
              "VAR _Active = COUNTROWS(FILTER(VALUES('Agents 365'[Agent name]), NOT ISBLANK([Observed Agent Sessions])))",
              "RETURN IF(_Rows > 0, COALESCE(_Active, 0))"
            ],
            "formatString": "#,##0",
            "displayFolder": "Agent Health\\Evidence",
            "lineageTag": "7c41b0e2-5d38-4a91-9f6c-2e83ad5147bb"
          },
          {
            "name": "Agents Built In Tenant",
            "description": "Registry rows the tenant built itself (Copilot Studio, Agent Builder, SharePoint, Foundry). Excludes catalogue listings whose origin the ingestor reports as Not Available.",
            "expression": "COUNTROWS(FILTER('Agents 365', NOT(LOWER(TRIM(COALESCE('Agents 365'[Created in],\"\"))) IN {\"\",\"not available\"})))",
            "formatString": "#,##0",
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "1b6f4a37-2e58-4c90-8d15-6a2c7b03e9f4"
          },
          {
            "name": "Agent Registry Freshness",
            "description": "Most recent 'Last updated' timestamp across registry rows in scope. Reports how fresh the A365 extract is. Distinct from Agent Registry Snapshot, which stays blank when the ingestor supplies no snapshot timestamp.",
            "expression": "MAX('Agents 365'[Last updated])",
            "formatString": "dd MMM yyyy",
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "82d0b1ae-9fcf-4307-f48c-d193e27af06b"
          },
          {
            "name": "Agent Orgs",
            "description": [
              "Reach: distinct organisations whose users generated a matched session for this agent in",
              "the selected dates, mirroring the AI-in-One \"Orgs\" breadth column. Counted from the audit",
              "fact through the user-to-organisation link, so it reports observed reach rather than",
              "registry intent. Users with no organisation record are excluded rather than counted as an",
              "unknown organisation, so reach understates slightly where org data is missing. Blank when",
              "the agent has no matched session, so reach is never implied from the estate-wide count."
            ],
            "expression": [
              "VAR _S = [Observed Agent Sessions]",
              "VAR _Reach =",
              "    CALCULATE(",
              "        COUNTROWS(",
              "            FILTER(",
              "                SUMMARIZE(",
              "                    'Chat + Agent Interactions (Audit Logs)',",
              "                    'Chat + Agent Org Data'[Organization]",
              "                ),",
              "                NOT ISBLANK('Chat + Agent Org Data'[Organization])",
              "            )",
              "        ),",
              "        KEEPFILTERS('Chat + Agent Interactions (Audit Logs)'[Agent Filter (Normalized)] = \"Agents\")",
              "    )",
              "RETURN IF(NOT ISBLANK(_S), _Reach)"
            ],
            "formatString": "#,##0",
            "displayFolder": "Agent Health\\Estate",
            "lineageTag": "0e58b31a-9d64-4f27-8c15-a2b73d604e19"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
      {
        "name": "📖 Metric Glossary",
        "description": "Searchable metric glossary aligned to dashboard pages. Zero performance impact — pure metadata calculated table.",
        "lineageTag": "8b71f88c-7524-4ba0-a81d-f7ca7ef45b64",
        "columns": [
