            "name": "Agent_Is_Published",
            "dataType": "boolean",
            "description": [
              "Agent_Is_Published - TRUE for published agents, FALSE for non-published Microsoft agents",
              "and agents shared by their creator. Blank when the audit log cannot tell (Agent Builder,",
              "Copilot Studio, connected apps, unclassified) and for rows with no agent."
            ],
            "sourceColumn": "Agent_Is_Published",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "a6e1c0d2-7b41-4c55-9f3e-1d2a00000005",
