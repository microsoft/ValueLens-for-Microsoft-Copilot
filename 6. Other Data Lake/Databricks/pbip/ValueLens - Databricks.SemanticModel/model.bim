{
  "name": "e53e51c1-be0e-5109-8640-eccea9802d31",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
