          {
            "type": "calculated",
            "name": "Is_Cowork",
            "dataType": "boolean",
            "description": [
              "TRUE when the row is Cowork activity.",
              "Cowork is tagged differently depending on which ValueLens data path",
              "populated the model, so both trustworthy signals are accepted:",
              "[AppHost]       = \"Cowork\"  - set by the standard template / sample data",
              "[Agent_Surface] = \"Cowork\"  - set by the Fabric / Spark path, where",
              "AppHost instead carries the host application",
              "[Environment] is deliberately NOT used. It also carries \"Cowork\" in the",
              "sample feed, but Environment is the LICENSING dimension and all of those",
              "rows are M365 Copilot Licensed - tagging a surface inside the licensing",
              "column means any Environment = \"Licensed\" filter silently drops licensed",
              "Cowork activity. Use [Agent Filter] to drill into WHICH Cowork agent ran.",
              "Defining Cowork once here keeps every Cowork measure consistent and means",
              "a schema change only has to be handled in a single place."
            ],
            "isHidden": true,
            "expression": "CONTAINSSTRING(COALESCE('Chat + Agent Interactions (Audit Logs)'[AppHost], \"\"), \"cowork\")",
            "lineageTag": "7c1f4a92-3b6d-4e18-9a55-c0de1a2b3c4d",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "AppHost_Norm",
            "dataType": "string",
            "description": [
              "AppHost with known spelling variants collapsed, so that Surface Spread",
              "counts distinct SURFACES rather than distinct spellings. Real Vodafone",
              "audit data carries both \"Teams\" and \"Microsoft Teams\" for the same",
              "surface, which would otherwise score one user as touching 2 surfaces."
            ],
            "isHidden": true,
            "expression": [
              "VAR Raw = TRIM('Chat + Agent Interactions (Audit Logs)'[AppHost])",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        Raw = \"Microsoft Teams\", \"Teams\",",
              "        Raw",
              "    )"
            ],
            "lineageTag": "5d8e2c14-9a37-4f60-b2e1-7c3f9d4a6b82",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Agent Filter (Normalized)",
            "dataType": "string",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    'Chat + Agent Interactions (Audit Logs)'[Is_Cowork], \"Cowork\",",
              "    'Chat + Agent Interactions (Audit Logs)'[Is_Agent_Activity] = TRUE()",
              "        || LEN(TRIM('Chat + Agent Interactions (Audit Logs)'[AgentId])) > 0, \"Agents\",",
              "    \"Copilot\"",
              ")"
            ],
            "lineageTag": "9dc38643-5c5d-4c90-91b6-97e4899ef892",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Turn Band",
            "dataType": "string",
            "expression": [
              "// Conversation depth band for the session (thread) this row belongs to.",
              "VAR _n =",
              "    CALCULATE(",
              "        COUNTROWS('Chat + Agent Interactions (Audit Logs)'),",
              "        ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[ThreadId])",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK('Chat + Agent Interactions (Audit Logs)'[ThreadId]), \"Not recorded\",",
              "        _n = 1, \"1 turn\",",
              "        _n <= 3, \"2-3 turns\",",
              "        _n <= 6, \"4-6 turns\",",
              "        \"7+ turns\"",
              "    )"
            ],
            "sortByColumn": "Session Turn Band Sort",
            "lineageTag": "1b2693d4-c693-4c20-8e72-73602263b09a",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Turn Band Sort",
            "dataType": "int64",
            "isHidden": true,
            "expression": [
              "VAR _n =",
              "    CALCULATE(",
              "        COUNTROWS('Chat + Agent Interactions (Audit Logs)'),",
              "        ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[ThreadId])",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK('Chat + Agent Interactions (Audit Logs)'[ThreadId]), 9,",
              "        _n = 1, 1,",
              "        _n <= 3, 2,",
              "        _n <= 6, 3,",
              "        4",
              "    )"
            ],
            "lineageTag": "ff0d0001-0001-0001-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Model Cost Tier",
            "dataType": "string",
            "description": [
              "Cost band of the model that served the task. This is an editorial classification, not",
              "vendor data: the feed carries a model name but no tier and no per-call price. Bands follow",
              "published list prices per 1M output tokens (researched Nov 2026) - Opus-class $20-25 and",
              "GPT-6 Astra $50 sit in the premium band; Sonnet-class $10 and GPT-5/GPT-4 class $15-30 sit",
              "in the mid band. Unversioned family labels (for example a bare \"Claude\") are mapped to that",
              "family's default production tier, which is Sonnet-class for Claude. Edit the SWITCH below if",
              "your tenant serves different models, and re-check list prices before quoting them."
            ],
            "expression": [
              "VAR _m = 'Chat + Agent Interactions (Audit Logs)'[AI_Model]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(_m), \"Not attributed\",",
              "        CONTAINSSTRING(_m, \"no model logged\"), \"Not attributed\",",
              "        CONTAINSSTRING(_m, \"OPUS\"), \"Frontier (premium cost)\",",
              "        CONTAINSSTRING(_m, \"GPT-6\"), \"Frontier (premium cost)\",",
              "        CONTAINSSTRING(_m, \"SONNET\"), \"Workhorse (mid cost)\",",
              "        CONTAINSSTRING(_m, \"Claude\"), \"Workhorse (mid cost)\",",
              "        CONTAINSSTRING(_m, \"GPT-5\"), \"Workhorse (mid cost)\",",
              "        CONTAINSSTRING(_m, \"GPT-4\"), \"Workhorse (mid cost)\",",
              "        \"Unclassified\"",
              "    )"
            ],
            "sortByColumn": "Model Cost Tier Sort",
            "lineageTag": "ff0d0009-0001-0001-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Model Cost Tier Sort",
            "dataType": "int64",
            "isHidden": true,
            "expression": [
              "VAR _m = 'Chat + Agent Interactions (Audit Logs)'[AI_Model]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(_m), 8,",
              "        CONTAINSSTRING(_m, \"no model logged\"), 8,",
              "        CONTAINSSTRING(_m, \"OPUS\"), 0,",
              "        CONTAINSSTRING(_m, \"GPT-6\"), 0,",
              "        CONTAINSSTRING(_m, \"SONNET\"), 1,",
              "        CONTAINSSTRING(_m, \"Claude\"), 1,",
              "        CONTAINSSTRING(_m, \"GPT-5\"), 1,",
              "        CONTAINSSTRING(_m, \"GPT-4\"), 1,",
              "        9",
              "    )"
            ],
            "lineageTag": "ff0d0009-0001-0001-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Work Weight Grade",
            "dataType": "string",
            "description": [
              "Cowork-fit, graded Strong / Fair / Worth a look with an explicit abstention band. Ported",
              "from the Cowork ROI report's classification methodology (microsoft/What-I-did-with-",
              "Cowork, classification-methodology.md, Part 2 Layer 1) and framed by the",
              "what-to-use-when routing skill. The guiding question is that source's single-surface",
              "test: could ONE in-app Copilot - Word, Excel, PowerPoint, Outlook, Teams or Copilot",
              "Chat, all included in the M365 Copilot licence - have done this end to end, without",
              "spending Cowork consumption credits?",
              "",
              "The source rule is a strict first-match-wins hierarchy. Only part of it is",
              "observable in an audit log, so this is a deliberate FLOOR, not a like-for-like port:",
              "PORTED     rule 2 multi_doc_synth - >=3 material refs across >=2 types, or >5 -> High",
              "PORTED     rule 3 conversational  - nothing attached at all -> Low",
              "PORTED     rule 4 moderate        - >=2 types (multi_fmt_input) or >=3 refs",
              "(many_files) -> Medium",
              "PORTED     rule 5 single surface  - one or two refs of a single type -> Low",
              "PORTED     rule 6 no signal       - refs present but none typed -> Unclassified",
              "SUPERSEDED AS A RULE, KEPT AS A LABEL. This column no longer carries its own",
              "chain; it now reads Fit Rule Step, which owns the ordered logic. It keeps its",
              "original name. Its labels were renamed with the grading setting (High fit -> Strong fit,",
              "Medium fit -> Fair fit, Low fit -> Worth a look; Unclassified unchanged): report visuals filter on those",
              "exact strings, and because it grades ALL sessions - Fit Grade is deliberately",
              "blank outside Cowork, so it cannot stand in for this column on the model pages.",
              "Rule 1 (\">=2 apps in play -> High\") IS now ported, contrary to the note this",
              "replaces. That note reasoned from AppHost, which is a constant \"cowork\" here.",
              "But the MIME type of attached material implies the application, exactly as the",
              "reference's CF_IN_APP map does, and that evidences 236 cross-app sessions.",
              "NOT PORTED rule 2's build / automation / multiple-output-format triggers.",
              "Workflow_Action is empty, Usage_Mode carries one value in Cowork, and",
              "only 188 rows model-wide record a WRITE, so outputs cannot be read.",
              "The source also warns \"produced a file\" is a weak signal regardless.",
              "NOT PORTED Layer 2, the LLM review that may confirm or adjust each grade.",
              "Four of the source's High triggers are therefore unobservable, so this UNDER-states",
              "Strong fit by construction and must not be read as the report's own figure.",
              "",
              "Measured on MATERIAL references, never on Resource_Count: in Cowork 20.4% of what",
              "Resource_Count counts is chat messages and 36.1% is untyped, leaving 43.5% material.",
              "GRAIN. Evaluated per SESSION (ThreadId). A person chooses a surface once per piece",
              "of work, so the routing question is asked of the session, not of each turn.",
              "Earlier builds graded each prompt alone, which convicted every follow-up turn in",
              "a working session because the material had been attached at the start: that put",
              "74.5% of assessed work in Low fit, of which 58% had attached nothing at all.",
              "Thresholds are UNCHANGED from the source - only the grain moved.",
              "Rejected alternative: promoting prompts that sit in long threads. Thread depth",
              "does not discriminate (7+ turn threads are 57.9% of High fit and 56.5% of Low",
              "fit), so promoting on turns would be blanket inflation, not evidence. Lenient",
              "grading (Assumptions[Fit Grading]) opts into it anyway, as a policy choice, not a finding."
            ],
            "expression": [
              "SWITCH(",
              "    'Chat + Agent Interactions (Audit Logs)'[Fit Rule Step],",
              "    1, \"Strong fit\",",
              "    2, \"Strong fit\",",
              "    3, \"Strong fit\",",
              "    4, \"Worth a look\",",
              "    5, \"Fair fit\",",
              "    6, \"Worth a look\",",
              "    8, \"Fair fit\",",
              "    9, \"Fair fit\",",
              "    10, \"Fair fit\",",
              "    \"Unclassified\"",
              ")"
            ],
            "sortByColumn": "Work Weight Grade Sort",
            "lineageTag": "ff0d0009-0001-0001-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Work Weight Grade Sort",
            "dataType": "int64",
            "isHidden": true,
            "expression": [
              "SWITCH(",
              "    'Chat + Agent Interactions (Audit Logs)'[Fit Rule Step],",
              "    1, 0,",
              "    2, 0,",
              "    3, 0,",
              "    5, 1,",
              "    8, 1,",
              "    9, 1,",
              "    10, 1,",
              "    4, 2,",
              "    6, 2,",
              "    3",
              ")"
            ],
            "lineageTag": "ff0d0009-0001-0001-0001-000000000004",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Material Refs",
            "dataType": "int64",
            "description": [
              "Pieces of work material the whole session carried - the depth input to fit. Counts rows flagged",
              "Is Material Ref across the thread, so a file re-listed on a later prompt counts again.",
              "All tools: Cowork is identical to the MIME-only rule it replaces (0 of 39,222 rows differ)."
            ],
            "isHidden": true,
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(FILTER('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[Is Material Ref])),",
              "    ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[ThreadId])",
              ")"
            ],
            "lineageTag": "fc000003-0000-0000-0000-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Material Types",
            "dataType": "int64",
            "description": [
              "Distinct source TYPES across the whole session - the breadth input to fit. Session-grain twin of",
              "Prompt Material Types; reads Is Material Ref, so it counts the same material as Session Material",
              "Refs. All tools; Cowork unchanged."
            ],
            "isHidden": true,
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type]),",
              "    ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[ThreadId]),",
              "    'Chat + Agent Interactions (Audit Logs)'[Is Material Ref] = TRUE()",
              ")"
            ],
            "lineageTag": "fc000003-0000-0000-0000-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Message Reads",
            "dataType": "int64",
            "description": [
              "Messages Cowork READ during the session - its untyped \"message\" rows (action Read). Cowork only;",
              "0 for every other tool. Not material (Is Material Ref excludes them), but evidence the session",
              "worked over real content: a session that attached nothing yet read 15 messages is inbox or",
              "channel work, not idle chat. Single-prompt sessions read a median of 15, so these are items",
              "read, not the session's own chat history. Read by Fit Rule Step under Balanced and Lenient grading."
            ],
            "isHidden": true,
            "expression": [
              "IF(",
              "    'Chat + Agent Interactions (Audit Logs)'[Agent Filter (Normalized)] = \"Cowork\",",
              "    CALCULATE(",
              "        COUNTROWS('Chat + Agent Interactions (Audit Logs)'),",
              "        ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[ThreadId]),",
              "        'Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type] = \"message\"",
              "    ),",
              "    0",
              ")"
            ],
            "lineageTag": "fc0000e1-0000-0000-0000-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Cowork Task Category",
            "dataType": "string",
            "description": [
              "Task Breakdown for Cowork.",
              "",
              "Which Cowork Methodology v4 task category this prompt's work belongs to, read",
              "from the material the prompt actually attached. Blank outside Cowork.",
              "",
              "WHY THIS EXISTS. The upstream pipeline tags every Cowork prompt \"General Chat\",",
              "a bucket whose own Behavior Value Map entry reads \"No specific resource/plugin/",
              "action signals matched\". That is a fallback, and for Cowork it is wrong: 49% of",
              "Cowork prompts attach a typed resource - spreadsheets, decks, documents, PDFs.",
              "Left uncorrected the whole surface is valued at the General assistance band",
              "(8 min/turn), the lowest in the methodology.",
              "",
              "LIMITS. Material evidences what was touched, not what the person intended, so",
              "this is a FLOOR in the same sense as Work Weight Grade. Three v4 categories are",
              "not observable in an audit log and are never assigned here: Meeting workflows,",
              "Specialized workflows, and Write or debug code. Prompts attaching nothing",
              "typed stay in General assistance / Other rather than being guessed at.",
              "Evaluated per prompt (Message_Id), so every row of a prompt carries one answer."
            ],
            "expression": [
              "VAR _types =",
              "    CALCULATE(",
              "        CONCATENATEX(",
              "            VALUES('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type]),",
              "            LOWER(TRIM('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type])),",
              "            \"|\"",
              "        ),",
              "        ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[Message_Id])",
              "    )",
              "VAR _t = COALESCE(_types, \"\")",
              "RETURN",
              "    IF(",
              "        'Chat + Agent Interactions (Audit Logs)'[Agent Filter (Normalized)] <> \"Cowork\",",
              "        BLANK(),",
              "        SWITCH(",
              "            TRUE(),",
              "            CONTAINSSTRING(_t, \"rfc822\") || CONTAINSSTRING(_t, \"ms-outlook\"),",
              "                \"Email workflows\",",
              "            CONTAINSSTRING(_t, \"spreadsheetml\") || CONTAINSSTRING(_t, \"text/csv\")",
              "                || CONTAINSSTRING(_t, \"application/json\") || CONTAINSSTRING(_t, \"application/xml\")",
              "                || CONTAINSSTRING(_t, \"application/pdf\") || CONTAINSSTRING(_t, \"application/zip\")",
              "                || CONTAINSSTRING(_t, \"application/gzip\"),",
              "                \"Analysis & Research\",",
              "            CONTAINSSTRING(_t, \"wordprocessingml\") || CONTAINSSTRING(_t, \"presentationml\")",
              "                || CONTAINSSTRING(_t, \"ms-powerpoint\") || CONTAINSSTRING(_t, \"text/markdown\")",
              "                || CONTAINSSTRING(_t, \"text/html\") || CONTAINSSTRING(_t, \"image/\"),",
              "                \"Document & content creation\",",
              "            CONTAINSSTRING(_t, \"message\"),",
              "                \"Communication workflows\",",
              "            \"General assistance / Other\"",
              "        )",
              "    )"
            ],
            "lineageTag": "fc000002-0000-0000-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Task Breakdown Category",
            "dataType": "string",
            "description": [
              "Task Breakdown: the ~50 detailed tasks, with Cowork's own tasks for Cowork.",
              "",
              "The breakdown dimension used by the Task Breakdown visuals. Behaviour for every",
              "cohort that has one; the Cowork task category for Cowork, which does not.",
              "",
              "WHY. Behavior_Enriched_Full carries 26 values across the estate but exactly ONE",
              "inside Cowork - \"General Chat\", the feed's explicit no-signals-matched fallback -",
              "so grouping on it rendered Cowork as a single 100% block and told the reader",
              "nothing. Substituting only for Cowork leaves every other cohort's breakdown",
              "byte-identical to before.",
              "",
              "LIMIT. About half of Cowork still resolves to \"General assistance / Other\"",
              "because those prompts attach no typed material. That is a real absence of",
              "evidence, not a category, and it is left visible rather than guessed at."
            ],
            "expression": [
              "IF(",
              "    'Chat + Agent Interactions (Audit Logs)'[Agent Filter (Normalized)] = \"Cowork\",",
              "    'Chat + Agent Interactions (Audit Logs)'[Cowork Task Category],",
              "    'Chat + Agent Interactions (Audit Logs)'[Behavior_Enriched_Full]",
              ")"
            ],
            "lineageTag": "fc000004-0000-0000-0000-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Is Prompt Row",
            "dataType": "boolean",
            "description": [
              "TRUE when the row is a prompt turn. Materialises a test that previously ran",
              "row by row in the formula engine at 11 separate call sites, each one scanning",
              "the whole fact table. Same expression, computed once at refresh."
            ],
            "isHidden": true,
            "expression": "UPPER(TRIM('Chat + Agent Interactions (Audit Logs)'[Message_isPrompt])) IN { \"TRUE\", \"1\" }",
            "lineageTag": "ff0d000a-0001-0001-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Is Observed Prompt",
            "dataType": "boolean",
            "description": [
              "TRUE when the row is a prompt turn that carries the three identifiers a",
              "session needs. Exactly the predicate Observed Sessions used to evaluate",
              "inside FILTER() over 6.75M rows on every call."
            ],
            "isHidden": true,
            "expression": [
              "UPPER(TRIM('Chat + Agent Interactions (Audit Logs)'[Message_isPrompt])) IN { \"TRUE\", \"1\" }",
              "    && LEN(TRIM('Chat + Agent Interactions (Audit Logs)'[Audit_UserId])) > 0",
              "    && LEN(TRIM('Chat + Agent Interactions (Audit Logs)'[Message_Id])) > 0",
              "    && LEN(TRIM('Chat + Agent Interactions (Audit Logs)'[ThreadId])) > 0"
            ],
            "lineageTag": "ff0d000a-0001-0001-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Task Engagement Mode",
            "dataType": "string",
            "description": [
              "Engagement mode: Asking, Finding, Consuming or Producing.",
              "",
              "How deeply the AI engaged with the work, on the estate's existing four-rung",
              "ladder. Usage_Mode verbatim for every cohort that reports one; a ladder derived",
              "from the material the prompt touched for Cowork, which does not.",
              "",
              "WHY. Usage_Mode is a strict 1:1 relabel of Behavior_Enriched_Full - every one of",
              "the 26 behaviours maps to exactly one rung. Cowork carries the single fallback",
              "behaviour \"General Chat\", so it inherits \"1 - Asking\" for 100% of its activity",
              "and the engagement chart rendered one bar. That is an artefact of the feed, not",
              "a finding about how people work.",
              "",
              "RULE (Cowork only, evaluated per prompt, highest rung reached wins):",
              "4 - Producing  a generated markdown artefact is attached",
              "3 - Consuming  a document, deck, sheet, PDF, image or mail item was touched",
              "2 - Finding    only chat messages were referenced",
              "1 - Asking     nothing typed was attached - pure conversation",
              "",
              "LIMITS. This reads material, not intent, so like Work Weight Grade it is a",
              "FLOOR. \"4 - Producing\" rests on markdown being Cowork's artefact format; it",
              "covers 6.0% of prompts and markdown appears alone in only 2 of 1,930 sessions,",
              "which is consistent with generated output rather than pasted input. Treat that",
              "rung as the weakest of the four. The audit log carries no WRITE action for",
              "Cowork, so production cannot be confirmed directly."
            ],
            "expression": [
              "VAR _types =",
              "    CALCULATE(",
              "        CONCATENATEX(",
              "            VALUES('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type]),",
              "            LOWER(TRIM('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type])),",
              "            \"|\"",
              "        ),",
              "        ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[Message_Id])",
              "    )",
              "VAR _t = COALESCE(_types, \"\")",
              "RETURN",
              "    IF(",
              "        'Chat + Agent Interactions (Audit Logs)'[Agent Filter (Normalized)] <> \"Cowork\",",
              "        'Chat + Agent Interactions (Audit Logs)'[Usage_Mode],",
              "        SWITCH(",
              "            TRUE(),",
              "            CONTAINSSTRING(_t, \"text/markdown\"), \"4 - Producing\",",
              "            CONTAINSSTRING(_t, \"officedocument\") || CONTAINSSTRING(_t, \"application/\")",
              "                || CONTAINSSTRING(_t, \"image/\") || CONTAINSSTRING(_t, \"text/csv\")",
              "                || CONTAINSSTRING(_t, \"text/html\") || CONTAINSSTRING(_t, \"text/plain\")",
              "                || CONTAINSSTRING(_t, \"rfc822\") || CONTAINSSTRING(_t, \"ms-outlook\")",
              "                || CONTAINSSTRING(_t, \"ms-powerpoint\"), \"3 - Consuming\",",
              "            CONTAINSSTRING(_t, \"message\"), \"2 - Finding\",",
              "            \"1 - Asking\"",
              "        )",
              "    )"
            ],
            "lineageTag": "ff0d0009-0004-0001-0001-000000000031",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Task Breakdown Group",
            "dataType": "string",
            "description": [
              "Task Category: the 12 tool-agnostic groups, such as Email, Data & Analysis and Document Creation.",
              "",
              "The broad work-pattern parent for the Value Table. The estate's existing",
              "12-bucket taxonomy for every cohort that reaches it; a direct mapping from the",
              "Cowork task category for Cowork, which cannot.",
              "",
              "WHY. Human Time Estimates[Category] is reached through Behavior_Enriched_Full.",
              "Every Cowork row carries the feed's single fallback behaviour \"General Chat\",",
              "so all 39,222 Cowork rows inherited the \"General Chat & Q&A\" parent - including",
              "12,737 rows of document and content creation and 12,293 of data analysis. The",
              "child rows were already correct; only the parent was wrong.",
              "",
              "MAPPING. Each Cowork category is placed in the existing bucket that matches the",
              "material it was derived from, so no new taxonomy is introduced:",
              "Email workflows             -> Email                     (rfc822, ms-outlook)",
              "Analysis & Research         -> Data & Analysis           (spreadsheet, csv, json, xml, pdf)",
              "Document & content creation -> Document Creation         (word, powerpoint, markdown, html, image)",
              "Communication workflows     -> Collaboration & Workflows (chat messages)",
              "General assistance / Other  -> General Chat & Q&A        (no typed material attached)",
              "",
              "LIMIT. \"Analysis & Research\" is mapped to Data & Analysis rather than Search &",
              "Research because its rule fires on attached data files, not on search activity.",
              "The last row is an absence of evidence, not a category, and is left where the",
              "estate already puts unclassified conversation rather than being redistributed."
            ],
            "expression": [
              "IF(",
              "    'Chat + Agent Interactions (Audit Logs)'[Agent Filter (Normalized)] <> \"Cowork\",",
              "    RELATED('Human Time Estimates'[Category]),",
              "    SWITCH(",
              "        'Chat + Agent Interactions (Audit Logs)'[Cowork Task Category],",
              "        \"Email workflows\", \"Email\",",
              "        \"Analysis & Research\", \"Data & Analysis\",",
              "        \"Document & content creation\", \"Document Creation\",",
              "        \"Communication workflows\", \"Collaboration & Workflows\",",
              "        \"General Chat & Q&A\"",
              "    )",
              ")"
            ],
            "lineageTag": "fc000005-0000-0000-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Fit Basis",
            "dataType": "string",
            "description": [
              "Why this session landed in its Fit band, in words. Pure presentation - the",
              "decision was already made by Fit Rule Step."
            ],
            "expression": [
              "VAR _step = 'Chat + Agent Interactions (Audit Logs)'[Fit Rule Step]",
              "VAR _list = COALESCE('Chat + Agent Interactions (Audit Logs)'[Session Surface List], \"\")",
              "RETURN",
              "    SWITCH(",
              "        _step,",
              "        1, \"Spans \" & _list,",
              "        2, \"Built or packaged an artifact\",",
              "        3, \"Multi-source synthesis\",",
              "        4, \"Chat only - nothing attached\",",
              "        5, \"Mixed or repeated sources\",",
              "        6, _list & \" Copilot could have done it\",",
              "        8, \"Read messages - nothing attached\",",
              "        9, \"Longer chat - nothing attached\",",
              "        10, \"Worked in one app (\" & _list & \")\",",
              "        \"Insufficient evidence\"",
              "    )"
            ],
            "lineageTag": "fc000011-0000-0000-0000-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Type Blob",
            "dataType": "string",
            "description": [
              "Every distinct resource MIME type this session touched, lower-cased and joined",
              "with \"|\". Session-scoped, so every row of a session carries the same string.",
              "",
              "WHY IT IS ITS OWN COLUMN. Three columns below need this same string. Computing",
              "it inline in each of them ran CALCULATE + ALLEXCEPT + CONCATENATEX three times",
              "over a 6.7M-row fact table - three full thread-scoped scans to answer one",
              "question. Materialising it once cuts that to a single scan and means the three",
              "readers cannot drift apart, which is the same reason Fit Rule Step exists."
            ],
            "isHidden": true,
            "expression": [
              "VAR _t =",
              "    CALCULATE(",
              "        CONCATENATEX(",
              "            VALUES('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type]),",
              "            LOWER(TRIM('Chat + Agent Interactions (Audit Logs)'[AccessedResource_Type])),",
              "            \"|\"",
              "        ),",
              "        ALLEXCEPT('Chat + Agent Interactions (Audit Logs)', 'Chat + Agent Interactions (Audit Logs)'[ThreadId])",
              "    )",
              "RETURN",
              "    COALESCE(_t, \"\")"
            ],
            "lineageTag": "fc0000a1-0000-0000-0000-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Surfaces",
            "dataType": "int64",
            "description": [
              "How many distinct in-app Copilot surfaces this session's material implies.",
              "Session-scoped, so every row of a session carries the same answer.",
              "",
              "WHY THIS EXISTS. This is the reference skill's top-priority branch and the one",
              "signal our fit rule was missing. microsoft/What-I-did-with-Cowork grades a task",
              "High the moment it spans two or more apps, on the reasoning that no single",
              "in-app Copilot works across applications, so only Cowork could have done it.",
              "It reads those surfaces off artifact extensions (CF_IN_APP in compute.py);",
              "we read the same surfaces off the types the session actually touched.",
              "",
              "ALL TOOLS. Cowork logs MIME types (spreadsheetml, rfc822 ...); Copilot and agents log",
              "extensions (xlsx, EmailMessage ...). Both spellings are read, matched as whole \"|\"-delimited",
              "tokens so \"xls\" never matches inside \"xlsx\". Teams (TeamsMessage) is a sixth surface; it",
              "never occurs in Cowork, which logs the messages it reads as untyped \"message\" rows",
              "(counted as evidence by Session Message Reads, never as a surface).",
              "",
              "LIMITS. Generic types - \"File\", markdown, images, octet-stream - name no application and are",
              "counted here as zero surfaces, so this is a FLOOR. The reference also infers surfaces from words",
              "in the user's prompt (\"triage\" implies Outlook); we deliberately do not, because that inference",
              "misfires - in the reference's own demo it labels a Teams-only session \"Needs Outlook + Teams\"",
              "purely on the word \"triage\"."
            ],
            "isHidden": true,
            "expression": [
              "VAR _s = 'Chat + Agent Interactions (Audit Logs)'[Session Type Blob]",
              "VAR _k = \"|\" & _s & \"|\"",
              "VAR _xl = CONTAINSSTRING(_s, \"spreadsheetml\") || CONTAINSSTRING(_s, \"ms-excel\") || CONTAINSSTRING(_s, \"text/csv\")",
              "    || CONTAINSSTRING(_k, \"|xlsx|\") || CONTAINSSTRING(_k, \"|xlsm|\") || CONTAINSSTRING(_k, \"|xls|\") || CONTAINSSTRING(_k, \"|csv|\")",
              "VAR _wd = CONTAINSSTRING(_s, \"wordprocessingml\") || CONTAINSSTRING(_s, \"msword\")",
              "    || CONTAINSSTRING(_k, \"|docx|\") || CONTAINSSTRING(_k, \"|doc|\")",
              "VAR _pp = CONTAINSSTRING(_s, \"presentationml\") || CONTAINSSTRING(_s, \"ms-powerpoint\")",
              "    || CONTAINSSTRING(_k, \"|pptx|\") || CONTAINSSTRING(_k, \"|ppt|\")",
              "VAR _ol = CONTAINSSTRING(_s, \"rfc822\") || CONTAINSSTRING(_s, \"ms-outlook\")",
              "    || CONTAINSSTRING(_k, \"|emailmessage|\") || CONTAINSSTRING(_k, \"|eml|\") || CONTAINSSTRING(_k, \"|msg|\") || CONTAINSSTRING(_k, \"|event|\")",
              "VAR _pd = CONTAINSSTRING(_s, \"application/pdf\") || CONTAINSSTRING(_k, \"|pdf|\")",
              "VAR _tm = CONTAINSSTRING(_k, \"|teamsmessage|\")",
              "RETURN",
              "    IF(_xl, 1, 0) + IF(_wd, 1, 0) + IF(_pp, 1, 0) + IF(_ol, 1, 0) + IF(_pd, 1, 0) + IF(_tm, 1, 0)"
            ],
            "lineageTag": "fc0000a1-0000-0000-0000-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Surface List",
            "dataType": "string",
            "description": [
              "The in-app Copilots this session's material implies, as readable text.",
              "Feeds the Fit reason so a row can say \"Spans Excel, PowerPoint\" rather than",
              "leaving the reader to guess which two applications were involved. Same tests as Session Surfaces."
            ],
            "isHidden": true,
            "expression": [
              "VAR _s = 'Chat + Agent Interactions (Audit Logs)'[Session Type Blob]",
              "VAR _k = \"|\" & _s & \"|\"",
              "VAR _xl = CONTAINSSTRING(_s, \"spreadsheetml\") || CONTAINSSTRING(_s, \"ms-excel\") || CONTAINSSTRING(_s, \"text/csv\")",
              "    || CONTAINSSTRING(_k, \"|xlsx|\") || CONTAINSSTRING(_k, \"|xlsm|\") || CONTAINSSTRING(_k, \"|xls|\") || CONTAINSSTRING(_k, \"|csv|\")",
              "VAR _wd = CONTAINSSTRING(_s, \"wordprocessingml\") || CONTAINSSTRING(_s, \"msword\")",
              "    || CONTAINSSTRING(_k, \"|docx|\") || CONTAINSSTRING(_k, \"|doc|\")",
              "VAR _pp = CONTAINSSTRING(_s, \"presentationml\") || CONTAINSSTRING(_s, \"ms-powerpoint\")",
              "    || CONTAINSSTRING(_k, \"|pptx|\") || CONTAINSSTRING(_k, \"|ppt|\")",
              "VAR _ol = CONTAINSSTRING(_s, \"rfc822\") || CONTAINSSTRING(_s, \"ms-outlook\")",
              "    || CONTAINSSTRING(_k, \"|emailmessage|\") || CONTAINSSTRING(_k, \"|eml|\") || CONTAINSSTRING(_k, \"|msg|\") || CONTAINSSTRING(_k, \"|event|\")",
              "VAR _pd = CONTAINSSTRING(_s, \"application/pdf\") || CONTAINSSTRING(_k, \"|pdf|\")",
              "VAR _tm = CONTAINSSTRING(_k, \"|teamsmessage|\")",
              "VAR _raw =",
              "    IF(_xl, \"Excel, \", \"\") & IF(_wd, \"Word, \", \"\") & IF(_pp, \"PowerPoint, \", \"\")",
              "        & IF(_ol, \"Outlook, \", \"\") & IF(_pd, \"PDF, \", \"\") & IF(_tm, \"Teams, \", \"\")",
              "RETURN",
              "    IF(LEN(_raw) = 0, \"\", LEFT(_raw, LEN(_raw) - 2))"
            ],
            "lineageTag": "fc000011-0000-0000-0000-000000000004",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Session Build Artifact",
            "dataType": "int64",
            "description": [
              "Whether this session handled a packaged or machine-readable artifact - an",
              "archive, a web page, a script or a structured data file.",
              "",
              "WHY. This is the reference skill's \"Cowork-only build\" branch: producing or",
              "packaging code, an app or a bundle is work no in-app Copilot performs, so it",
              "grades High. The reference tests output extensions against {zip, py, ps1, js,",
              "ts, ipynb, sh, html, htm}; we test the same idea against the MIME types Cowork emits",
              "and the same extensions as whole tokens for other tools. Its other half - reading build",
              "intent out of the prompt wording - needs text we do not hold and is not attempted."
            ],
            "isHidden": true,
            "expression": [
              "VAR _s = 'Chat + Agent Interactions (Audit Logs)'[Session Type Blob]",
              "VAR _k = \"|\" & _s & \"|\"",
              "RETURN",
              "    IF(",
              "        CONTAINSSTRING(_s, \"application/zip\") || CONTAINSSTRING(_s, \"application/gzip\")",
              "            || CONTAINSSTRING(_s, \"octet-stream\") || CONTAINSSTRING(_s, \"text/html\")",
              "            || CONTAINSSTRING(_s, \"application/json\") || CONTAINSSTRING(_s, \"application/xml\")",
              "            || CONTAINSSTRING(_k, \"|zip|\") || CONTAINSSTRING(_k, \"|gz|\") || CONTAINSSTRING(_k, \"|html|\")",
              "            || CONTAINSSTRING(_k, \"|htm|\") || CONTAINSSTRING(_k, \"|json|\") || CONTAINSSTRING(_k, \"|xml|\")",
              "            || CONTAINSSTRING(_k, \"|py|\") || CONTAINSSTRING(_k, \"|ps1|\") || CONTAINSSTRING(_k, \"|js|\")",
              "            || CONTAINSSTRING(_k, \"|ts|\") || CONTAINSSTRING(_k, \"|ipynb|\") || CONTAINSSTRING(_k, \"|sh|\"),",
              "        1,",
              "        0",
              "    )"
            ],
            "lineageTag": "fc000011-0000-0000-0000-000000000005",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Fit Rule Step",
            "dataType": "int64",
            "description": [
              "WHICH RULE DECIDED THIS SESSION. One ordered chain, evaluated once, expressed as",
              "a step number so that every label downstream - Fit Basis, Work Shape and Work",
              "Weight Grade - reads the SAME decision instead of re-deriving it.",
              "An earlier draft had Fit Grade parse Fit Basis with LEFT(_r, 6) = \"Spans \",",
              "which silently coupled a grade to the spelling of a sentence; renaming the",
              "reason would have regraded the estate. Nothing parses prose now.",
              "",
              "This follows the published order in microsoft/What-I-did-with-Cowork",
              "(compute.py cowork_fit), restricted to the branches an audit log can evidence.",
              "First match wins, so the reason a row shows is the strongest claim available.",
              "Step numbers are stable IDs, not positions: 8-10 were added later so that every",
              "existing number, and each label keyed on it, kept its meaning. In chain order:",
              "",
              "1  Spans 2+ apps           -> Strong. No single in-app Copilot crosses apps.",
              "2  Built or packaged       -> Strong. Archives, web pages and structured data.",
              "3  Multi-source synthesis  -> Strong. 3+ items across 2+ kinds, or more than 5 items.",
              "8  Read messages           -> Fair.   Nothing attached, but Cowork read messages. Balanced, Lenient.",
              "9  Longer chat             -> Fair.   Nothing attached or read, more than one turn. Lenient only.",
              "4  Chat only               -> Worth a look. Nothing attached (and, unless Strict, nothing read).",
              "5  Mixed or repeated       -> Fair.   Some breadth or depth, but not both.",
              "10 One app                 -> Fair.   One app's material. Balanced, Lenient.",
              "6  One app would have done -> Worth a look. Strict only; names the Copilot that could have covered it.",
              "7  Insufficient evidence   -> Unclassified. Material attached but nothing in it names",
              "an application, so no honest call is possible.",
              "",
              "GRADING SETTING - Assumptions[Fit Grading] sets how hard the chain is on light sessions.",
              "Strict: the original chain - chat only or one app is Worth a look.",
              "Balanced (default): messages read and one-app work are Fair, so Worth a look is kept for",
              "chat where nothing was read or attached. Cowork logs the messages it reads as untyped",
              "\"message\" rows (a median of 15 per single-prompt session); the original chain ignored",
              "them, so inbox and channel work read as idle chat. One-app work moves to Fair because",
              "the grade cannot see whether that app's own Copilot would really have done it as well.",
              "Lenient: a longer chat with nothing attached is Fair too. This deliberately adopts the",
              "\"promote on turns\" idea Work Weight Grade rejects as evidence - a policy choice for",
              "estates that want the fewest flags, not a finding.",
              "Any other value reads as Balanced. Steps 1, 2, 3, 5 and 7 are identical in every mode,",
              "and Strict reproduces the original chain row for row. The setting is read with",
              "SELECTEDVALUE from a disconnected one-row table: no context transition, so no",
              "dependency on the fact table's other columns.",
              "",
              "STEP 7 IS THE POINT OF THE REWRITE. 205 sessions previously read \"1-2 items,",
              "1 type\" and were counted Low. They are not low-fit; they are unreadable - a",
              "single untyped \"File\" or a pasted block of markdown. Calling them Low overstated",
              "what the log can support, so they leave the graded population rather than",
              "inflating it.",
              "",
              "STEP 4 IS DELIBERATELY NOT SPLIT ON Resource_Count. A draft of this chain sent",
              "\"no material AND no resources\" to Low but \"no material, some resources\" to the",
              "ungradable bucket, mirroring a distinction the old Work Weight Grade appeared to",
              "make. Verification killed it: Resource_Count counts CHAT MESSAGES, so it is never",
              "zero on a real session - the no-resources branch fired 0 times and all 696",
              "chat-only sessions became ungradable, taking 46.7% of the estate out of scope.",
              "A session where nothing was attached and the user simply chatted is the",
              "reference's clearest Low (its `conversational` branch), not an unknown.",
              "",
              "TWO REFERENCE BRANCHES ARE ABSENT AND CANNOT BE ADDED. Automation/workflow and",
              "platform setup are matched in the reference by scanning the user's prompt for",
              "words like \"triage\", \"sweep\" or \"schedule\". Microsoft 365 audit logs do not",
              "carry prompt text. Their absence makes this rule systematically more",
              "conservative than the reference - it will under-call High, never over-call it."
            ],
            "isHidden": true,
            "expression": [
              "VAR _m = COALESCE('Chat + Agent Interactions (Audit Logs)'[Session Material Refs], 0)",
              "VAR _b = COALESCE('Chat + Agent Interactions (Audit Logs)'[Session Material Types], 0)",
              "VAR _surf = COALESCE('Chat + Agent Interactions (Audit Logs)'[Session Surfaces], 0)",
              "VAR _build = COALESCE('Chat + Agent Interactions (Audit Logs)'[Session Build Artifact], 0)",
              "VAR _reads = COALESCE('Chat + Agent Interactions (Audit Logs)'[Session Message Reads], 0)",
              "VAR _mode = SELECTEDVALUE(Assumptions[Fit Grading], \"Balanced\")",
              "VAR _strict = _mode = \"Strict\"",
              "VAR _lenient = _mode = \"Lenient\"",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _surf >= 2, 1,",
              "        _build = 1, 2,",
              "        _m >= 3 && _b >= 2, 3,",
              "        _m > 5, 3,",
              "        _m = 0 && _reads > 0 && NOT _strict, 8,",
              "        _m = 0 && _lenient && NOT ('Chat + Agent Interactions (Audit Logs)'[Session Turn Band] IN {\"1 turn\", \"Not recorded\"}), 9,",
              "        _m = 0, 4,",
              "        _b >= 2 || _m >= 3, 5,",
              "        _surf = 1 && NOT _strict, 10,",
              "        _surf = 1, 6,",
              "        7",
              "    )"
            ],
            "lineageTag": "fc0000a1-0000-0000-0000-000000000004",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Work Shape",
            "dataType": "string",
            "description": [
              "The SHAPE of the work, as a groupable dimension - the finer grain beneath the task category.",
              "Every tool (renamed from the earlier Cowork-only column; Cowork values unchanged).",
              "",
              "Pure relabelling of [Fit Rule Step] into task language. Deriving it from the same",
              "number that decides the grade means a Category x Work Shape matrix can never show a",
              "shape under a contradictory fit colour, which is the entire point: it answers why one",
              "Email session is strong fit and the next is worth a look. The category says what the",
              "work was about; the shape says what the session actually had to do.",
              "",
              "NOT the reference's finer axis. That one is `Process`, 13 APQC labels assigned by",
              "TF-IDF over the user's free-text goal string. Audit logs carry no prompt text, so that",
              "axis is unreproducible here and is not faked."
            ],
            "expression": [
              "SWITCH(",
              "    'Chat + Agent Interactions (Audit Logs)'[Fit Rule Step],",
              "    1, \"Cross-app chain\",",
              "    2, \"Builds an artifact\",",
              "    3, \"Multi-source synthesis\",",
              "    4, \"Chat only\",",
              "    5, \"Moderate sourcing\",",
              "    6, \"Single-app task\",",
              "    8, \"Read messages\",",
              "    9, \"Longer chat\",",
              "    10, \"Single-app task\",",
              "    \"Not enough detail\"",
              ")"
            ],
            "sortByColumn": "Work Shape Sort",
            "lineageTag": "fc0000b1-0000-0000-0000-000000000004",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
