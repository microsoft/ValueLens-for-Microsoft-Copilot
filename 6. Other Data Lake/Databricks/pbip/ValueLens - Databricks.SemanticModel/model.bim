          {
            "name": "Agent_Consolidated_Name",
            "dataType": "string",
            "description": [
              "Agent_Consolidated_Name - display name that rolls every Microsoft first-party agent up to",
              "one name (for example all Researcher rows, whatever their agent ID or host). Other agents",
              "keep their own name (else agent ID). Blank for rows with no agent."
            ],
            "sourceColumn": "Agent_Consolidated_Name",
