{
  "name": "valuelens-consumption-central-fabric-app",
  "description": "ValueLens and Consumption Central as a Fabric App that reads their semantic models live. One codebase, three variants: ValueLens, Consumption Central, or both.",
  "license": "MIT",
  "author": "Microsoft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "npx fabric-app-data generate -o src/fabric.generated.ts && tsc -b --noCheck && vite build",
    "build:fabric": "npx fabric-app-data generate -o src/fabric.generated.ts && tsc -b --noCheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fabric": "node scripts/open-fabric-portal.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:vl": "node scripts/deploy.mjs --variant vl",
    "deploy:cc": "node scripts/deploy.mjs --variant cc",
    "deploy:both": "node scripts/deploy.mjs --variant both"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.24.0",
    "@microsoft/fabric-app-data": "1.1.0",
    "@microsoft/fabric-app-data-embed-client": "1.0.0",
    "@microsoft/fabric-app-data-proxy": "1.0.0",
    "@microsoft/fabric-datagrid": "4.0.0",
    "@microsoft/fabric-visuals": "4.0.0",
    "@microsoft/fabric-visuals-core": "4.0.0",
    "@microsoft/fabric-visuals-extensibility": "4.0.0",
    "@microsoft/rayfin-auth-provider-fabric": "1.35.1",
    "@microsoft/rayfin-client": "1.35.1",
    "@microsoft/rayfin-core": "1.35.1",
    "@microsoft/rayfin-data": "1.35.1",
    "@microsoft/rayfin-lib": "1.35.1",
    "@microsoft/teams-js": "^2.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "apache-arrow": "^21.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/fabric-app-data-cli": "3.0.0",
    "@microsoft/fabric-app-data-cli-proxy": "2.0.0",
    "@microsoft/rayfin-cli": "1.35.1",
    "@microsoft/rayfin-mcp": "1.35.1",
    "@playwright/cli": "^0.1.21",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
