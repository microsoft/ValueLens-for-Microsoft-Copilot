EVALUATE
// The report's "<cohort> · Organization → User" table. The measure names
// are filled in per cohort by leaderboard-people.ts.
// Every group row is kept, so the totals stay whole; the people under them
// stop at the top 1,000, and "Total" counts them all.
VAR _all =
    SUMMARIZECOLUMNS(
        ROLLUPADDISSUBTOTAL(
            'Chat + Agent Org Data'[Organization], "Is Grand Total",
            'Chat + Agent Interactions (Audit Logs)'[Audit_UserId], "Is Group Total"
        ),
        // As on the report's Leaderboard page: Security Copilot's automated
        // sessions would otherwise top every ranking.
        KEEPFILTERS(
            FILTER(
                ALL('Chat + Agent Interactions (Audit Logs)'[AppHost]),
                NOT CONTAINSSTRING('Chat + Agent Interactions (Audit Logs)'[AppHost], "SecurityCopilot")
            )
        ),
        "Active Users", [__USERS__],
        "Sessions", [__SESSIONS__],
        "Sessions Per User Per Week", [__PER_WEEK__]
    )
VAR _people = FILTER(_all, NOT [Is Group Total])
VAR _total = COUNTROWS(_people) + 0
RETURN
ADDCOLUMNS(
    UNION(
        FILTER(_all, [Is Group Total]),
        TOPN(
            1000,
            _people,
            [Sessions], DESC,
            'Chat + Agent Interactions (Audit Logs)'[Audit_UserId], ASC,
            'Chat + Agent Org Data'[Organization], ASC
        )
    ),
    "Total", _total
)
ORDER BY
    [Is Grand Total] DESC,
    [Is Group Total] DESC,
    [Sessions] DESC,
    'Chat + Agent Interactions (Audit Logs)'[Audit_UserId] ASC,
    'Chat + Agent Org Data'[Organization] ASC
