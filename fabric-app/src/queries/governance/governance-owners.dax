EVALUATE
VAR __Live =
    FILTER(
        'Agents 365',
        NOT (LOWER(TRIM(COALESCE('Agents 365'[Created in], ""))) IN {"", "not available"})
            && NOT (LOWER(TRIM(COALESCE('Agents 365'[Is Blocked], ""))) IN {"true", "yes", "1"})
    )
VAR __Status =
    ADDCOLUMNS(
        __Live,
        "@Status",
            SWITCH(
                TRUE(),
                LOWER(TRIM(COALESCE('Agents 365'[Agent creator source], ""))) = "unattributed", "No owner on record",
                'Agents 365'[Owner account] = "Disabled", "Owner disabled",
                'Agents 365'[Owner account] = "Not found", "Owner not found",
                'Agents 365'[Owner account] = "Active", "Owner active",
                "Not checked"
            )
    )
RETURN
    SELECTCOLUMNS(
        GROUPBY(__Status, [@Status], "@Agents", COUNTX(CURRENTGROUP(), 1)),
        "Status Order",
            SWITCH(
                [@Status],
                "Owner active", 1,
                "Owner disabled", 2,
                "Owner not found", 3,
                "No owner on record", 4,
                5
            ),
        "Owner Status", [@Status],
        "Agents", [@Agents]
    )
ORDER BY [Status Order]
