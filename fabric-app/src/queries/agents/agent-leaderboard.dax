EVALUATE
// Every registered agent, used or not. The model relates the audit log and
// the registry in both directions, so a date or people filter on the log
// would otherwise shrink the registry to the agents it matched. One-way keeps
// the list whole; the usage measures below still see every filter. Removing
// the audit table's filters would not do: its expanded table takes in the
// registry, so the agent type filter would go too.
VAR _catalogue =
    CALCULATETABLE(
        SUMMARIZE(
            FILTER('Agents 365', NOT ISBLANK('Agents 365'[Title ID])),
            'Agents 365'[Title ID],
            'Agents 365'[Agent name],
            'Agents 365'[Agent Type Label],
            'Agents 365'[Creator],
            'Agents 365'[Agent Features],
            'Agents 365'[Agent Lifecycle],
            'Agents 365'[Agent Usage Review],
            'Agents 365'[Agent description]
        ),
        CROSSFILTER(
            'Chat + Agent Interactions (Audit Logs)'[Agent_LinkID],
            'Agents 365'[Title ID],
            OneWay
        )
    )
VAR _registered =
    SELECTCOLUMNS(
        FILTER(
            ADDCOLUMNS(
                _catalogue,
                "@Users", [Active Agent Users],
                "@Sessions", [Observed Agent Sessions],
                "@PerUser", [Observed Agent Sessions per User],
                "@Orgs", [Agent Orgs],
                "@LastSeen", [Agent Last Observed Activity]
            ),
            // Picking agents by name filters the audit log, which the list no
            // longer follows, so then a registered agent stays only if it was used.
            NOT ISFILTERED('Chat + Agent Interactions (Audit Logs)'[AgentName])
                || NOT ISBLANK([@Sessions])
        ),
        "Agent", 'Agents 365'[Agent name],
        "Registry Id", 'Agents 365'[Title ID],
        "Agent Key", "registry:" & 'Agents 365'[Title ID],
        "In Registry", TRUE(),
        "Type", 'Agents 365'[Agent Type Label],
        "Creator", 'Agents 365'[Creator],
        "Users", [@Users],
        "Sessions", [@Sessions],
        "Sessions Per User", [@PerUser],
        "Orgs Reached", [@Orgs],
        "Last Activity", [@LastSeen],
        "Features", 'Agents 365'[Agent Features],
        "Lifecycle", 'Agents 365'[Agent Lifecycle],
        "Adoption", 'Agents 365'[Agent Usage Review],
        "Description", 'Agents 365'[Agent description]
    )
// Agents the audit log names but no registry entry matches. The report's
// registry table leaves them out, yet in some tenants they carry all of the
// agent use, so they are ranked with their usage and no registry details.
// "Draft as 1P Agent" is left out, as on the report's Leaderboard page.
VAR _unregistered =
    SELECTCOLUMNS(
        FILTER(
            SUMMARIZECOLUMNS(
                'Chat + Agent Interactions (Audit Logs)'[AgentName],
                FILTER(ALL('Agents 365'[Title ID]), ISBLANK('Agents 365'[Title ID])),
                "@Users", [Active Agent Users],
                "@Sessions", [Observed Agent Sessions],
                "@PerUser", [Observed Agent Sessions per User],
                "@Orgs", [Agent Orgs],
                "@LastSeen", [Agent Last Observed Activity]
            ),
            NOT ISBLANK([@Sessions])
                && 'Chat + Agent Interactions (Audit Logs)'[AgentName] <> "Draft as 1P Agent"
        ),
        "Agent",
            VAR _name = 'Chat + Agent Interactions (Audit Logs)'[AgentName]
            RETURN IF(LEN(TRIM(_name)) = 0, "Unnamed agent", _name),
        "Registry Id", BLANK(),
        "Agent Key", "audit:" & IF(ISBLANK('Chat + Agent Interactions (Audit Logs)'[AgentName]), "blank", "text:" & 'Chat + Agent Interactions (Audit Logs)'[AgentName]),
        "In Registry", FALSE(),
        "Type", "Not in registry",
        "Creator", BLANK(),
        "Users", [@Users],
        "Sessions", [@Sessions],
        "Sessions Per User", [@PerUser],
        "Orgs Reached", [@Orgs],
        "Last Activity", [@LastSeen],
        "Features", BLANK(),
        "Lifecycle", BLANK(),
        "Adoption", BLANK(),
        "Description", BLANK()
    )
VAR _all = UNION(_registered, _unregistered)
VAR _inUse = COUNTROWS(FILTER(_all, [Users] > 0)) + 0
VAR _registeredCount = COUNTROWS(FILTER(_all, [In Registry])) + 0
VAR _total = COUNTROWS(_all)
// Only list rows leave the model. Spotlight maxima and tie counts cover all
// agents, even if thousands tie beyond the cap; only two names are spelled out.
VAR _listed =
    TOPN(
        1000,
        _all,
        [Users], DESC,
        [Sessions], DESC,
        [Agent], ASC,
        [Registry Id], ASC,
        [Type], ASC,
        [Creator], ASC,
        [Agent Key], ASC
    )
VAR _maxSessions = MAXX(_all, [Sessions])
VAR _maxOrgs = MAXX(_all, [Orgs Reached])
VAR _sessionLeaders = FILTER(_all, _maxSessions > 0 && [Sessions] = _maxSessions)
VAR _orgLeaders = FILTER(_all, _maxOrgs > 0 && [Orgs Reached] = _maxOrgs)
VAR _sessionCount = COUNTROWS(_sessionLeaders) + 0
VAR _orgCount = COUNTROWS(_orgLeaders) + 0
VAR _sessionNames =
    CONCATENATEX(
        TOPN(2, _sessionLeaders, [Users], DESC, [Sessions], DESC, [Agent], ASC, [Agent Key], ASC),
        IF(LEN(TRIM([Agent])) = 0, "Unnamed agent", TRIM([Agent])),
        IF(_sessionCount = 2, " and ", ", "),
        [Users], DESC, [Sessions], DESC, [Agent], ASC, [Agent Key], ASC
    )
    & IF(_sessionCount > 2, " and " & FORMAT(_sessionCount - 2, "0") & IF(_sessionCount = 3, " other", " others"), "")
VAR _orgNames =
    CONCATENATEX(
        TOPN(2, _orgLeaders, [Users], DESC, [Sessions], DESC, [Agent], ASC, [Agent Key], ASC),
        IF(LEN(TRIM([Agent])) = 0, "Unnamed agent", TRIM([Agent])),
        IF(_orgCount = 2, " and ", ", "),
        [Users], DESC, [Sessions], DESC, [Agent], ASC, [Agent Key], ASC
    )
    & IF(_orgCount > 2, " and " & FORMAT(_orgCount - 2, "0") & IF(_orgCount = 3, " other", " others"), "")
RETURN
    ADDCOLUMNS(
        _listed,
        "In Use", _inUse,
        "Registered", _registeredCount,
        "Total", _total,
        "Top Sessions", _maxSessions + 0,
        "Session Leaders", _sessionNames,
        "Session Leader Count", _sessionCount,
        "Top Orgs", _maxOrgs + 0,
        "Org Leaders", _orgNames,
        "Org Leader Count", _orgCount
    )
ORDER BY [Users] DESC, [Sessions] DESC, [Agent] ASC, [Registry Id] ASC, [Type] ASC, [Creator] ASC, [Agent Key] ASC
