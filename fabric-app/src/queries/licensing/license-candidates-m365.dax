EVALUATE
VAR _base =
    ADDCOLUMNS(
        FILTER(
            SUMMARIZECOLUMNS(
                'Chat + Agent Interactions (Audit Logs)'[Audit_UserId],
                "@Tasks", [Median Unlicensed AI Tasks Per User Per Week],
                "@Days", [Median Chat + Agent Active Days Per User Per Week (Unlicensed)],
                "@Sessions", [Observed Unlicensed Sessions per User per Week],
                "@Observed", [Observed Unlicensed Sessions]
            ),
            [@Tasks] > 0 && [@Days] > 0 && [@Observed] > 0
        ),
        "@Breadth",
            CALCULATE(
                AVERAGE('M365 Activity'[WorkloadsActive]),
                'M365 Activity'[WorkloadsActive] > 0,
                TREATAS({ 'Chat + Agent Interactions (Audit Logs)'[Audit_UserId] }, 'M365 Activity'[UPN_Normalized])
            )
    )
VAR _scored =
    ADDCOLUMNS(
        _base,
        "@Score",
            VAR _volume = MIN(DIVIDE([@Tasks], 30, 0), 1)
            VAR _days = MIN(DIVIDE([@Days], 5, 0), 1)
            RETURN
                ROUND(
                    IF(
                        ISBLANK([@Breadth]),
                        60 * _volume + 40 * _days,
                        50 * _volume + 30 * _days + 20 * MIN(DIVIDE([@Breadth], 4, 0), 1)
                    ),
                    0
                )
    )
-- A dense rank is one more than the number of distinct higher scores; scores
-- are whole numbers from 0 to 100, so this stays cheap however many people rank.
VAR _scores = DISTINCT(SELECTCOLUMNS(_scored, "@Value", [@Score]))
VAR _total = COUNTROWS(_scored)
RETURN
SELECTCOLUMNS(
    TOPN(
        1000,
        _scored,
        [@Score], DESC,
        [@Sessions], DESC,
        'Chat + Agent Interactions (Audit Logs)'[Audit_UserId], ASC
    ),
    "Rank",
        VAR _score = [@Score]
        RETURN COUNTROWS(FILTER(_scores, [@Value] > _score)) + 1,
    "User", 'Chat + Agent Interactions (Audit Logs)'[Audit_UserId],
    "Organization",
        LOOKUPVALUE(
            'Chat + Agent Org Data'[Organization],
            'Chat + Agent Org Data'[PersonId], 'Chat + Agent Interactions (Audit Logs)'[Audit_UserId]
        ),
    "Priority Score", [@Score],
    "Sessions Per Week", [@Sessions],
    "Active Days Per Week", [@Days],
    "Workloads Per Day", [@Breadth],
    "Total", _total
)
ORDER BY [Rank], [Priority Score] DESC, [Sessions Per Week] DESC, [User]
