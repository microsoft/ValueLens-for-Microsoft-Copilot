EVALUATE
VAR __Month = [Last Full Month Start]
-- One row per person active in the last full month the selected dates reach:
-- their distinct active days, which set their habit as on the Adoption page,
-- and the expert-equivalent hours their activity that month adds up to.
-- Hours and habit cover the same month, so the two can be compared.
VAR __People =
    FILTER(
        CALCULATETABLE(
            ADDCOLUMNS(
                VALUES('Chat + Agent Interactions (Audit Logs)'[Audit_UserId]),
                "@Days", CALCULATE(DISTINCTCOUNT('Chat + Agent Interactions (Audit Logs)'[InteractionDate])),
                "@Hours", [Expert Equivalent Hours]
            ),
            REMOVEFILTERS('Calendar'),
            'Chat + Agent Interactions (Audit Logs)'[MonthStart] = __Month
        ),
        LEN(TRIM('Chat + Agent Interactions (Audit Logs)'[Audit_UserId])) > 0
            && [@Days] > 0
    )
-- Each habit's people and hours, so no person's row leaves the model.
VAR __Habits =
    GROUPBY(
        ADDCOLUMNS(
            __People,
            -- The same bands as the Power, Habitual, Developing and Beginner measures.
            "@Cohort",
                SWITCH(
                    TRUE(),
                    [@Days] >= 16, "Power",
                    [@Days] >= 11, "Habitual",
                    [@Days] >= 6, "Developing",
                    "Beginner"
                )
        ),
        [@Cohort],
        "@People", SUMX(CURRENTGROUP(), 1),
        "@HabitHours", SUMX(CURRENTGROUP(), IF([@Hours] > 0, [@Hours], 0))
    )
-- How much of the hours the busiest people account for.
VAR __Values = ADDCOLUMNS(FILTER(__People, [@Hours] > 0), "@Value", [@Hours])
-- The cuts lib/concentration.ts reads: every top slice's size, rounded up,
-- and both roundings of each point on the thinned curve. Each cut's sum
-- takes the busiest people, less any tied past the cut.
VAR __Total = SUMX(__Values, [@Value])
VAR __Count = COUNTROWS(__Values) + 0
VAR __Steps = MAX(1, MIN(__Count, 100))
VAR __Cuts =
    ADDCOLUMNS(
        FILTER(
            DISTINCT(
                UNION(
                    SELECTCOLUMNS({ 1, 5, 25 }, "@Count", QUOTIENT(__Count * [Value] + 99, 100)),
                    SELECTCOLUMNS(GENERATESERIES(1, __Steps), "@Count", QUOTIENT([Value] * __Count, __Steps)),
                    SELECTCOLUMNS(GENERATESERIES(1, __Steps), "@Count", QUOTIENT([Value] * __Count + __Steps - 1, __Steps))
                )
            ),
            [@Count] >= 1
        ),
        "@Cumulative",
            VAR __Top = TOPN([@Count], __Values, [@Value], DESC)
            VAR __Boundary = MINX(__Top, [@Value])
            VAR __Higher = FILTER(__Top, [@Value] > __Boundary)
            RETURN SUMX(__Higher, [@Value]) + ([@Count] - COUNTROWS(__Higher)) * __Boundary
    )
RETURN
    UNION(
        SELECTCOLUMNS(
            __Habits,
            "Month", __Month,
            "Cohort", [@Cohort],
            "People", [@People],
            -- Named apart from the measure, which the task-time overrides may redefine.
            "Hours", [@HabitHours],
            "Count", BLANK(),
            "Cumulative", BLANK(),
            "Total", BLANK()
        ),
        SELECTCOLUMNS(
            __Cuts,
            "Month", __Month,
            "Cohort", BLANK(),
            "People", __Count,
            "Hours", BLANK(),
            "Count", [@Count],
            "Cumulative", [@Cumulative],
            "Total", __Total
        )
    )
ORDER BY [Count], [Cohort]
