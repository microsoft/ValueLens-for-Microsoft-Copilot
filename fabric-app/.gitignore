# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules

# Build output
dist

# Auto-generated by fabric-app-data CLI
src/fabric.generated.ts

# Written by scripts/deploy.mjs (or an installer) for a deploy, then removed
public/fabric.config.json

# Auto-generated by `rayfin env` — regenerate with `rayfin env --framework vite`
.env.local
rayfin/.env
rayfin/.env.*

# Local scratch: DAX experiments and captured query output
tmp-dax/

# Records the Fabric item a deploy created, including a publishable key.
# Each person deploys into their own workspace, so this stays local.
rayfin/.deployments.json
# Each variant's deployment record, kept by scripts/deploy.mjs between deploys.
rayfin/.variants/

# Entities compiled by `rayfin up db apply`
rayfin/.temp/

# Playwright CLI session state from `npm run test:fabric`
.playwright-cli/

# Parked Copilot Managed App: never commit a local try's IDs or build files.
ms.config.json
ms.*.config.json
.ms/
generated/
managed-app.config.json
