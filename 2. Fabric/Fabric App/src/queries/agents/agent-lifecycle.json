{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "mark": { "type": "bar" },
  "encoding": {
    "y": {
      "field": "Lifecycle",
      "type": "nominal",
      "title": null,
      "sort": { "field": "Lifecycle Order", "op": "min", "order": "ascending" },
      "axis": { "labelLimit": 200 }
    },
    "x": {
      "field": "Agents",
      "type": "quantitative",
      "title": "Agents",
      "stack": "zero",
      "axis": { "labelExpr": "format(datum.value, ',.0f')" }
    },
    "color": {
      "field": "Type",
      "type": "nominal",
      "title": "Agent type",
      "legend": { "orient": "top", "direction": "horizontal", "columns": 3, "title": null, "labelLimit": 180 }
    },
    "order": { "field": "Agents", "type": "quantitative", "sort": "descending" },
    "tooltip": [
      { "field": "Lifecycle", "type": "nominal", "title": "Lifecycle" },
      { "field": "Type", "type": "nominal", "title": "Agent type" },
      { "field": "Agents", "type": "quantitative", "title": "Agents", "format": ",.0f" }
    ]
  }
}
