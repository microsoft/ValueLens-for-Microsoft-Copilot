EVALUATE
TOPN(
    15,
    SELECTCOLUMNS(
        FILTER(
            SUMMARIZECOLUMNS(
                'Chat + Agent Interactions (Audit Logs)'[AgentName],
                "@Sessions", [Observed Agent Sessions],
                "@Users", [Active Agent Users],
                "@ReturnRate", [Agent Return Rate],
                "@Orgs", [Agent Orgs]
            ),
            NOT ISBLANK([@Sessions])
        ),
        "Agent",
            VAR _name = 'Chat + Agent Interactions (Audit Logs)'[AgentName]
            RETURN IF(ISBLANK(_name) || TRIM(_name) = "", "Unnamed agent", _name),
        "Sessions", [@Sessions],
        "Users", [@Users],
        "Return Rate", [@ReturnRate],
        "Organizations", [@Orgs]
    ),
    [Sessions], DESC
)
ORDER BY [Sessions] DESC