{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "transform": [{ "filter": "isValid(datum['Cost'])" }],
  "mark": { "type": "bar", "cornerRadiusEnd": 2 },
  "encoding": {
    "y": {
      "field": "Product",
      "type": "nominal",
      "title": null,
      "sort": { "field": "Product Sort", "order": "ascending" },
      "axis": { "labelLimit": 200 }
    },
    "x": {
      "field": "Cost",
      "type": "quantitative",
      "title": "Cost",
      "axis": { "format": ",~f", "formatType": "number" }
    },
    "tooltip": [
      { "field": "Product", "type": "nominal", "title": "Product" },
      { "field": "Cost", "type": "quantitative", "title": "Cost", "format": ",.2f" },
      { "field": "Credits", "type": "quantitative", "title": "Credits", "format": ",.0f" },
      { "field": "Cost Basis", "type": "nominal", "title": "Cost basis" }
    ]
  }
}
