{
  "$comment": "Power Automate / Logic Apps flow definition. Lands Microsoft 365 Copilot USER PRODUCT FEEDBACK CSV exports (from the Microsoft 365 Admin Center > Health > Product Feedback > Export) straight into the Fabric Lakehouse Files/product_feedback folder via the OneLake DFS (ADLS Gen2) API. MAC product feedback has NO API (export-only), so this clones the credit-consumption landing pattern. Writes as the person signed in to an HTTP with Microsoft Entra ID (preauthorized) connection (Base Resource URL https://onelake.dfs.fabric.microsoft.com, Resource URI https://storage.azure.com), so there is no client secret. Import via Power Automate > My flows > Import, then sign in to the connections and set the parameters. Pair with a feedback ingester notebook that reads Files/product_feedback and writes the `user_feedback` Delta table. See README.md.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": { "defaultValue": {}, "type": "Object" },
      "OneLakeWorkspace": {
        "defaultValue": "<your-workspace>",
        "type": "String",
        "metadata": { "description": "Fabric workspace name (or GUID) that holds the lakehouse." }
      },
      "OneLakeLakehouse": {
        "defaultValue": "<your-lakehouse>",
        "type": "String",
        "metadata": { "description": "Lakehouse name WITHOUT the .Lakehouse suffix." }
      },
      "TargetFolder": {
        "defaultValue": "Files/product_feedback",
        "type": "String",
        "metadata": { "description": "Destination folder inside the lakehouse. Must match SOURCE_DIR in the feedback ingester notebook." }
      },
      "SubjectFilter": {
        "defaultValue": "Copilot Product Feedback",
        "type": "String",
        "metadata": { "description": "Only emails whose subject contains this text are processed. Set this to whatever subject the feedback export is mailed under." }
      },
      "FilePrefix": {
        "defaultValue": "feedback",
        "type": "String",
        "metadata": { "description": "Only .csv attachments whose file name STARTS WITH this (case-insensitive) are landed. Default 'feedback' matches the MAC export 'feedback.csv' / 'feedback*.csv'. Set blank to accept any .csv on a subject-matched email." }
      },
      "$authentication": { "defaultValue": {}, "type": "SecureObject" }
    },
    "triggers": {
      "When_a_new_email_arrives_V3": {
        "type": "OpenApiConnectionNotification",
        "inputs": {
          "host": {
            "connectionName": "shared_office365",
            "operationId": "OnNewEmailV3",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
          },
          "parameters": {
            "subjectFilter": "@parameters('SubjectFilter')",
            "hasAttachments": "Yes",
            "includeAttachments": true,
            "importance": "Any"
          }
        },
        "splitOn": "@triggerOutputs()?['body/value']"
      }
    },
    "actions": {
      "For_each_attachment": {
        "type": "Foreach",
        "foreach": "@triggerOutputs()?['body/attachments']",
        "actions": {
          "Only_feedback_CSVs": {
            "type": "If",
            "expression": {
              "and": [
                { "endsWith": [ "@toLower(items('For_each_attachment')?['name'])", ".csv" ] },
                { "startsWith": [ "@toLower(items('For_each_attachment')?['name'])", "@toLower(parameters('FilePrefix'))" ] }
              ]
            },
            "actions": {
              "Create_file_PUT": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_webcontents_storage",
                    "operationId": "InvokeHttp",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
                  },
                  "parameters": {
                    "request/method": "PUT",
                    "request/url": "https://onelake.dfs.fabric.microsoft.com/@{encodeURIComponent(parameters('OneLakeWorkspace'))}/@{encodeURIComponent(concat(parameters('OneLakeLakehouse'), '.Lakehouse'))}/@{parameters('TargetFolder')}/@{items('For_each_attachment')?['name']}?resource=file",
                    "request/headers": { "x-ms-version": "2023-11-03" }
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Append_and_flush_PATCH": {
                "type": "OpenApiConnection",
                "runAfter": { "Create_file_PUT": [ "Succeeded" ] },
                "inputs": {
                  "host": {
                    "connectionName": "shared_webcontents_storage",
                    "operationId": "InvokeHttp",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
                  },
                  "parameters": {
                    "request/method": "PATCH",
                    "request/url": "https://onelake.dfs.fabric.microsoft.com/@{encodeURIComponent(parameters('OneLakeWorkspace'))}/@{encodeURIComponent(concat(parameters('OneLakeLakehouse'), '.Lakehouse'))}/@{parameters('TargetFolder')}/@{items('For_each_attachment')?['name']}?action=append&position=0&flush=true",
                    "request/headers": { "x-ms-version": "2023-11-03", "Content-Type": "text/csv" },
                    "request/body": "@base64ToString(items('For_each_attachment')?['contentBytes'])"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            },
            "else": { "actions": {} }
          }
        }
      }
    }
  }
}
