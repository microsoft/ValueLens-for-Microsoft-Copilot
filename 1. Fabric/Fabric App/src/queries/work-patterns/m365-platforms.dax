EVALUATE
VAR _people =
    CALCULATE(DISTINCTCOUNT('M365 Activity'[UPN_Normalized]), 'M365 Activity'[WorkloadsActive] > 0)
VAR _weeks = DIVIDE(DISTINCTCOUNT('M365 Activity'[ActivityDate]), 7)
VAR _platforms =
    DATATABLE(
        "Platform", STRING,
        "Order", INTEGER,
        {
            { "Windows", 1 },
            { "Mac", 2 },
            { "Web", 3 },
            { "Mobile", 4 }
        }
    )
VAR _measured =
    ADDCOLUMNS(
        _platforms,
        "@People",
            SWITCH(
                [Order],
                1, CALCULATE(DISTINCTCOUNT('M365 Activity'[UPN_Normalized]), 'M365 Activity'[PlatformWindows] = 1),
                2, CALCULATE(DISTINCTCOUNT('M365 Activity'[UPN_Normalized]), 'M365 Activity'[PlatformMac] = 1),
                3, CALCULATE(DISTINCTCOUNT('M365 Activity'[UPN_Normalized]), 'M365 Activity'[PlatformWeb] = 1),
                4, CALCULATE(DISTINCTCOUNT('M365 Activity'[UPN_Normalized]), 'M365 Activity'[PlatformMobile] = 1)
            ),
        "@PersonDays",
            SWITCH(
                [Order],
                1, CALCULATE(COUNTROWS('M365 Activity'), 'M365 Activity'[PlatformWindows] = 1),
                2, CALCULATE(COUNTROWS('M365 Activity'), 'M365 Activity'[PlatformMac] = 1),
                3, CALCULATE(COUNTROWS('M365 Activity'), 'M365 Activity'[PlatformWeb] = 1),
                4, CALCULATE(COUNTROWS('M365 Activity'), 'M365 Activity'[PlatformMobile] = 1)
            )
    )
RETURN
SELECTCOLUMNS(
    FILTER(_measured, [@People] > 0),
    "Platform", [Platform],
    "People", [@People],
    "Reach", DIVIDE([@People], _people),
    "Days Per Week", DIVIDE([@PersonDays], [@People] * _weeks)
)
ORDER BY [Reach] DESC, [Platform]
