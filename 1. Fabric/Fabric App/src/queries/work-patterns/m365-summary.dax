EVALUATE
VAR _people =
    CALCULATE(DISTINCTCOUNT('M365 Activity'[UPN_Normalized]), 'M365 Activity'[WorkloadsActive] > 0)
VAR _personDays = CALCULATE(COUNTROWS('M365 Activity'), 'M365 Activity'[WorkloadsActive] > 0)
VAR _days = DISTINCTCOUNT('M365 Activity'[ActivityDate])
VAR _personWeeks = _people * DIVIDE(_days, 7)
RETURN
ROW(
    "People Active", _people,
    "Days Loaded", _days,
    "First Date", FORMAT(MIN('M365 Activity'[ActivityDate]), "yyyy-MM-dd"),
    "Last Date", FORMAT(MAX('M365 Activity'[ActivityDate]), "yyyy-MM-dd"),
    "Active Days Per Week", DIVIDE(_personDays, _personWeeks),
    "Workloads Per Active Day",
        CALCULATE(AVERAGE('M365 Activity'[WorkloadsActive]), 'M365 Activity'[WorkloadsActive] > 0),
    "Meetings Per Week", DIVIDE(SUM('M365 Activity'[TeamsMeetings]), _personWeeks),
    "Call Hours Per Week", DIVIDE(SUM('M365 Activity'[TeamsAudioSeconds]) / 3600, _personWeeks),
    "Emails Sent Per Week", DIVIDE(SUM('M365 Activity'[EmailSent]), _personWeeks),
    "Chats Per Week",
        DIVIDE(
            SUM('M365 Activity'[TeamsChatMessages]) + SUM('M365 Activity'[TeamsPrivateChatMessages]),
            _personWeeks
        )
)
