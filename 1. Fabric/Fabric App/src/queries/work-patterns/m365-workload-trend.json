{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "transform": [{ "calculate": "toDate(datum['Week Start'])", "as": "Week" }],
  "encoding": {
    "x": {
      "field": "Week",
      "type": "temporal",
      "title": null,
      "axis": {
        "tickCount": { "interval": "week", "step": 1 },
        "labelExpr": "timeFormat(datum.value, '%-d %b')",
        "labelAngle": 0,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "Share",
      "type": "quantitative",
      "title": "Share of active people",
      "scale": { "domain": [0, 1] },
      "axis": { "labelExpr": "format(datum.value, '.0%')" }
    },
    "color": {
      "field": "Workload",
      "type": "nominal",
      "title": null,
      "sort": ["Teams", "Email", "SharePoint", "OneDrive", "Office apps", "Viva Engage"],
      "legend": { "orient": "top", "direction": "horizontal" }
    }
  },
  "layer": [
    { "mark": { "type": "line", "interpolate": "monotone", "strokeWidth": 2 } },
    {
      "mark": { "type": "point", "filled": true, "size": 40 },
      "encoding": {
        "tooltip": [
          { "field": "Week", "type": "temporal", "title": "Week starting", "format": "%d %b %Y" },
          { "field": "Workload", "type": "nominal", "title": "Workload" },
          { "field": "Share", "type": "quantitative", "title": "Share of active people", "format": ".1%" },
          { "field": "People", "type": "quantitative", "title": "People", "format": ",.0f" }
        ]
      }
    }
  ]
}
