{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "mark": { "type": "bar", "cornerRadiusEnd": 2 },
  "encoding": {
    "y": {
      "field": "Platform",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": { "labelLimit": 200 }
    },
    "x": {
      "field": "Reach",
      "type": "quantitative",
      "title": "Share of active people",
      "scale": { "domain": [0, 1] },
      "axis": { "labelExpr": "format(datum.value, '.0%')" }
    },
    "tooltip": [
      { "field": "Platform", "type": "nominal", "title": "Platform" },
      { "field": "Reach", "type": "quantitative", "title": "Share of active people", "format": ".1%" },
      { "field": "People", "type": "quantitative", "title": "People", "format": ",.0f" },
      { "field": "Days Per Week", "type": "quantitative", "title": "Days per week, when used", "format": ",.1f" }
    ]
  }
}
