        "description": "Azure region for all resources."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "vlens",
      "minLength": 2,
      "maxLength": 10,
      "metadata": {
        "description": "Short lowercase prefix used in resource names."
      }
    },
    "installId": {
      "type": "string",
      "metadata": {
        "description": "Installer record id (GUID). Stamped on every resource as valuelens-install-id."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Extra tags required by the customer's policy."
      }
    },
    "imageRegistry": {
      "type": "string",
      "defaultValue": "ghcr.io/microsoft",
      "metadata": {
        "description": "Container image registry and tag for the jobs and web images."
      }
    },
    "imageTag": {
      "type": "string"
    },
    "runSchedule": {
      "type": "string",
      "defaultValue": "0 3 * * *",
      "metadata": {
        "description": "Cron schedule (UTC) for the daily collect/process/publish run."
      }
    },
    "runSteps": {
      "type": "string",
      "defaultValue": "collect,process,publish,refresh",
      "metadata": {
        "description": "Steps the scheduled run executes, mirroring the Enable* switches of the Fabric pipeline."
      }
    },
    "sqlAdminLogin": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Entra principal that administers SQL. Defaults to the managed identity so the migrate job can create database users."
      }
    },
    "sqlAdminObjectId": {
      "type": "string",
      "defaultValue": ""
    },
    "sqlAdminPrincipalType": {
      "type": "string",
      "defaultValue": "Application",
      "allowedValues": [
        "User",
        "Group",
        "Application"
      ]
    },
    "sqlMinCapacity": {
      "type": "string",
      "defaultValue": "0.5",
      "metadata": {
        "description": "Preserve-on-update: the installer reads the live values back and passes them in."
      }
    },
    "sqlMaxCapacity": {
      "type": "int",
      "defaultValue": 2
    },
    "sqlAutoPauseDelayMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "sqlUseFreeLimit": {
      "type": "bool",
      "defaultValue": false
    },
    "publicNetworkAccess": {
      "type": "string",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ]
    },
    "deployWeb": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the Analytics Hub web app (SPA + /api)."
      }
    },
    "webMinReplicas": {
      "type": "int",
      "defaultValue": 0
    },
    "webClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "App registration (client) id of the Analytics Hub web app; empty until the installer creates it."
      }
    },
    "webAppIdUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Identifier URI the web API exposes (api://<fqdn>/<clientId>); empty until the installer sets it."
      }
    },
    "modules": {
      "type": "string",
      "defaultValue": "core",
      "metadata": {
        "description": "Collection modules the run job executes (catalog ids), e.g. core,org,m365."
      }
    },
    "auditHistoryDays": {
      "type": "int",
      "defaultValue": 30,
      "allowedValues": [
        30,
        90,
        180
      ],
      "metadata": {
        "description": "Audit history to backfill on the first run, in days."
      }
    },
    "powerBiWorkspaceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Power BI workspace and semantic models (JSON: {\"alias\":{\"workspaceId\":\"..\",\"itemId\":\"..\"}}). Set by the installer after the models exist."
      }
    },
    "semanticModels": {
      "type": "string",
      "defaultValue": "{}"
    },
    "sqlReaderName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Display name of the SQL reader app registration that the migrate job grants db_datareader (the Power BI refresh credential)."
      }
    },
    "sqlReaderClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Client (app) ID of the SQL reader app registration. The migrate job creates its database user by SID, so the SQL server needs no Graph access."
      }
    }
  },
  "variables": {
    "allTags": "[union(parameters('tags'), createObject('valuelens-install-id', parameters('installId'), 'valuelens-component', 'analytics-hub'))]",
    "suffix": "[substring(uniqueString(resourceGroup().id, parameters('installId')), 0, 6)]",
    "names": {
      "identity": "[format('id-{0}-collector-{1}', parameters('namePrefix'), variables('suffix'))]",
      "logs": "[format('log-{0}-{1}', parameters('namePrefix'), variables('suffix'))]",
      "storage": "[toLower(take(format('st{0}{1}', replace(parameters('namePrefix'), '-', ''), variables('suffix')), 24))]",
      "sqlServer": "[format('sql-{0}-{1}', parameters('namePrefix'), variables('suffix'))]",
      "sqlDatabase": "valuelens",
      "environment": "[format('cae-{0}-{1}', parameters('namePrefix'), variables('suffix'))]",
      "runJob": "[format('job-{0}-run', parameters('namePrefix'))]",
      "migrateJob": "[format('job-{0}-migrate', parameters('namePrefix'))]",
      "web": "[format('ca-{0}-web', parameters('namePrefix'))]"
    }
