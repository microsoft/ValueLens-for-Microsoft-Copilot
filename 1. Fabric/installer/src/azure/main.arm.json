            },
            "environmentName": {
              "type": "string"
            },
            "runJobName": {
              "type": "string"
            },
            "migrateJobName": {
              "type": "string"
            },
            "webName": {
              "type": "string"
            },
            "deployWeb": {
              "type": "bool"
            },
            "logAnalyticsName": {
              "type": "string"
            },
            "identityId": {
              "type": "string"
            },
            "identityClientId": {
              "type": "string"
            },
            "jobsImage": {
              "type": "string"
            },
            "webImage": {
              "type": "string"
            },
            "runSchedule": {
              "type": "string"
            },
            "runSteps": {
              "type": "string"
            },
            "storageAccountName": {
              "type": "string"
            },
            "sqlServerFqdn": {
              "type": "string"
            },
            "sqlDatabaseName": {
              "type": "string"
            },
            "webMinReplicas": {
              "type": "int",
              "defaultValue": 0
            },
            "webClientId": {
              "type": "string",
              "defaultValue": ""
            },
            "webAppIdUri": {
              "type": "string",
              "defaultValue": ""
            },
            "version": {
              "type": "string"
            },
            "modules": {
              "type": "string"
            },
            "auditHistoryDays": {
              "type": "int"
            },
            "powerBiWorkspaceId": {
              "type": "string"
            },
            "semanticModels": {
              "type": "string"
            },
            "sqlReaderName": {
              "type": "string"
            },
            "sqlReaderClientId": {
              "type": "string",
              "defaultValue": ""
            }
          },
          "variables": {
            "commonEnv": [
              {
                "name": "AZURE_CLIENT_ID",
                "value": "[parameters('identityClientId')]"
              },
              {
                "name": "VALUELENS_STORAGE_ACCOUNT",
                "value": "[parameters('storageAccountName')]"
              },
              {
                "name": "VALUELENS_SQL_SERVER",
                "value": "[parameters('sqlServerFqdn')]"
              },
              {
                "name": "VALUELENS_SQL_DATABASE",
                "value": "[parameters('sqlDatabaseName')]"
              },
              {
                "name": "VALUELENS_TENANT_ID",
                "value": "[subscription().tenantId]"
              },
              {
                "name": "VALUELENS_VERSION",
                "value": "[parameters('version')]"
              },
              {
                "name": "VALUELENS_POWERBI_WORKSPACE_ID",
                "value": "[parameters('powerBiWorkspaceId')]"
              },
              {
                "name": "VALUELENS_SEMANTIC_MODELS",
                "value": "[parameters('semanticModels')]"
              }
            ],
            "jobEnv": "[concat(variables('commonEnv'), createArray(createObject('name', 'VALUELENS_MODULES', 'value', parameters('modules')), createObject('name', 'VALUELENS_AUDIT_HISTORY_DAYS', 'value', string(parameters('auditHistoryDays'))), createObject('name', 'VALUELENS_SQL_READER_NAME', 'value', parameters('sqlReaderName')), createObject('name', 'VALUELENS_SQL_READER_CLIENT_ID', 'value', parameters('sqlReaderClientId'))))]",
            "identity": {
              "type": "UserAssigned",
              "userAssignedIdentities": {
                "[format('{0}', parameters('identityId'))]": {}
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2024-03-01",
              "name": "[parameters('environmentName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2023-09-01').customerId]",
                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2023-09-01').primarySharedKey]"
                  }
                },
                "workloadProfiles": [
                  {
                    "name": "Consumption",
                    "workloadProfileType": "Consumption"
                  }
                ]
              }
            },
            {
              "type": "Microsoft.App/jobs",
              "apiVersion": "2024-03-01",
              "name": "[parameters('runJobName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": "[variables('identity')]",
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "workloadProfileName": "Consumption",
                "configuration": {
                  "triggerType": "Schedule",
                  "replicaTimeout": 14400,
                  "replicaRetryLimit": 1,
                  "scheduleTriggerConfig": {
                    "cronExpression": "[parameters('runSchedule')]",
                    "parallelism": 1,
                    "replicaCompletionCount": 1
                  }
                },
                "template": {
                  "containers": [
                    {
                      "name": "run",
                      "image": "[parameters('jobsImage')]",
                      "args": [
                        "run",
                        "--steps",
                        "[parameters('runSteps')]"
                      ],
                      "env": "[variables('jobEnv')]",
                      "resources": {
                        "cpu": "[json('4')]",
                        "memory": "8Gi"
                      }
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "type": "Microsoft.App/jobs",
              "apiVersion": "2024-03-01",
              "name": "[parameters('migrateJobName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": "[variables('identity')]",
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "workloadProfileName": "Consumption",
                "configuration": {
                  "triggerType": "Manual",
                  "replicaTimeout": 1800,
                  "replicaRetryLimit": 0,
                  "manualTriggerConfig": {
                    "parallelism": 1,
                    "replicaCompletionCount": 1
                  }
                },
                "template": {
                  "containers": [
                    {
                      "name": "migrate",
                      "image": "[parameters('jobsImage')]",
                      "args": [
                        "migrate"
                      ],
                      "env": "[variables('jobEnv')]",
                      "resources": {
                        "cpu": "[json('0.5')]",
                        "memory": "1Gi"
                      }
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "condition": "[parameters('deployWeb')]",
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[parameters('webName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": "[variables('identity')]",
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "workloadProfileName": "Consumption",
                "configuration": {
                  "ingress": {
                    "external": true,
                    "targetPort": 8080,
                    "transport": "auto",
                    "allowInsecure": false
                  }
                },
                "template": {
                  "containers": [
                    {
                      "name": "web",
                      "image": "[parameters('webImage')]",
                      "env": "[concat(variables('commonEnv'), createArray(createObject('name', 'VALUELENS_WEB_CLIENT_ID', 'value', parameters('webClientId')), createObject('name', 'VALUELENS_APP_ID_URI', 'value', parameters('webAppIdUri'))))]",
                      "resources": {
                        "cpu": "[json('0.5')]",
                        "memory": "1Gi"
                      },
                      "probes": [
                        {
                          "type": "Liveness",
                          "httpGet": {
                            "path": "/api/health",
                            "port": 8080
                          }
                        }
                      ]
                    }
                  ],
                  "scale": {
                    "minReplicas": "[parameters('webMinReplicas')]",
                    "maxReplicas": 3
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            }
          ],
          "outputs": {
            "environmentId": {
              "type": "string",
              "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
            },
            "webUrl": {
              "type": "string",
              "value": "[if(parameters('deployWeb'), format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('webName')), '2024-03-01').configuration.ingress.fqdn), '')]"
            },
            "webFqdn": {
              "type": "string",
              "value": "[if(parameters('deployWeb'), reference(resourceId('Microsoft.App/containerApps', parameters('webName')), '2024-03-01').configuration.ingress.fqdn, '')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'vl-identity')]",
        "[resourceId('Microsoft.Resources/deployments', 'vl-monitoring')]",
        "[resourceId('Microsoft.Resources/deployments', 'vl-sql')]",
        "[resourceId('Microsoft.Resources/deployments', 'vl-storage')]"
      ]
    }
  ],
  "outputs": {
    "identityId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-identity'), '2025-04-01').outputs.id.value]"
    },
    "identityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-identity'), '2025-04-01').outputs.principalId.value]"
    },
    "identityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-identity'), '2025-04-01').outputs.clientId.value]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-storage'), '2025-04-01').outputs.name.value]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-sql'), '2025-04-01').outputs.serverFqdn.value]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-sql'), '2025-04-01').outputs.databaseName.value]"
    },
    "runJobName": {
      "type": "string",
      "value": "[variables('names').runJob]"
    },
    "migrateJobName": {
      "type": "string",
      "value": "[variables('names').migrateJob]"
    },
    "webUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-containerapps'), '2025-04-01').outputs.webUrl.value]"
    },
    "webFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vl-containerapps'), '2025-04-01').outputs.webFqdn.value]"
    },
    "environmentName": {
      "type": "string",
      "value": "[variables('names').environment]"
    },
    "webName": {
      "type": "string",
      "value": "[if(parameters('deployWeb'), variables('names').web, '')]"
    }
  }
}